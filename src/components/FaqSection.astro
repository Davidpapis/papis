---
import { PILLAR_PALETTES, type PillarId } from '../lib/theme';

interface FaqEntry {
  question: string;
  answer: string;
}

interface Props {
  title?: string;
  kicker?: string;
  accent?: PillarId;
  faqs: FaqEntry[];
}

const {
  title = 'Preguntas frecuentes',
  kicker = 'Respuestas claras · SEO & GEO',
  accent = 'web',
  faqs,
} = Astro.props;

const palette = PILLAR_PALETTES[accent];
---

{
  faqs.length > 0 && (
    <section
      aria-labelledby="heading-faq"
      class="relative py-20 sm:py-24 border-t border-white/[0.06]"
    >
      <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-medium" style={`color: ${palette.accent};`}>
          {kicker}
        </p>
        <h2
          id="heading-faq"
          class="mt-2 font-display text-2xl sm:text-3xl lg:text-4xl font-bold tracking-[-0.025em] text-white leading-[1.12]"
          style="text-wrap: balance;"
        >
          {title}
        </h2>

        <div class="mt-8 divide-y divide-white/[0.08] rounded-2xl border border-white/[0.08] bg-[#0D0F14]/90 px-5 sm:px-7">
          {faqs.map((item, idx) => (
            <details class="faq-item py-5 group" open={idx === 0}>
              <summary class="flex items-center justify-between gap-4 text-left font-display text-base sm:text-lg font-semibold text-white min-h-[44px]">
                <span>{item.question}</span>
                <svg
                  class="faq-chevron w-5 h-5 shrink-0 text-slate-400 group-hover:text-white"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <polyline points="6 9 12 15 18 9" />
                </svg>
              </summary>
              <p class="mt-3 pr-8 text-sm sm:text-[15px] leading-relaxed text-slate-300">
                {item.answer}
              </p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}

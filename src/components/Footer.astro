---
import Logo from './Logo.astro';
import siteSettings from '../content/singletons/site-settings.json';
import { NAV_LINKS, type PillarId } from '../lib/theme';

interface Props {
  activeTheme?: PillarId;
}

const { activeTheme = 'web' } = Astro.props;
const year = new Date().getFullYear();
const phoneHref = `tel:${siteSettings.phoneDisplay.replace(/\s+/g, '')}`;
---

<footer class="border-t border-white/[0.08] bg-[#050507] py-12">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div>
        <a href="/" aria-label="Ir al inicio en papis.app">
          <Logo theme={activeTheme} size="sm" />
        </a>
        <p class="mt-3 max-w-md text-xs sm:text-sm leading-relaxed text-slate-400">
          Desarrollo web con SEO y GEO, software a medida para empresas y servicio técnico
          informático a domicilio en {siteSettings.city}.
        </p>
      </div>

      <nav aria-label="Enlaces del pie de página" class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-slate-400">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} class="hover:text-white transition-colors py-1">
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-white/[0.06] pt-6 text-xs text-slate-400 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5">
        <p>© {year} {siteSettings.brandName} · Marbella, Málaga. Todos los derechos reservados.</p>
        <span aria-hidden="true" class="hidden sm:inline">·</span>
        <div class="flex items-center gap-3">
          <a href="/aviso-legal" class="hover:text-white transition-colors">Aviso Legal</a>
          <a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
          <a href="/cookies" class="hover:text-white transition-colors">Cookies</a>
        </div>
      </div>

      <div class="flex items-center gap-4">
        <a href={phoneHref} class="hover:text-white transition-colors">
          {siteSettings.phoneDisplay}
        </a>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${siteSettings.email}`} class="hover:text-white transition-colors">
          {siteSettings.email}
        </a>
      </div>
    </div>
  </div>
</footer>

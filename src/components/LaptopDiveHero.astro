---
/**
 * Hero "Laptop Dive" adaptado 100% a papis.app (Marbella).
 * - Funciona de serie con las imágenes optimizadas actuales + portátil realista.
 * - Detecta automáticamente los archivos definitivos si se añaden en /public/hero-dive/:
 *   plate.webp, cut.png, case-plate.webp, trans.mp4 y case-1..3.mp4.
 */
interface DiveCase {
  id: string;
  ticketTitle: string;
  rows: [string, string, string];
  descKey: string;
  descText: string;
  image: string;
  video: string;
  href: string;
  ctaLabel: string;
  accent: string;
}

const CASES: DiveCase[] = [
  {
    id: 'web',
    ticketTitle: 'WEB & SEO/GEO',
    rows: ['ASTRO + KEYSTATIC', 'SEO LOCAL + IA', '10–15 DÍAS'],
    descKey: '// web ultrarrápida',
    descText:
      '— páginas a medida en HTML estático (< 0,8s), analítica real sin cookies y posicionamiento en Google, ChatGPT y Gemini.',
    image: '/assets/optimized/portfolio-luxury-web.webp',
    video: '/hero-dive/case-1.mp4',
    href: '/paginas-web',
    ctaLabel: 'Ver Diseño Web',
    accent: '#3B82F6',
  },
  {
    id: 'software',
    ticketTitle: 'SOFTWARE ERP',
    rows: ['100% A MEDIDA', 'SIN CUOTAS / USUARIO', 'DESDE 6.000 €'],
    descKey: '// software empresas',
    descText:
      '— ERP, CRM y plataformas privadas en la nube para inmobiliarias, academias o cualquier sector, con 1 mes de beta y mejoras en 24h.',
    image: '/assets/optimized/portfolio-erp-inmobiliaria.webp',
    video: '/hero-dive/case-2.mp4',
    href: '/software-empresas',
    ctaLabel: 'Ver Software Empresas',
    accent: '#10B981',
  },
  {
    id: 'tecnico',
    ticketTitle: 'TÉCNICO EN CASA',
    rows: ['MARBELLA 45 €/H', 'APPLE & WINDOWS', 'REMOTO MUNDIAL'],
    descKey: '// soporte y clases',
    descText:
      '— vamos a tu domicilio en menos de 24h en Marbella, San Pedro y Estepona, o te ayudamos al instante por RustDesk desde cualquier país.',
    image: '/assets/optimized/servicio-tecnico-marbella.webp',
    video: '/hero-dive/case-3.mp4',
    href: '/servicio-tecnico',
    ctaLabel: 'Ver Servicio Técnico',
    accent: '#F97316',
  },
];
---

<section
  id="inicio"
  data-laptop-dive
  data-cases={JSON.stringify(CASES)}
  aria-label="Presentación interactiva de papis.app"
  class="hd-stage relative h-[100dvh] min-h-[620px] w-full overflow-hidden select-none"
>
  <!-- H1 semántico para SEO, GEO y lectores de pantalla -->
  <h1 class="sr-only">
    papis.app — Diseño web ultrarrápido con SEO y GEO, software a medida y servicio técnico en Marbella
  </h1>

  <!-- Fondo de transición en modo casos -->
  <div aria-hidden="true" class="hd-stage-case-bg"></div>

  <!-- Escena principal por capas -->
  <div class="hd-scene" data-hd-scene>
    <!-- Capa 1: Fondo fotográfico de estudio (usa /hero-dive/plate.webp si existe, o fallback hero-web.webp) -->
    <img
      data-hd-plate
      src="/assets/optimized/hero-web.webp"
      alt="Estudio tecnológico papis.app en Marbella"
      width="1920"
      height="1071"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hd-plate"
    />
    <div aria-hidden="true" class="hd-plate-vignette"></div>

    <!-- Capa 2: Wordmark gigante PAPIS.APP (detrás del recorte cut.png cuando se añada) -->
    <svg
      data-hd-wordmark
      class="hd-wordmark hd-pre"
      viewBox="0 0 1440 260"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="papisWordmarkGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
          <stop offset="52%" stop-color="#f1f5f3" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#d7e6de" stop-opacity="0.22" />
        </linearGradient>
      </defs>
      <text
        x="18"
        y="214"
        textLength="1404"
        lengthAdjust="spacingAndGlyphs"
        fill="url(#papisWordmarkGrad)"
      >
        PAPIS.APP
      </text>
    </svg>

    <!-- Capa 3: Recorte PNG transparente (solo visible si el usuario sube /hero-dive/cut.png) -->
    <img
      data-hd-cut
      alt=""
      aria-hidden="true"
      class="hd-cut hidden"
    />

    <!-- Capa 4: Firma manuscrita Caveat Brush -->
    <p data-hd-script class="hd-script hd-pre" aria-hidden="true">
      web · software · ia
    </p>

    <!-- Capa 5: Lanyard ID Badge colgante con física de péndulo -->
    <div data-hd-badge class="hd-badge hd-pre" aria-hidden="true">
      <!-- Cinta superior y mosquetón metálico SVG -->
      <svg class="hd-lanyard-strap" viewBox="0 0 260 220" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M114 0H146L141 148H119L114 0Z" fill="#E8ECEA" />
        <path d="M127 0H133V148H127V0Z" fill="#CBD5D0" opacity="0.55" />
        <rect x="115" y="144" width="30" height="16" rx="4" fill="#94A3B8" />
        <path
          d="M122 160H138L135 186C135 190 132.5 193 130 193C127.5 193 125 190 125 186L122 160Z"
          fill="#CBD5E1"
          stroke="#475569"
          stroke-width="2"
        />
        <rect x="108" y="190" width="44" height="14" rx="4" fill="#E2E8F0" stroke="#64748B" stroke-width="1.5" />
      </svg>

      <!-- Funda transparente + tarjeta blanca real de David Papis -->
      <div class="hd-badge-sleeve" data-hd-badge-hit>
        <div class="hd-badge-card">
          <div class="flex items-start justify-between">
            <h4>TECH<br />STUDIO</h4>
            <span class="hd-badge-yr">2026</span>
          </div>
          <p class="hd-badge-role">FOUNDER // MARBELLA</p>

          <div class="hd-badge-photo">
            <img
              src="/hero-dive/papis-portrait.jpg"
              alt="David Papis"
              width="92"
              height="112"
              loading="eager"
              decoding="async"
            />
          </div>

          <div class="hd-badge-rows">
            <div class="hd-badge-row"><span>NAME</span><b>DAVID PAPIS</b></div>
            <div class="hd-badge-row"><span>FOCUS</span><b>WEB · ERP · IA</b></div>
            <div class="hd-badge-row"><span>TEL</span><b>+34 652 918 061</b></div>
            <div class="hd-badge-row"><span>WEB</span><b>PAPIS.APP</b></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Capa 6: Vídeo de transición Kling/Veo (se activa automáticamente si existe /hero-dive/trans.mp4) -->
    <video
      data-hd-trans
      muted
      playsinline
      preload="auto"
      class="hd-trans"
      aria-hidden="true"
    ></video>

    <!-- Capa 7: Escena de portátil centrado (case-plate.webp si existe, o marco de portátil realista) -->
    <div data-hd-case-wrap class="hd-case-wrap">
      <img data-hd-caseplate alt="" aria-hidden="true" class="hd-caseplate hidden" />

      <!-- Marco de portátil elegante por defecto (se oculta automáticamente si existe case-plate.webp) -->
      <div data-hd-laptop-shell class="hd-laptop-shell">
        <div class="hd-laptop-lid">
          <div class="hd-laptop-camera" aria-hidden="true"></div>
          <div data-hd-screen class="hd-screen">
            {
              CASES.map((item, idx) => (
                <div
                  data-hd-media={idx}
                  class="hd-screen-slide"
                  style={`opacity: ${idx === 0 ? 1 : 0};`}
                >
                  <img
                    src={item.image}
                    alt={item.ticketTitle}
                    loading={idx === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                  <video
                    data-hd-case-video={idx}
                    muted
                    loop
                    playsinline
                    preload="none"
                    class="hd-case-video hidden"
                  />
                </div>
              ))
            }
            <div aria-hidden="true" class="hd-screen-sheen"></div>
            <div data-hd-flash aria-hidden="true" class="hd-screen-flash"></div>
            <button
              type="button"
              data-hd-screen-hit
              class="hd-screen-hit"
              aria-label="Pasar al siguiente caso en la pantalla"
            ></button>
          </div>
        </div>
        <div class="hd-laptop-base" aria-hidden="true">
          <div class="hd-laptop-notch"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Capa UI fijada al viewport (Etiquetas Nav, Logo centro, Ticket, Descripción, Prev/Next, Hint) -->
  <div class="hd-ui">
    <!-- Barra superior estilo sticker tags con los 3 servicios separados -->
    <nav aria-label="Navegación principal del estudio" class="hd-nav">
      <div class="hd-nav-left">
        <button type="button" data-hd-studio class="hd-tag hd-pre">mi estudio</button>
        <a href="/paginas-web" class="hd-tag hd-tag-web hd-pre">web</a>
        <a href="/software-empresas" class="hd-tag hd-tag-software hd-pre">software</a>
        <a href="/servicio-tecnico" class="hd-tag hd-tag-tecnico hd-pre">técnico</a>
      </div>

      <button
        type="button"
        data-hd-center-logo
        class="hd-center-logo"
        aria-label="Volver a portada del estudio papis.app"
      >
        PAPIS.APP
      </button>

      <div class="hd-nav-right">
        <button type="button" data-hd-dive class="hd-tag hd-pre">proyectos</button>
        <a href="/contacto" class="hd-tag hd-tag-accent hd-pre">presupuesto</a>
      </div>
    </nav>

    <!-- Ticket perforado (top-right en modo casos) -->
    <article data-hd-ticket class="hd-ticket" aria-live="polite">
      <span class="hd-hole hd-hole-tl" aria-hidden="true"></span>
      <span class="hd-hole hd-hole-tr" aria-hidden="true"></span>
      <span class="hd-hole hd-hole-bl" aria-hidden="true"></span>
      <span class="hd-hole hd-hole-br" aria-hidden="true"></span>
      <h2 data-hd-ticket-title>{CASES[0].ticketTitle}</h2>
      <div class="hd-ticket-rows" data-hd-ticket-rows>
        {CASES[0].rows.map((r) => <div>{r}</div>)}
      </div>
    </article>

    <!-- Descripción izquierda (modo casos) -->
    <div data-hd-desc class="hd-desc" aria-live="polite">
      <p data-hd-desc-key class="hd-desc-key">{CASES[0].descKey}</p>
      <p data-hd-desc-text class="hd-desc-text">{CASES[0].descText}</p>
      <a data-hd-desc-link href={CASES[0].href} class="hd-desc-link">
        <span data-hd-desc-cta>{CASES[0].ctaLabel}</span> →
      </a>
      <p data-hd-desc-num class="hd-desc-num">01 / 03</p>
    </div>

    <!-- Botones circulares Anterior / Siguiente -->
    <button type="button" data-hd-prev class="hd-nav-case hd-prev" aria-label="Caso anterior">
      <span class="hd-circle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M11 6l-6 6 6 6" />
        </svg>
      </span>
      <span class="hd-nav-label">caso<br />anterior</span>
    </button>

    <button type="button" data-hd-next class="hd-nav-case hd-next" aria-label="Siguiente caso">
      <span class="hd-circle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </span>
      <span class="hd-nav-label">siguiente<br />caso</span>
    </button>

    <!-- Indicador inferior de scroll + acceso rápido a toda la web -->
    <div data-hd-hint class="hd-hint hd-pre">
      <button type="button" data-hd-hint-btn class="hd-hint-btn">
        <span class="hd-drip-line" aria-hidden="true">
          <span class="hd-drip-bead"></span>
        </span>
        <span>desliza para entrar en los proyectos</span>
      </button>
      <a href="#pilares" class="hd-skip-web">o baja a ver toda la web ↓</a>
    </div>
  </div>
</section>

<style>
  .hd-stage {
    --green-900: #0b2f20;
    --green-800: #11402c;
    --mint: #cfeee0;
    --ink: #0d0f0e;
    font-family: "Inter Tight", var(--font-sans), sans-serif;
    background: linear-gradient(180deg, #0b2f20 0%, #124833 48%, #071912 100%);
  }

  .hd-stage-case-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #1b4a34 0%, #143a29 52%, #071912 100%);
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
    pointer-events: none;
  }

  .hd-stage.is-case .hd-stage-case-bg {
    opacity: 1;
  }

  .hd-scene {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hd-plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    transform-origin: center center;
    transition:
      transform 850ms var(--ease-in-out),
      opacity 650ms var(--ease-out),
      filter 650ms var(--ease-out);
  }

  .hd-stage.is-case .hd-plate {
    transform: scale(1.16);
    opacity: 0.12;
    filter: blur(10px);
  }

  .hd-plate-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(11, 47, 32, 0.72) 0%, rgba(11, 47, 32, 0.25) 42%, rgba(5, 5, 7, 0.88) 100%),
      radial-gradient(60% 60% at 50% 45%, transparent 30%, rgba(5, 5, 7, 0.6) 100%);
    pointer-events: none;
    z-index: 2;
  }

  .hd-wordmark {
    position: absolute;
    left: 2vw;
    top: clamp(58px, 7vh, 88px);
    width: 96vw;
    height: clamp(110px, 24vw, 270px);
    z-index: 3;
    pointer-events: none;
    overflow: visible;
  }

  .hd-wordmark text {
    font-family: "Inter Tight", sans-serif;
    font-weight: 900;
    font-size: 262px;
    letter-spacing: -6px;
  }

  .hd-cut {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 4;
    pointer-events: none;
  }

  .hd-script {
    position: absolute;
    left: clamp(20px, 6vw, 96px);
    top: clamp(128px, 21vw, 248px);
    z-index: 6;
    font-family: "Caveat Brush", cursive;
    font-size: clamp(2.1rem, 5.4vw, 4.9rem);
    line-height: 1;
    color: #ffffff;
    letter-spacing: -0.5px;
    transform: rotate(-8deg);
    transform-origin: 0 50%;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  /* Lanyard ID Badge */
  .hd-badge {
    position: absolute;
    right: clamp(14px, 5vw, 84px);
    top: -12px;
    width: clamp(148px, 16vw, 224px);
    z-index: 7;
    transform-origin: 50% 0;
    pointer-events: none;
  }

  .hd-lanyard-strap {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: -10px;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.35));
  }

  .hd-badge-sleeve {
    pointer-events: auto;
    cursor: grab;
    border-radius: 14px;
    padding: 8px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08));
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.48);
    backdrop-filter: blur(8px);
  }

  .hd-badge-card {
    background: #f8faf9;
    color: #141615;
    border-radius: 8px;
    padding: 12px 11px 11px;
  }

  .hd-badge-card h4 {
    font-size: clamp(1rem, 1.55vw, 1.38rem);
    line-height: 0.94;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .hd-badge-yr {
    font-size: 10px;
    font-weight: 700;
    color: #334155;
  }

  .hd-badge-role {
    margin-top: 7px;
    padding-top: 4px;
    border-top: 1px solid #1e293b;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .hd-badge-photo {
    width: 68px;
    height: 82px;
    margin: 9px auto;
    border-radius: 6px;
    overflow: hidden;
    background: #dfe4e1;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .hd-badge-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .hd-badge-rows {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hd-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    font-size: 8px;
    font-weight: 700;
    padding: 4px 0 2px;
    border-bottom: 1.5px dotted #334155;
  }

  .hd-badge-row b {
    font-weight: 600;
    color: #0f172a;
  }

  /* Vídeo de transición */
  .hd-trans {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    z-index: 8;
    pointer-events: none;
  }

  /* Contenedor de Portátil (Modo Casos) */
  .hd-case-wrap {
    position: absolute;
    inset: 0;
    z-index: 9;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 76px 16px 64px;
    opacity: 0;
    transform: scale(0.92) translateY(24px);
    pointer-events: none;
    transition:
      opacity 550ms var(--ease-out),
      transform 650ms var(--ease-out);
  }

  .hd-stage.is-case .hd-case-wrap {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
  }

  .hd-caseplate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    pointer-events: none;
  }

  .hd-laptop-shell {
    width: min(860px, 64vw);
    max-width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hd-laptop-lid {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10.4;
    border-radius: 18px 18px 6px 6px;
    padding: 14px 14px 16px;
    background: linear-gradient(180deg, #272b33 0%, #12151a 100%);
    border: 2px solid rgba(255, 255, 255, 0.16);
    box-shadow:
      0 32px 80px -12px rgba(0, 0, 0, 0.85),
      inset 0 1px 0 rgba(255, 255, 255, 0.18);
  }

  .hd-laptop-camera {
    position: absolute;
    top: 5px;
    left: 50%;
    transform: translateX(-50%);
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: #334155;
  }

  .hd-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    background: #000000;
    overflow: hidden;
  }

  .hd-screen-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 420ms var(--ease-out), transform 500ms var(--ease-out);
  }

  .hd-case-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }

  .hd-screen-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0) 40%);
    pointer-events: none;
    z-index: 2;
  }

  .hd-screen-flash {
    position: absolute;
    inset: 0;
    background: #ffffff;
    opacity: 0;
    pointer-events: none;
    z-index: 3;
  }

  .hd-screen-hit {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .hd-laptop-base {
    width: 112%;
    height: 16px;
    border-radius: 2px 2px 14px 14px;
    background: linear-gradient(180deg, #d4dae2 0%, #94a3b8 55%, #475569 100%);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.65);
    position: relative;
  }

  .hd-laptop-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 14%;
    height: 5px;
    border-radius: 0 0 6px 6px;
    background: #64748b;
  }

  /* Viewport-pinned UI */
  .hd-ui {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
  }

  .hd-nav {
    position: absolute;
    top: 14px;
    inset-inline: clamp(12px, 2.2vw, 32px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .hd-nav-left,
  .hd-nav-right {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.4vw, 18px);
  }

  .hd-tag {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 16px;
    border-radius: 3px;
    background: #ffffff;
    color: var(--ink);
    font-size: 14.5px;
    font-weight: 650;
    letter-spacing: -0.02em;
    white-space: nowrap;
    cursor: pointer;
    box-shadow:
      0 3px 0 rgba(0, 0, 0, 0.22),
      0 6px 14px rgba(0, 0, 0, 0.22);
    transition:
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out),
      background-color 180ms ease;
  }

  .hd-tag-accent {
    background: #cfeee0;
  }

  .hd-tag-web {
    border-bottom: 3px solid #3b82f6;
  }
  .hd-tag-software {
    border-bottom: 3px solid #10b981;
  }
  .hd-tag-tecnico {
    border-bottom: 3px solid #f97316;
  }

  @media (hover: hover) and (pointer: fine) {
    .hd-tag:hover {
      transform: translateY(-2px) rotate(-1.5deg);
      box-shadow:
        0 5px 0 rgba(0, 0, 0, 0.26),
        0 10px 18px rgba(0, 0, 0, 0.24);
    }
  }

  .hd-tag:active {
    transform: translateY(1px);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.22);
  }

  .hd-center-logo {
    pointer-events: none;
    position: absolute;
    left: 50%;
    top: 6px;
    transform: translateX(-50%);
    color: #ffffff;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.14em;
    opacity: 0;
    transition: opacity 380ms var(--ease-out);
    cursor: pointer;
  }

  .hd-stage.is-case .hd-center-logo {
    opacity: 1;
    pointer-events: auto;
  }

  /* Punched Paper Ticket */
  .hd-ticket {
    position: absolute;
    right: clamp(16px, 2.5vw, 34px);
    top: 86px;
    width: clamp(240px, 23vw, 336px);
    background: #ffffff;
    color: var(--ink);
    border-radius: 4px;
    padding: 22px 28px 18px 34px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.34);
    transform-origin: 50% 0;
    opacity: 0;
    transform: translateY(-48px) rotate(-5deg);
    transition:
      opacity 420ms var(--ease-out),
      transform 520ms var(--ease-out);
  }

  .hd-stage.is-case .hd-ticket {
    opacity: 1;
    transform: translateY(0) rotate(0deg);
  }

  .hd-hole {
    position: absolute;
    width: 18px;
    height: 18px;
    border-radius: 999px;
    background: var(--green-800);
    box-shadow: inset 0 2px 3px rgba(0, 0, 0, 0.38);
  }
  .hd-hole-tl { top: 10px; left: 10px; }
  .hd-hole-tr { top: 10px; right: 10px; }
  .hd-hole-bl { bottom: 10px; left: 10px; }
  .hd-hole-br { bottom: 10px; right: 10px; }

  .hd-ticket h2 {
    font-family: "Anton", var(--font-display), sans-serif;
    font-weight: 400;
    font-size: clamp(1.85rem, 3.1vw, 2.85rem);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin: 0;
  }

  .hd-ticket-rows {
    margin-top: 8px;
  }

  .hd-ticket-rows div {
    text-align: right;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 4px 0 3px;
    border-bottom: 1.5px dotted #2a2a2a;
  }

  /* Descripción izquierda */
  .hd-desc {
    position: absolute;
    left: clamp(16px, 2.2vw, 32px);
    top: 34%;
    width: clamp(170px, 15vw, 215px);
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 420ms var(--ease-out),
      transform 460ms var(--ease-out);
  }

  .hd-stage.is-case .hd-desc {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .hd-desc-key {
    font-size: 15.5px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .hd-desc-text {
    margin-top: 10px;
    font-size: 13.5px;
    line-height: 1.42;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.9);
  }

  .hd-desc-link {
    display: inline-block;
    margin-top: 12px;
    font-size: 13px;
    font-weight: 700;
    color: var(--mint);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hd-desc-num {
    margin-top: 14px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: rgba(255, 255, 255, 0.72);
    font-variant-numeric: tabular-nums;
  }

  /* Botones Prev / Next */
  .hd-nav-case {
    position: absolute;
    bottom: clamp(28px, 11vh, 110px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #ffffff;
    opacity: 0;
    pointer-events: none;
    cursor: pointer;
    transition: opacity 280ms var(--ease-out);
  }

  .hd-prev { left: clamp(20px, 5.5vw, 84px); }
  .hd-next { right: clamp(20px, 5.5vw, 84px); }

  .hd-stage.is-case .hd-nav-case {
    opacity: 1;
    pointer-events: auto;
  }

  .hd-stage.is-case .hd-prev.is-dim {
    opacity: 0.45;
  }

  .hd-circle {
    width: 48px;
    height: 48px;
    border-radius: 999px;
    border: 1.6px solid rgba(255, 255, 255, 0.9);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 200ms var(--ease-out), background-color 200ms ease;
  }

  .hd-circle svg {
    width: 22px;
    height: 22px;
  }

  .hd-next .hd-circle {
    background: #ffffff;
    color: var(--green-800);
    border-color: #ffffff;
  }

  @media (hover: hover) and (pointer: fine) {
    .hd-nav-case:hover .hd-circle {
      transform: scale(1.08);
    }
    .hd-next:hover .hd-circle {
      background: var(--mint);
    }
  }

  .hd-nav-case:active .hd-circle {
    transform: scale(0.95);
  }

  .hd-nav-label {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.08;
    text-align: center;
  }

  /* Hint inferior */
  .hd-hint {
    position: absolute;
    left: 50%;
    bottom: 20px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    pointer-events: auto;
    transition: opacity 260ms var(--ease-out);
  }

  .hd-stage.is-case .hd-hint {
    opacity: 0;
    pointer-events: none;
  }

  .hd-hint-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.88);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .hd-drip-line {
    position: relative;
    width: 1.5px;
    height: 22px;
    background: rgba(255, 255, 255, 0.35);
    overflow: hidden;
  }

  .hd-drip-bead {
    position: absolute;
    left: 0;
    top: -40%;
    width: 100%;
    height: 40%;
    background: #ffffff;
    animation: hd-drip 1.6s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }

  @keyframes hd-drip {
    to {
      top: 100%;
    }
  }

  .hd-skip-web {
    font-size: 11.5px;
    color: rgba(255, 255, 255, 0.65);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hd-skip-web:hover {
    color: #ffffff;
  }

  /* Responsive móvil (<= 820px) */
  @media (max-width: 820px) {
    .hd-nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
      top: 10px;
    }
    .hd-nav-left,
    .hd-nav-right {
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
    }
    .hd-tag {
      height: 30px;
      padding: 0 10px;
      font-size: 12px;
    }
    .hd-center-logo {
      display: none;
    }
    .hd-badge {
      width: 136px;
      top: 56px;
      right: 10px;
    }
    .hd-badge-photo {
      width: 50px;
      height: 60px;
      margin: 6px auto;
    }
    .hd-wordmark {
      top: 96px;
      height: 110px;
    }
    .hd-script {
      top: 182px;
      left: 16px;
      font-size: 2.3rem;
    }
    .hd-case-wrap {
      align-items: flex-end;
      padding: 12px 14px 76px;
    }
    .hd-laptop-shell {
      width: 92vw;
    }
    .hd-ticket {
      left: 50%;
      right: auto;
      top: 62px;
      transform: translateX(-50%) translateY(-30px);
      width: min(88vw, 340px);
      padding: 16px 22px 12px 26px;
    }
    .hd-stage.is-case .hd-ticket {
      transform: translateX(-50%) translateY(0);
    }
    .hd-ticket h2 {
      font-size: 2rem;
    }
    .hd-desc {
      left: 50%;
      top: 220px;
      transform: translateX(-50%);
      width: min(88vw, 340px);
      text-align: center;
    }
    .hd-stage.is-case .hd-desc {
      transform: translateX(-50%);
    }
    .hd-desc-num {
      display: none;
    }
    .hd-nav-case {
      bottom: 16px;
      flex-direction: row;
      gap: 8px;
    }
    .hd-next {
      flex-direction: row-reverse;
    }
    .hd-circle {
      width: 40px;
      height: 40px;
    }
    .hd-nav-label br {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hd-drip-bead {
      animation: none;
    }
    .hd-stage * {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-laptop-dive]');
  if (stage) {
    const cases = JSON.parse(stage.dataset.cases || '[]');
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const plateEl = stage.querySelector<HTMLImageElement>('[data-hd-plate]');
    const cutEl = stage.querySelector<HTMLImageElement>('[data-hd-cut]');
    const casePlateEl = stage.querySelector<HTMLImageElement>('[data-hd-caseplate]');
    const laptopShellEl = stage.querySelector<HTMLElement>('[data-hd-laptop-shell]');
    const transEl = stage.querySelector<HTMLVideoElement>('[data-hd-trans]');
    const wordmarkEl = stage.querySelector<HTMLElement>('[data-hd-wordmark]');
    const scriptEl = stage.querySelector<HTMLElement>('[data-hd-script]');
    const badgeEl = stage.querySelector<HTMLElement>('[data-hd-badge]');
    const badgeHitEl = stage.querySelector<HTMLElement>('[data-hd-badge-hit]');
    const flashEl = stage.querySelector<HTMLElement>('[data-hd-flash]');
    const screenHitEl = stage.querySelector<HTMLButtonElement>('[data-hd-screen-hit]');

    const ticketTitleEl = stage.querySelector<HTMLElement>('[data-hd-ticket-title]');
    const ticketRowsEl = stage.querySelector<HTMLElement>('[data-hd-ticket-rows]');
    const descKeyEl = stage.querySelector<HTMLElement>('[data-hd-desc-key]');
    const descTextEl = stage.querySelector<HTMLElement>('[data-hd-desc-text]');
    const descLinkEl = stage.querySelector<HTMLAnchorElement>('[data-hd-desc-link]');
    const descCtaEl = stage.querySelector<HTMLElement>('[data-hd-desc-cta]');
    const descNumEl = stage.querySelector<HTMLElement>('[data-hd-desc-num]');

    const prevBtn = stage.querySelector<HTMLButtonElement>('[data-hd-prev]');
    const nextBtn = stage.querySelector<HTMLButtonElement>('[data-hd-next]');
    const studioBtn = stage.querySelector<HTMLButtonElement>('[data-hd-studio]');
    const centerLogoBtn = stage.querySelector<HTMLButtonElement>('[data-hd-center-logo]');
    const diveBtn = stage.querySelector<HTMLButtonElement>('[data-hd-dive]');
    const hintBtn = stage.querySelector<HTMLButtonElement>('[data-hd-hint-btn]');

    const slides = Array.from(stage.querySelectorAll<HTMLElement>('[data-hd-media]'));
    const caseVideos = Array.from(stage.querySelectorAll<HTMLVideoElement>('[data-hd-case-video]'));

    let mode: 'hero' | 'case' = 'hero';
    let currentIdx = 0;
    let busy = false;
    let transReady = false;
    let swayAnim: Animation | null = null;
    let wheelLockUntil = 0;

    // Auto-detección silenciosa de assets premium en /hero-dive/
    const probeAsset = async (url: string): Promise<boolean> => {
      try {
        const res = await fetch(url, { method: 'HEAD' });
        return res.ok;
      } catch {
        return false;
      }
    };

    (async () => {
      if (plateEl && (await probeAsset('/hero-dive/plate.webp'))) {
        plateEl.src = '/hero-dive/plate.webp';
      }
      if (cutEl && (await probeAsset('/hero-dive/cut.png'))) {
        cutEl.src = '/hero-dive/cut.png';
        cutEl.classList.remove('hidden');
      }
      if (casePlateEl && (await probeAsset('/hero-dive/case-plate.webp'))) {
        casePlateEl.src = '/hero-dive/case-plate.webp';
        casePlateEl.classList.remove('hidden');
        laptopShellEl?.classList.add('has-caseplate');
      }
      if (transEl && (await probeAsset('/hero-dive/trans.mp4'))) {
        try {
          const blob = await (await fetch('/hero-dive/trans.mp4')).blob();
          transEl.src = URL.createObjectURL(blob);
          transEl.addEventListener(
            'loadeddata',
            () => {
              transReady = true;
            },
            { once: true }
          );
        } catch {
          // Fallback suave sin vídeo
        }
      }
      for (let i = 0; i < cases.length; i++) {
        const v = caseVideos[i];
        if (v && (await probeAsset(cases[i].video))) {
          v.src = cases[i].video;
          v.classList.remove('hidden');
        }
      }
    })();

    // Animación de entrada (Web Animations API)
    const runEntrance = () => {
      if (stage.dataset.entered === '1') return;
      stage.dataset.entered = '1';

      const tags = Array.from(stage.querySelectorAll<HTMLElement>('.hd-tag'));
      if (rm) {
        stage.querySelectorAll<HTMLElement>('.hd-pre').forEach((el) => (el.style.opacity = '1'));
        return;
      }

      tags.forEach((tag, i) => {
        tag.animate(
          [
            { opacity: 0, transform: 'translateY(-36px) rotate(-4deg)' },
            { opacity: 1, transform: 'translateY(0) rotate(0deg)' },
          ],
          { duration: 680, delay: 100 + i * 75, easing: 'cubic-bezier(.3,1.5,.5,1)', fill: 'both' }
        );
      });

      wordmarkEl?.animate(
        [
          { opacity: 0, transform: 'translateY(50px)', clipPath: 'inset(100% 0 0 0)' },
          { opacity: 1, transform: 'translateY(0)', clipPath: 'inset(0 0 0 0)' },
        ],
        { duration: 1050, delay: 220, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'both' }
      );

      scriptEl?.animate(
        [
          { opacity: 0, clipPath: 'inset(0 100% 0 0)' },
          { opacity: 1, clipPath: 'inset(0 0 0 0)' },
        ],
        { duration: 850, delay: 920, easing: 'cubic-bezier(.5,0,.3,1)', fill: 'both' }
      );

      if (badgeEl) {
        const drop = badgeEl.animate(
          [
            { opacity: 0, transform: 'translateY(-115%) rotate(8deg)', offset: 0 },
            { opacity: 1, transform: 'translateY(0) rotate(-3deg)', offset: 0.6 },
            { opacity: 1, transform: 'translateY(0) rotate(1.5deg)', offset: 0.8 },
            { opacity: 1, transform: 'translateY(0) rotate(0deg)', offset: 1 },
          ],
          { duration: 1400, delay: 620, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'both' }
        );
        drop.onfinish = () => {
          if (mode === 'hero' && !rm) {
            swayAnim = badgeEl.animate(
              [{ transform: 'rotate(-1.1deg)' }, { transform: 'rotate(1.1deg)' }],
              { duration: 3200, iterations: Infinity, direction: 'alternate', easing: 'ease-in-out' }
            );
          }
        };
      }

      const hintEl = stage.querySelector<HTMLElement>('[data-hd-hint]');
      hintEl?.animate([{ opacity: 0 }, { opacity: 1 }], {
        duration: 600,
        delay: 1400,
        fill: 'both',
      });
    };

    // Hover swing aditivo sobre el lanyard
    badgeHitEl?.addEventListener('pointerenter', () => {
      if (mode !== 'hero' || rm || !badgeEl) return;
      badgeEl.animate(
        [
          { transform: 'rotate(0deg)' },
          { transform: 'rotate(-6deg)' },
          { transform: 'rotate(4deg)' },
          { transform: 'rotate(-2deg)' },
          { transform: 'rotate(0deg)' },
        ],
        { duration: 1300, easing: 'ease-out', composite: 'add' }
      );
    });

    const fillCase = (idx: number) => {
      const item = cases[idx];
      if (!item) return;
      if (ticketTitleEl) ticketTitleEl.textContent = item.ticketTitle;
      if (ticketRowsEl) {
        ticketRowsEl.innerHTML = item.rows.map((r: string) => `<div>${r}</div>`).join('');
      }
      if (descKeyEl) descKeyEl.textContent = item.descKey;
      if (descTextEl) descTextEl.textContent = item.descText;
      if (descLinkEl) descLinkEl.href = item.href;
      if (descCtaEl) descCtaEl.textContent = item.ctaLabel;
      if (descNumEl) descNumEl.textContent = `0${idx + 1} / 0${cases.length}`;
      prevBtn?.classList.toggle('is-dim', idx === 0);

      slides.forEach((s, i) => {
        s.style.opacity = i === idx ? '1' : '0';
        s.style.transform = i === idx ? 'scale(1)' : 'scale(1.04)';
      });

      caseVideos.forEach((v, i) => {
        if (!v.src) return;
        if (i === idx) {
          v.currentTime = 0;
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      });

      if (!rm && flashEl) {
        flashEl.animate([{ opacity: 0 }, { opacity: 0.45 }, { opacity: 0 }], {
          duration: 460,
          easing: 'ease-out',
        });
      }
    };

    const toCase = async () => {
      if (busy || mode === 'case') return;
      busy = true;

      swayAnim?.cancel();
      if (!rm) {
        wordmarkEl?.animate([{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-40px)' }], {
          duration: 360,
          easing: 'cubic-bezier(.5,0,.75,0)',
          fill: 'forwards',
        });
        scriptEl?.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 300, fill: 'forwards' });
        badgeEl?.animate(
          [{ opacity: 1, transform: 'translateY(0) rotate(0deg)' }, { opacity: 0, transform: 'translateY(-110%) rotate(-6deg)' }],
          { duration: 360, easing: 'cubic-bezier(.5,0,.75,0)', fill: 'forwards' }
        );
      }

      if (!rm && transReady && transEl && transEl.duration) {
        transEl.currentTime = 0;
        transEl.style.opacity = '1';
        await transEl.play().catch(() => {});
        await new Promise<void>((resolve) => {
          const tick = () => {
            const p = transEl.currentTime / (transEl.duration || 5);
            transEl.playbackRate = Math.max(1.2, 1.8 + 2.4 * Math.sin(Math.PI * Math.min(p * 1.08, 1)));
            if (transEl.ended || p >= 0.992) {
              transEl.pause();
              transEl.style.opacity = '0';
              resolve();
            } else {
              requestAnimationFrame(tick);
            }
          };
          requestAnimationFrame(tick);
        });
      } else {
        await new Promise((r) => setTimeout(r, rm ? 0 : 280));
      }

      mode = 'case';
      currentIdx = 0;
      stage.classList.add('is-case');
      fillCase(0);
      setTimeout(() => {
        busy = false;
      }, rm ? 0 : 480);
    };

    const toHero = () => {
      if (busy || mode === 'hero') return;
      busy = true;
      mode = 'hero';
      stage.classList.remove('is-case');
      caseVideos.forEach((v) => v.pause());

      if (!rm) {
        wordmarkEl?.animate([{ opacity: 0, transform: 'translateY(36px)' }, { opacity: 1, transform: 'translateY(0)' }], {
          duration: 650,
          delay: 180,
          easing: 'cubic-bezier(.2,.8,.2,1)',
          fill: 'forwards',
        });
        scriptEl?.animate(
          [{ opacity: 0, clipPath: 'inset(0 100% 0 0)' }, { opacity: 1, clipPath: 'inset(0 0 0 0)' }],
          { duration: 650, delay: 260, fill: 'forwards' }
        );
        if (badgeEl) {
          const back = badgeEl.animate(
            [
              { opacity: 0, transform: 'translateY(-110%) rotate(6deg)', offset: 0 },
              { opacity: 1, transform: 'translateY(0) rotate(-2deg)', offset: 0.7 },
              { opacity: 1, transform: 'translateY(0) rotate(0deg)', offset: 1 },
            ],
            { duration: 950, delay: 220, easing: 'cubic-bezier(.2,.8,.2,1)', fill: 'forwards' }
          );
          back.onfinish = () => {
            if (mode === 'hero') {
              swayAnim = badgeEl.animate(
                [{ transform: 'rotate(-1.1deg)' }, { transform: 'rotate(1.1deg)' }],
                { duration: 3200, iterations: Infinity, direction: 'alternate', easing: 'ease-in-out' }
              );
            }
          };
        }
      }

      setTimeout(() => {
        busy = false;
      }, rm ? 0 : 650);
    };

    const swapTo = (nextIdx: number) => {
      if (busy || mode !== 'case') return;
      busy = true;
      currentIdx = nextIdx;
      fillCase(nextIdx);
      setTimeout(() => {
        busy = false;
      }, rm ? 0 : 380);
    };

    const handleNext = () => {
      if (mode === 'hero') {
        toCase();
      } else if (currentIdx < cases.length - 1) {
        swapTo(currentIdx + 1);
      } else {
        // Al pasar del último caso, bajamos suavemente al resto de la web SEO
        const nextSection = document.getElementById('pilares');
        if (nextSection) nextSection.scrollIntoView({ behavior: rm ? 'auto' : 'smooth' });
      }
    };

    const handlePrev = () => {
      if (mode !== 'case') return;
      if (currentIdx === 0) {
        toHero();
      } else {
        swapTo(currentIdx - 1);
      }
    };

    diveBtn?.addEventListener('click', toCase);
    hintBtn?.addEventListener('click', toCase);
    studioBtn?.addEventListener('click', toHero);
    centerLogoBtn?.addEventListener('click', toHero);
    nextBtn?.addEventListener('click', handleNext);
    screenHitEl?.addEventListener('click', () => {
      if (mode === 'case') swapTo((currentIdx + 1) % cases.length);
    });
    prevBtn?.addEventListener('click', handlePrev);

    // Captura inteligente de rueda solo cuando el Hero está arriba en el viewport
    window.addEventListener(
      'wheel',
      (e) => {
        if (window.scrollY > 30) return;
        const now = Date.now();
        if (Math.abs(e.deltaY) < 18) return;

        if (e.deltaY > 0) {
          if (mode === 'hero' || currentIdx < cases.length - 1) {
            e.preventDefault();
            if (now < wheelLockUntil) return;
            wheelLockUntil = now + 720;
            handleNext();
          }
        } else if (e.deltaY < 0 && mode === 'case') {
          e.preventDefault();
          if (now < wheelLockUntil) return;
          wheelLockUntil = now + 720;
          handlePrev();
        }
      },
      { passive: false }
    );

    // Teclado
    window.addEventListener('keydown', (e) => {
      if (window.scrollY > 30) return;
      if (['ArrowDown', 'PageDown', 'ArrowRight'].includes(e.key)) {
        if (mode === 'hero' || currentIdx < cases.length - 1) {
          e.preventDefault();
          handleNext();
        }
      } else if (['ArrowUp', 'PageUp', 'ArrowLeft'].includes(e.key) && mode === 'case') {
        e.preventDefault();
        handlePrev();
      }
    });

    // Touch swipe en móvil
    let touchY = 0;
    stage.addEventListener(
      'touchstart',
      (e) => {
        touchY = e.touches[0]?.clientY ?? 0;
      },
      { passive: true }
    );
    stage.addEventListener(
      'touchend',
      (e) => {
        const dy = touchY - (e.changedTouches[0]?.clientY ?? touchY);
        if (Math.abs(dy) < 42) return;
        if (dy > 0 && (mode === 'hero' || currentIdx < cases.length - 1)) handleNext();
        if (dy < 0 && mode === 'case') handlePrev();
      },
      { passive: true }
    );

    // Disparar entrada con failsafe
    const startWhenReady = () => requestAnimationFrame(runEntrance);
    Promise.race([
      document.fonts?.ready ?? Promise.resolve(),
      new Promise((r) => setTimeout(r, 1400)),
    ]).then(startWhenReady);
    setTimeout(runEntrance, 2200);
  }
</script>

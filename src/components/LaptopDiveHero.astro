    }

    .hd-desc-key {
      font-size: 13px;
    }

    .hd-desc-text {
      margin-top: 4px;
      font-size: 12px;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .hd-desc-link {
      margin-top: 6px;
      font-size: 12px;
    }

    .hd-desc-num {
      display: none;
    }

    /* Portátil centrado en su propia franja entre descripción y controles */
    .hd-case-wrap {
      align-items: flex-end;
      padding: 0 14px 160px;
    }

    .hd-laptop-shell {
      width: min(86vw, 360px);
    }

    .hd-laptop-lid {
      padding: 8px 8px 10px;
      border-radius: 12px 12px 4px 4px;
    }

    .hd-laptop-base {
      height: 10px;
    }

    /* Botones Anterior / Siguiente limpios y elevados por encima del Avatar flotante */
    .hd-nav-case {
      bottom: 104px;
      flex-direction: row;
      gap: 7px;
      background: rgba(5, 5, 7, 0.55);
      border: 1px solid rgba(255, 255, 255, 0.14);
      backdrop-filter: blur(10px);
      border-radius: 999px;
      padding: 4px 12px 4px 5px;
    }

    .hd-prev {
      left: 14px;
    }

    .hd-next {
      right: 14px;
      flex-direction: row-reverse;
      padding: 4px 5px 4px 12px;
    }

    .hd-circle {
      width: 34px;
      height: 34px;
    }

    .hd-circle svg {
      width: 17px;
      height: 17px;
    }

    .hd-nav-label {

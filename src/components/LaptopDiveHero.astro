    }

    /* Modo Casos (proyectos) en móvil: zonas limpias sin solaparse ni tocar el avatar flotante */
    .hd-ticket {
      left: 50%;
      right: auto;
      top: 84px;
      width: min(90vw, 350px);
      padding: 12px 22px 10px 22px;
      transform: translateX(-50%) translateY(-20px);
    }

    .hd-stage.is-case .hd-ticket {
      transform: translateX(-50%) translateY(0);

---
/**
 * Hero "Laptop Dive" — Scroll-Driven Frame Sequence sobre <canvas> (técnica Apple).
 * - 60 frames WebP (798 KB total) extraídos de trans.mp4.
 * - Scroll 100% nativo (position: sticky dentro de pista 260vh): cero secuestro de scroll,
 *   funciona perfecto en Mac Trackpad, Magic Mouse, Windows, iPhone y Android.
 * - Pantalla de proyectos calculada matemáticamente sobre (drawX, drawY, drawW, drawH)
 *   del canvas en cada resize: imposible que se salga del bisel del portátil.
 */
interface DiveCase {
  id: string;
  ticketTitle: string;
  rows: [string, string, string];
  descKey: string;
  descText: string;
  image: string;
  href: string;
  ctaLabel: string;
  accent: string;
}

const CASES: DiveCase[] = [
  {
    id: 'web',
    ticketTitle: 'WEB & SEO/GEO',
    rows: ['ASTRO + KEYSTATIC', 'AAAR · SERINAMAR', '10–15 DÍAS'],
    descKey: 'Webs reales en Marbella',
    descText:
      'Páginas a medida en HTML estático (< 0,8s), SEO local y GEO para IA: AAAR Marbella (compromiso social), Grupo Serinamar o Cerrajería Carlos Neira.',
    image: '/hero-dive/case-web.webp',
    href: '/paginas-web',
    ctaLabel: 'Explorar Diseño Web',
    accent: '#3B82F6',
  },
  {
    id: 'software',
    ticketTitle: 'SOFTWARE ERP',
    rows: ['BOBISAPP · LA CLAVE', 'SIN CUOTAS / USUARIO', 'DESDE 6.000 €'],
    descKey: 'Apps reales en producción',
    descText:
      'ERP, CRM y plataformas privadas en la nube como Bobisapp o Academia La Clave, 100% en propiedad y con 1 mes de beta con mejoras en 24h.',
    image: '/hero-dive/case-software.webp',
    href: '/software-empresas',
    ctaLabel: 'Explorar Software',
    accent: '#10B981',
  },
  {
    id: 'tecnico',
    ticketTitle: 'TÉCNICO EN CASA',
    rows: ['20 AÑOS · RTV MARBELLA', 'CABOPINO A ESTEPONA', 'DESDE 45 €/H'],
    descKey: '20 años de experiencia',
    descText:
      'Dos décadas dando soporte técnico a domicilio desde Cabopino hasta Estepona y colaborando en Radio Televisión Marbella. También remoto mundial vía RustDesk.',
    image: '/assets/optimized/servicio-tecnico-marbella.webp',
    href: '/servicio-tecnico',
    ctaLabel: 'Explorar Servicio Técnico',
    accent: '#F97316',
  },
];
---

<section
  id="inicio"
  data-laptop-dive
  data-cases={JSON.stringify(CASES)}
  aria-label="Presentación interactiva de papis.app"
  class="hd-track relative w-full select-none"
>
  <!-- H1 semántico para SEO, GEO y lectores de pantalla -->
  <h1 class="sr-only">
    papis.app — Diseño web ultrarrápido con SEO y GEO, software a medida y servicio técnico en Marbella
  </h1>

  <!-- Escenario Sticky 100dvh controlado 1:1 por el scroll nativo -->
  <div data-hd-stage class="hd-stage">
    <!-- Canvas HD de secuencia de 60 frames (00..59) -->
    <canvas data-hd-canvas class="hd-canvas" aria-hidden="true"></canvas>

    <!-- Sutil viñeta superior/inferior para legibilidad de botones -->
    <div aria-hidden="true" class="hd-vignette"></div>

    <!-- Capa 2: Wordmark gigante PAPIS.APP (detrás del recorte cut.webp en frame 0) -->
    <svg
      data-hd-wordmark
      class="hd-wordmark"
      viewBox="0 0 1440 260"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="papisWordmarkGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
          <stop offset="52%" stop-color="#f1f5f3" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#d7e6de" stop-opacity="0.22" />
        </linearGradient>
      </defs>
      <text
        x="18"
        y="214"
        textLength="1404"
        lengthAdjust="spacingAndGlyphs"
        fill="url(#papisWordmarkGrad)"
      >
        PAPIS.APP
      </text>
    </svg>

    <!-- Capa 3: Recorte transparente de David Papis (posicionamiento exacto por JS sobre el canvas) -->
    <img
      data-hd-cut
      src="/hero-dive/cut.webp"
      alt=""
      width="1376"
      height="768"
      loading="eager"
      decoding="async"
      aria-hidden="true"
      class="hd-cut"
    />

    <!-- Capa 4: Firma manuscrita Caveat Brush -->
    <p data-hd-script class="hd-script" aria-hidden="true">
      web · software · ia
    </p>

    <!-- Capa 5: Lanyard ID Badge colgante (solo desktop) -->
    <div data-hd-badge class="hd-badge" aria-hidden="true">
      <svg class="hd-lanyard-strap" viewBox="0 0 260 220" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M114 0H146L141 148H119L114 0Z" fill="#E8ECEA" />
        <path d="M127 0H133V148H127V0Z" fill="#CBD5D0" opacity="0.55" />
        <rect x="115" y="144" width="30" height="16" rx="4" fill="#94A3B8" />
        <path
          d="M122 160H138L135 186C135 190 132.5 193 130 193C127.5 193 125 190 125 186L122 160Z"
          fill="#CBD5E1"
          stroke="#475569"
          stroke-width="2"
        />
        <rect x="108" y="190" width="44" height="14" rx="4" fill="#E2E8F0" stroke="#64748B" stroke-width="1.5" />
      </svg>

      <div class="hd-badge-sleeve" data-hd-badge-hit>
        <div class="hd-badge-card">
          <div class="flex items-start justify-between">
            <h4>TECH<br />STUDIO</h4>
            <span class="hd-badge-yr">2026</span>
          </div>
          <p class="hd-badge-role">FOUNDER // MARBELLA</p>

          <div class="hd-badge-photo">
            <img
              src="/hero-dive/papis-badge-face.webp"
              alt="David Papis"
              width="92"
              height="112"
              loading="eager"
              decoding="async"
            />
          </div>

          <div class="hd-badge-rows">
            <div class="hd-badge-row"><span>NAME</span><b>DAVID PAPIS</b></div>
            <div class="hd-badge-row"><span>FOCUS</span><b>WEB · ERP · IA</b></div>
            <div class="hd-badge-row"><span>TEL</span><b>+34 652 918 061</b></div>
            <div class="hd-badge-row"><span>WEB</span><b>PAPIS.APP</b></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Capa 6: Pantalla del MacBook calibrada AL PÍXEL por JS sobre el último frame del canvas -->
    <div data-hd-screen class="hd-screen">
      {
        CASES.map((item, idx) => (
          <div
            data-hd-media={idx}
            class="hd-screen-slide"
            style={`opacity: ${idx === 0 ? 1 : 0};`}
          >
            <img
              src={item.image}
              alt={item.ticketTitle}
              loading={idx === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="h-full w-full object-contain bg-[#06090f]"
            />
          </div>
        ))
      }
      <div aria-hidden="true" class="hd-screen-sheen"></div>
      <div data-hd-flash aria-hidden="true" class="hd-screen-flash"></div>
      <button
        type="button"
        data-hd-screen-hit
        class="hd-screen-hit"
        aria-label="Pasar al siguiente caso en la pantalla"
      ></button>
    </div>

    <!-- Capa UI fijada al viewport sticky -->
    <div class="hd-ui">
      <!-- Barra superior estilo sticker tags -->
      <nav aria-label="Navegación principal del estudio" class="hd-nav">
        <div class="hd-nav-left">
          <button type="button" data-hd-studio class="hd-tag">mi estudio</button>
          <a href="/paginas-web" class="hd-tag hd-tag-web">web</a>
          <a href="/software-empresas" class="hd-tag hd-tag-software">software</a>
          <a href="/servicio-tecnico" class="hd-tag hd-tag-tecnico">técnico</a>
        </div>

        <button
          type="button"
          data-hd-center-logo
          class="hd-center-logo"
          aria-label="Volver al principio del estudio papis.app"
        >
          PAPIS.APP
        </button>

        <div class="hd-nav-right">
          <button type="button" data-hd-dive class="hd-tag">proyectos</button>
          <a href="/contacto" class="hd-tag hd-tag-accent">presupuesto</a>
        </div>
      </nav>

      <!-- Ticket perforado (top-right en modo casos) -->
      <article data-hd-ticket class="hd-ticket" aria-live="polite">
        <span class="hd-hole hd-hole-tl" aria-hidden="true"></span>
        <span class="hd-hole hd-hole-tr" aria-hidden="true"></span>
        <span class="hd-hole hd-hole-bl" aria-hidden="true"></span>
        <span class="hd-hole hd-hole-br" aria-hidden="true"></span>
        <h2 data-hd-ticket-title>{CASES[0].ticketTitle}</h2>
        <div class="hd-ticket-rows" data-hd-ticket-rows>
          {CASES[0].rows.map((r) => <div>{r}</div>)}
        </div>
      </article>

      <!-- Tarjeta editorial izquierda a media altura con animación escalonada -->
      <div data-hd-desc class="hd-desc" aria-live="polite">
        <div class="hd-desc-badge" data-hd-stagger="0">
          <span data-hd-desc-dot class="hd-desc-dot" style={`background: ${CASES[0].accent};`}></span>
          <span data-hd-desc-num class="hd-desc-num">01 / 03</span>
        </div>
        <h3 data-hd-desc-key data-hd-stagger="1" class="hd-desc-title">{CASES[0].descKey}</h3>
        <p data-hd-desc-text data-hd-stagger="2" class="hd-desc-text">{CASES[0].descText}</p>
        <a data-hd-desc-link data-hd-stagger="3" href={CASES[0].href} class="hd-desc-link">
          <span data-hd-desc-cta>{CASES[0].ctaLabel}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Botones circulares Anterior / Siguiente a los lados del portátil (sin tocar WhatsApp) -->
      <button type="button" data-hd-prev class="hd-nav-case hd-prev" aria-label="Caso anterior">
        <span class="hd-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M19 12H5M11 6l-6 6 6 6" />
          </svg>
        </span>
        <span class="hd-nav-label">Anterior</span>
      </button>

      <button type="button" data-hd-next class="hd-nav-case hd-next" aria-label="Siguiente caso">
        <span class="hd-circle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        </span>
        <span class="hd-nav-label">Siguiente</span>
      </button>

      <!-- Indicador inferior de scroll -->
      <div data-hd-hint class="hd-hint">
        <button type="button" data-hd-hint-btn class="hd-hint-btn">
          <span class="hd-drip-line" aria-hidden="true">
            <span class="hd-drip-bead"></span>
          </span>
          <span>desliza despacio para entrar en el portátil</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .hd-track {
    --ink: #0d0f0e;
    --mint: #cfeee0;
    --green-800: #11402c;
    height: 175vh;
    background: #07131e;
    font-family: "Inter Tight", var(--font-sans);
  }

  .hd-stage {
    position: sticky;
    top: 0;
    height: 100dvh;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(180deg, #07131e 0%, #0e2234 100%);
    color: #ffffff;
  }

  .hd-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
  }

  .hd-vignette {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(7, 19, 30, 0.34) 0%,
      rgba(7, 19, 30, 0) 35%,
      rgba(5, 8, 14, 0.5) 100%
    );
  }

  .hd-wordmark {
    position: absolute;
    left: 2vw;
    top: clamp(58px, 7vh, 88px);
    width: 96vw;
    height: clamp(110px, 24vw, 270px);
    z-index: 3;
    pointer-events: none;
    overflow: visible;
    will-change: transform, opacity;
  }

  .hd-wordmark text {
    font-family: "Inter Tight", sans-serif;
    font-weight: 900;
    font-size: 262px;
    letter-spacing: -6px;
  }

  .hd-cut {
    position: absolute;
    z-index: 4;
    pointer-events: none;
    max-width: none;
    will-change: opacity;
  }

  .hd-script {
    position: absolute;
    left: clamp(20px, 6vw, 96px);
    top: clamp(128px, 21vw, 248px);
    z-index: 6;
    font-family: "Caveat Brush", cursive;
    font-size: clamp(2.1rem, 5.4vw, 4.9rem);
    line-height: 1;
    color: #ffffff;
    letter-spacing: -0.5px;
    transform: rotate(-8deg);
    transform-origin: 0 50%;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    pointer-events: none;
    will-change: transform, opacity;
  }

  /* Lanyard ID Badge */
  .hd-badge {
    position: absolute;
    right: clamp(14px, 5vw, 84px);
    top: -12px;
    width: clamp(148px, 16vw, 224px);
    z-index: 7;
    transform-origin: 50% 0;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .hd-lanyard-strap {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: -10px;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.35));
  }

  .hd-badge-sleeve {
    pointer-events: auto;
    cursor: grab;
    border-radius: 14px;
    padding: 8px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08));
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.48);
    backdrop-filter: blur(8px);
  }

  .hd-badge-card {
    background: #f8faf9;
    color: #141615;
    border-radius: 8px;
    padding: 12px 11px 11px;
  }

  .hd-badge-card h4 {
    font-size: clamp(1rem, 1.55vw, 1.38rem);
    line-height: 0.94;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .hd-badge-yr {
    font-size: 10px;
    font-weight: 700;
    color: #334155;
  }

  .hd-badge-role {
    margin-top: 7px;
    padding-top: 4px;
    border-top: 1px solid #1e293b;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .hd-badge-photo {
    width: 68px;
    height: 82px;
    margin: 9px auto;
    border-radius: 6px;
    overflow: hidden;
    background: #dfe4e1;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .hd-badge-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .hd-badge-rows {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hd-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    font-size: 8px;
    font-weight: 700;
    padding: 4px 0 2px;
    border-bottom: 1.5px dotted #334155;
  }

  .hd-badge-row b {
    font-weight: 600;
    color: #0f172a;
  }

  /* Pantalla del portátil posicionada matemáticamente sobre el último frame del canvas */
  .hd-screen {
    position: absolute;
    z-index: 10;
    border-radius: 4px;
    background: #000000;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 280ms var(--ease-out);
  }

  .hd-stage.is-case .hd-screen {
    opacity: 1;
    pointer-events: auto;
  }

  .hd-screen-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 380ms var(--ease-out), transform 420ms var(--ease-out);
  }

  .hd-screen-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 40%);
    pointer-events: none;
    z-index: 2;
  }

  .hd-screen-flash {
    position: absolute;
    inset: 0;
    background: #ffffff;
    opacity: 0;
    pointer-events: none;
    z-index: 3;
  }

  .hd-screen-hit {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  /* UI sobre el escenario */
  .hd-ui {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
  }

  .hd-nav {
    position: absolute;
    top: 14px;
    inset-inline: clamp(12px, 2.2vw, 32px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .hd-nav-left,
  .hd-nav-right {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.4vw, 18px);
  }

  .hd-tag {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 16px;
    border-radius: 3px;
    background: #ffffff;
    color: var(--ink);
    font-size: 14.5px;
    font-weight: 650;
    letter-spacing: -0.02em;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
    transition: transform 200ms var(--ease-out), background-color 200ms var(--ease-out);
  }

  .hd-tag:hover {
    transform: translateY(-2px);
  }

  .hd-tag-web {
    border-bottom: 3px solid #3b82f6;
  }
  .hd-tag-software {
    border-bottom: 3px solid #10b981;
  }
  .hd-tag-tecnico {
    border-bottom: 3px solid #f97316;
  }
  .hd-tag-accent {
    background: var(--mint);
    color: var(--green-800);
  }

  .hd-center-logo {
    pointer-events: none;
    opacity: 0;
    transform: translateY(-8px);
    font-weight: 900;
    font-size: 18px;
    letter-spacing: -0.04em;
    color: #ffffff;
    cursor: pointer;
    transition: opacity 320ms var(--ease-out), transform 320ms var(--ease-out);
  }

  .hd-stage.is-case .hd-center-logo {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  /* Ticket perforado (top-right en modo casos) */
  .hd-ticket {
    position: absolute;
    top: clamp(74px, 10vh, 108px);
    right: clamp(16px, 3vw, 44px);
    width: clamp(210px, 20vw, 270px);
    background: #ffffff;
    color: var(--ink);
    border-radius: 4px;
    padding: 16px 24px 14px;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.42);
    opacity: 0;
    transform: translateY(-18px) rotate(1.5deg);
    pointer-events: none;
    transition: opacity 360ms var(--ease-out), transform 420ms var(--ease-out);
  }

  .hd-stage.is-case .hd-ticket {
    opacity: 1;
    transform: translateY(0) rotate(0deg);
    pointer-events: auto;
  }

  .hd-hole {
    position: absolute;
    width: 14px;
    height: 14px;
    border-radius: 999px;
    background: #0a1b2b;
  }
  .hd-hole-tl { top: 8px; left: 8px; }
  .hd-hole-tr { top: 8px; right: 8px; }
  .hd-hole-bl { bottom: 8px; left: 8px; }
  .hd-hole-br { bottom: 8px; right: 8px; }

  .hd-ticket h2 {
    font-family: "Anton", sans-serif;
    font-size: clamp(1.55rem, 2.3vw, 2.1rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-align: center;
    margin: 0;
  }

  .hd-ticket-rows {
    margin-top: 8px;
    border-top: 1.5px dashed rgba(13, 15, 14, 0.25);
  }

  .hd-ticket-rows div {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
    padding: 4px 0;
    border-bottom: 1px solid rgba(13, 15, 14, 0.1);
  }

  /* Tarjeta editorial a media altura izquierda (tipografía display + glassmorphism + stagger) */
  .hd-desc {
    position: absolute;
    left: clamp(18px, 3vw, 44px);
    top: 44%;
    transform: translateY(-50%) translateX(-16px);
    width: clamp(230px, 22vw, 300px);
    padding: 20px 22px;
    border-radius: 16px;
    background: rgba(9, 20, 34, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px);
    box-shadow: 0 24px 50px rgba(0, 0, 0, 0.45);
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms var(--ease-out), transform 520ms var(--ease-out);
  }

  .hd-stage.is-case .hd-desc {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
    pointer-events: auto;
  }

  .hd-desc-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .hd-desc-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    box-shadow: 0 0 10px currentColor;
  }

  .hd-desc-num {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: rgba(241, 245, 249, 0.85);
  }

  .hd-desc-title {
    margin-top: 12px;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 1.9vw, 1.7rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.025em;
    color: #ffffff;
  }

  .hd-desc-text {
    margin-top: 10px;
    font-size: 13.5px;
    line-height: 1.52;
    color: rgba(203, 213, 225, 0.92);
  }

  .hd-desc-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 16px;
    padding: 9px 15px;
    border-radius: 10px;
    background: #ffffff;
    color: #07131e;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: -0.01em;
    transition: transform 200ms var(--ease-out), background-color 200ms var(--ease-out);
  }

  .hd-desc-link:hover {
    transform: translateY(-2px);
    background: var(--mint);
  }

  /* Botones Anterior / Siguiente a los lados del portátil (lejos de WhatsApp abajo) */
  .hd-nav-case {
    position: absolute;
    top: 76%;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px 6px 6px;
    border-radius: 999px;
    background: rgba(9, 20, 34, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.14);
    backdrop-filter: blur(12px);
    color: #ffffff;
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 360ms var(--ease-out), transform 220ms var(--ease-out), background-color 200ms var(--ease-out);
  }

  .hd-stage.is-case .hd-nav-case {
    opacity: 1;
    pointer-events: auto;
  }

  .hd-prev {
    left: clamp(18px, 3vw, 44px);
  }

  .hd-next {
    right: clamp(18px, 3vw, 44px);
    top: 52%;
    flex-direction: row-reverse;
    padding: 6px 6px 6px 14px;
  }

  .hd-circle {
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: #ffffff;
    color: #07131e;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
    transition: transform 200ms var(--ease-out), background-color 200ms var(--ease-out);
  }

  .hd-nav-case:hover .hd-circle {
    transform: scale(1.06);
    background: var(--mint);
  }

  .hd-circle svg {
    width: 18px;
    height: 18px;
  }

  .hd-nav-label {
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  /* Indicador inferior de scroll */
  .hd-hint {
    position: absolute;
    left: 50%;
    bottom: clamp(18px, 3.2vh, 36px);
    transform: translateX(-50%);
    pointer-events: auto;
    transition: opacity 260ms var(--ease-out);
  }

  .hd-hint-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .hd-drip-line {
    position: relative;
    width: 1.5px;
    height: 22px;
    background: rgba(255, 255, 255, 0.35);
    overflow: hidden;
  }

  .hd-drip-bead {
    position: absolute;
    left: 0;
    top: -40%;
    width: 100%;
    height: 40%;
    background: #ffffff;
    animation: hd-drip 1.6s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }

  @keyframes hd-drip {
    to {
      top: 100%;
    }
  }

  /* Responsive móvil (<= 820px) */
  @media (max-width: 820px) {
    .hd-track {
      height: 160vh;
    }

    .hd-nav {
      top: 10px;
      left: 10px;
      right: 10px;
      width: calc(100% - 20px);
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
    }

    .hd-nav-left,
    .hd-nav-right {
      display: contents;
    }

    .hd-tag {
      height: 28px;
      padding: 0 10px;
      font-size: 11.5px;
    }

    .hd-center-logo {
      display: none;
    }

    .hd-wordmark {
      top: 84px;
      left: 10px;
      width: calc(100% - 20px);
      height: 58px;
    }

    .hd-script {
      top: 142px;
      left: 16px;
      font-size: 1.55rem;
    }

    .hd-badge {
      display: none;
    }

    .hd-hint {
      bottom: 94px;
      width: calc(100% - 32px);
      max-width: 320px;
      text-align: center;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(7, 19, 30, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.14);
      backdrop-filter: blur(8px);
    }

    .hd-drip-line {
      display: none;
    }

    .hd-hint-btn {
      font-size: 10px;
      letter-spacing: 0.1em;
    }

    /* Modo casos en móvil: ticket arriba, portátil al centro, descripción + flechas debajo */
    .hd-ticket {
      left: 50%;
      right: auto;
      top: 78px;
      width: min(88vw, 330px);
      padding: 10px 20px 8px;
      transform: translateX(-50%) translateY(-12px);
    }

    .hd-stage.is-case .hd-ticket {
      transform: translateX(-50%) translateY(0);
    }

    .hd-ticket h2 {
      font-size: 1.45rem;
    }

    .hd-ticket-rows div {
      font-size: 9.5px;
      padding: 2px 0;
    }

    .hd-desc {
      left: 50%;
      top: auto;
      bottom: 148px;
      width: min(92vw, 350px);
      padding: 12px 14px;
      text-align: center;
      transform: translateX(-50%) translateY(12px);
    }

    .hd-stage.is-case .hd-desc {
      transform: translateX(-50%) translateY(0);
    }

    .hd-desc-title {
      margin-top: 6px;
      font-size: 1.1rem;
    }

    .hd-desc-text {
      margin-top: 4px;
      font-size: 11.5px;
      line-height: 1.35;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .hd-desc-link {
      margin-top: 8px;
      padding: 6px 12px;
      font-size: 11.5px;
    }

    .hd-nav-case {
      top: auto;
      bottom: 94px;
      transform: none;
      gap: 6px;
      padding: 4px 10px 4px 4px;
    }

    .hd-next {
      top: auto;
      padding: 4px 4px 4px 10px;
    }

    .hd-circle {
      width: 32px;
      height: 32px;
    }

    .hd-nav-label {
      font-size: 11px;
      white-space: nowrap;
    }

    .hd-nav-label br {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hd-drip-bead {
      animation: none;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-laptop-dive]');
  if (track) {
    const stage = track.querySelector<HTMLElement>('[data-hd-stage]');
    const canvas = track.querySelector<HTMLCanvasElement>('[data-hd-canvas]');
    const ctx = canvas?.getContext('2d');
    const cutEl = track.querySelector<HTMLImageElement>('[data-hd-cut]');
    const wordmarkEl = track.querySelector<HTMLElement>('[data-hd-wordmark]');
    const scriptEl = track.querySelector<HTMLElement>('[data-hd-script]');
    const badgeEl = track.querySelector<HTMLElement>('[data-hd-badge]');
    const badgeHitEl = track.querySelector<HTMLElement>('[data-hd-badge-hit]');
    const hintEl = track.querySelector<HTMLElement>('[data-hd-hint]');
    const screenEl = track.querySelector<HTMLElement>('[data-hd-screen]');
    const flashEl = track.querySelector<HTMLElement>('[data-hd-flash]');
    const screenHitEl = track.querySelector<HTMLButtonElement>('[data-hd-screen-hit]');

    const ticketTitleEl = track.querySelector<HTMLElement>('[data-hd-ticket-title]');
    const ticketRowsEl = track.querySelector<HTMLElement>('[data-hd-ticket-rows]');
    const descKeyEl = track.querySelector<HTMLElement>('[data-hd-desc-key]');
    const descTextEl = track.querySelector<HTMLElement>('[data-hd-desc-text]');
    const descLinkEl = track.querySelector<HTMLAnchorElement>('[data-hd-desc-link]');
    const descCtaEl = track.querySelector<HTMLElement>('[data-hd-desc-cta]');
    const descNumEl = track.querySelector<HTMLElement>('[data-hd-desc-num]');
    const descDotEl = track.querySelector<HTMLElement>('[data-hd-desc-dot]');
    const staggerEls = Array.from(track.querySelectorAll<HTMLElement>('[data-hd-stagger]'));

    const prevBtn = track.querySelector<HTMLButtonElement>('[data-hd-prev]');
    const nextBtn = track.querySelector<HTMLButtonElement>('[data-hd-next]');
    const studioBtn = track.querySelector<HTMLButtonElement>('[data-hd-studio]');
    const centerLogoBtn = track.querySelector<HTMLButtonElement>('[data-hd-center-logo]');
    const diveBtn = track.querySelector<HTMLButtonElement>('[data-hd-dive]');
    const hintBtn = track.querySelector<HTMLButtonElement>('[data-hd-hint-btn]');

    const slides = Array.from(track.querySelectorAll<HTMLElement>('[data-hd-media]'));
    const cases = JSON.parse(track.dataset.cases || '[]');
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Constantes exactas de los 60 frames (1280x720) medidas en píxeles de f-59.webp
    const TOTAL_FRAMES = 60;
    const FRAME_W = 1280;
    const FRAME_H = 720;
    const FRAME_RATIO = FRAME_W / FRAME_H;
    const SCREEN_RECT = {
      left: 0.2895,
      top: 0.189,
      width: 0.421,
      height: 0.478,
    };

    // Precarga progresiva de los 60 frames WebP (f-00 y f-59 primero para respuesta instantánea)
    const frames: (HTMLImageElement | null)[] = new Array(TOTAL_FRAMES).fill(null);
    const loaded: boolean[] = new Array(TOTAL_FRAMES).fill(false);

    const loadFrame = (idx: number) => {
      const img = new Image();
      img.decoding = 'async';
      img.src = `/hero-dive/frames/f-${String(idx).padStart(2, '0')}.webp`;
      img.onload = () => {
        frames[idx] = img;
        loaded[idx] = true;
        if (idx === 0 || idx === currentDrawnFrame) {
          needsDraw = true;
        }
      };
    };

    // Prioridad: primero frame 0 y último frame 59, luego todos los intermedios
    loadFrame(0);
    loadFrame(TOTAL_FRAMES - 1);
    for (let i = 1; i < TOTAL_FRAMES - 1; i++) {
      loadFrame(i);
    }

    let cw = 1;
    let ch = 1;
    let dpr = 1;
    let currentIdx = 0;
    let smoothP = 0;
    let currentDrawnFrame = -1;
    let needsDraw = true;
    let isCaseActive = false;

    // Calcula el rectángulo exacto (drawX, drawY, drawW, drawH) en que se dibuja cada frame
    const getDrawRect = (p: number) => {
      const isMobile = cw <= 820;
      const viewRatio = cw / ch;

      // Rectángulo "cover" (llena toda la pantalla)
      let coverW: number, coverH: number, coverX: number, coverY: number;
      if (viewRatio > FRAME_RATIO) {
        coverW = cw;
        coverH = cw / FRAME_RATIO;
        coverX = 0;
        coverY = (ch - coverH) / 2;
      } else {
        coverH = ch;
        coverW = ch * FRAME_RATIO;
        coverX = (cw - coverW) / 2;
        coverY = 0;
      }

      if (!isMobile) {
        return { x: coverX, y: coverY, w: coverW, h: coverH };
      }

      // En móvil vertical: empezamos en cover (tu retrato grande) y al acercarnos al portátil
      // interpolamos suavemente hasta un encuadre donde el MacBook entero cabe dentro de la pantalla
      const mobileFitW = cw * 1.62;
      const mobileFitH = mobileFitW / FRAME_RATIO;
      const mobileFitX = (cw - mobileFitW) / 2;
      const mobileFitY = ch * 0.44 - mobileFitH * 0.46;

      const t = Math.min(1, Math.max(0, p / 0.64));
      const ease = t * t * (3 - 2 * t);
      return {
        x: coverX + (mobileFitX - coverX) * ease,
        y: coverY + (mobileFitY - coverY) * ease,
        w: coverW + (mobileFitW - coverW) * ease,
        h: coverH + (mobileFitH - coverH) * ease,
      };
    };

    const syncCanvasSize = () => {
      if (!canvas || !stage) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      cw = stage.clientWidth || window.innerWidth;
      ch = stage.clientHeight || window.innerHeight;
      canvas.width = Math.round(cw * dpr);
      canvas.height = Math.round(ch * dpr);
      needsDraw = true;
    };

    const getNearestLoadedFrame = (target: number): HTMLImageElement | null => {
      if (loaded[target] && frames[target]) return frames[target];
      for (let d = 1; d < TOTAL_FRAMES; d++) {
        if (target - d >= 0 && loaded[target - d] && frames[target - d]) return frames[target - d];
        if (target + d < TOTAL_FRAMES && loaded[target + d] && frames[target + d]) return frames[target + d];
      }
      return null;
    };

    const renderScene = (p: number) => {
      if (!ctx || !stage) return;

      // 0..0.64 controla los 60 frames (menos scroll para aterrizar); 0.64..1.00 mantiene el portátil listo
      const animP = Math.min(1, Math.max(0, p / 0.64));
      const frameIdx = rm
        ? p > 0.35
          ? TOTAL_FRAMES - 1
          : 0
        : Math.min(TOTAL_FRAMES - 1, Math.max(0, Math.round(animP * (TOTAL_FRAMES - 1))));

      const rect = getDrawRect(p);

      // Dibujar frame en canvas
      const img = getNearestLoadedFrame(frameIdx);
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.fillStyle = '#07131e';
      ctx.fillRect(0, 0, cw, ch);
      if (img) {
        ctx.drawImage(img, rect.x, rect.y, rect.w, rect.h);
        currentDrawnFrame = frameIdx;
      }
      ctx.restore();

      // Sincronizar cut.webp AL PÍXEL con frame 0 para que PAPIS.APP pase por detrás de tu cabeza
      const heroFade = Math.max(0, 1 - p / 0.14);
      if (cutEl) {
        cutEl.style.left = `${rect.x}px`;
        cutEl.style.top = `${rect.y}px`;
        cutEl.style.width = `${rect.w}px`;
        cutEl.style.height = `${rect.h}px`;
        cutEl.style.opacity = String(p < 0.02 ? 1 : heroFade);
      }

      if (wordmarkEl) {
        wordmarkEl.style.opacity = String(heroFade);
        wordmarkEl.style.transform = `translateY(${(1 - heroFade) * -32}px)`;
      }
      if (scriptEl) {
        scriptEl.style.opacity = String(heroFade);
      }
      if (badgeEl) {
        badgeEl.style.opacity = String(heroFade);
        badgeEl.style.transform = `translateY(${(1 - heroFade) * -90}px)`;
      }
      if (hintEl) {
        hintEl.style.opacity = String(Math.max(0, 1 - p / 0.1));
        hintEl.style.pointerEvents = p < 0.08 ? 'auto' : 'none';
      }

      // Posicionar la pantalla de proyectos AL PÍXEL dentro del bisel del portátil
      if (screenEl) {
        screenEl.style.left = `${rect.x + rect.w * SCREEN_RECT.left}px`;
        screenEl.style.top = `${rect.y + rect.h * SCREEN_RECT.top}px`;
        screenEl.style.width = `${rect.w * SCREEN_RECT.width}px`;
        screenEl.style.height = `${rect.h * SCREEN_RECT.height}px`;
      }

      // Activar modo casos exactamente cuando el portátil ha aterrizado (p >= 0.62)
      const shouldBeCase = p >= 0.62;
      if (shouldBeCase !== isCaseActive) {
        isCaseActive = shouldBeCase;
        stage.classList.toggle('is-case', isCaseActive);
        if (isCaseActive) animateTextStagger();
      }
    };

    const getScrollProgress = () => {
      const rect = track.getBoundingClientRect();
      const maxScroll = Math.max(1, track.offsetHeight - window.innerHeight);
      return Math.min(1, Math.max(0, -rect.top / maxScroll));
    };

    // Bucle de render suavizado 60fps (solo dibuja cuando cambia el progreso o llega un frame)
    const tick = () => {
      const targetP = getScrollProgress();
      const diff = targetP - smoothP;
      if (Math.abs(diff) > 0.0004) {
        smoothP = rm ? targetP : smoothP + diff * 0.18;
        needsDraw = true;
      } else if (smoothP !== targetP) {
        smoothP = targetP;
        needsDraw = true;
      }

      if (needsDraw) {
        needsDraw = false;
        renderScene(smoothP);
      }
      requestAnimationFrame(tick);
    };

    const animateTextStagger = () => {
      if (rm) return;
      staggerEls.forEach((el, i) => {
        el.animate(
          [
            { opacity: 0, transform: 'translateY(14px)', filter: 'blur(6px)' },
            { opacity: 1, transform: 'translateY(0)', filter: 'blur(0px)' },
          ],
          {
            duration: 460,
            delay: i * 65,
            easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
            fill: 'both',
          }
        );
      });
    };

    const fillCase = (idx: number, animate = true) => {
      const item = cases[idx];
      if (!item) return;
      currentIdx = idx;
      if (ticketTitleEl) ticketTitleEl.textContent = item.ticketTitle;
      if (ticketRowsEl) {
        ticketRowsEl.innerHTML = item.rows.map((r: string) => `<div>${r}</div>`).join('');
      }
      if (descKeyEl) descKeyEl.textContent = item.descKey;
      if (descTextEl) descTextEl.textContent = item.descText;
      if (descLinkEl) descLinkEl.href = item.href;
      if (descCtaEl) descCtaEl.textContent = item.ctaLabel;
      if (descNumEl) descNumEl.textContent = `0${idx + 1} / 0${cases.length}`;
      if (descDotEl) descDotEl.style.background = item.accent;

      slides.forEach((s, i) => {
        s.style.opacity = i === idx ? '1' : '0';
        s.style.transform = i === idx ? 'scale(1)' : 'scale(1.02)';
      });

      if (animate) animateTextStagger();

      if (!rm && flashEl) {
        flashEl.animate([{ opacity: 0 }, { opacity: 0.32 }, { opacity: 0 }], {
          duration: 320,
          easing: 'ease-out',
        });
      }
    };

    const scrollToCase = () => {
      const maxScroll = Math.max(0, track.offsetHeight - window.innerHeight);
      window.scrollTo({ top: Math.round(maxScroll * 0.85), behavior: rm ? 'auto' : 'smooth' });
    };

    const scrollToHero = () => {
      window.scrollTo({ top: 0, behavior: rm ? 'auto' : 'smooth' });
    };

    prevBtn?.addEventListener('click', () => {
      fillCase((currentIdx - 1 + cases.length) % cases.length);
    });
    nextBtn?.addEventListener('click', () => {
      fillCase((currentIdx + 1) % cases.length);
    });
    screenHitEl?.addEventListener('click', () => {
      fillCase((currentIdx + 1) % cases.length);
    });
    diveBtn?.addEventListener('click', scrollToCase);
    hintBtn?.addEventListener('click', scrollToCase);
    studioBtn?.addEventListener('click', scrollToHero);
    centerLogoBtn?.addEventListener('click', scrollToHero);

    // Péndulo sutil al pasar el ratón por el lanyard en desktop
    badgeHitEl?.addEventListener('pointerenter', () => {
      if (rm || !badgeEl || smoothP > 0.05) return;
      badgeEl.animate(
        [
          { transform: 'rotate(0deg)' },
          { transform: 'rotate(-5deg)' },
          { transform: 'rotate(3.5deg)' },
          { transform: 'rotate(-1.5deg)' },
          { transform: 'rotate(0deg)' },
        ],
        { duration: 1200, easing: 'ease-out', composite: 'add' }
      );
    });

    window.addEventListener('resize', syncCanvasSize, { passive: true });
    syncCanvasSize();
    fillCase(0, false);
    renderScene(getScrollProgress());
    requestAnimationFrame(tick);
  }
</script>

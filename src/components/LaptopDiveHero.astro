---
import type { Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'es' } = Astro.props;
const isEn = lang === 'en';

interface DiveCase {
  id: string;
  tag: string;
  ticketTitle: string;
  rows: [string, string, string];
  title: string;
  subtitle: string;
  image: string;
  href: string;
  ctaLabel: string;
  accent: string;
  accentGlow: string;
}

const CASES: DiveCase[] = isEn
  ? [
      {
        id: 'web',
        tag: '01 / 03 · WEB DESIGN & SEO/GEO',
        ticketTitle: 'WEB & SEO/GEO',
        rows: ['YOUR WEBSITE IN RECORD TIME', 'ASTRO + KEYSTATIC', 'AAAR · SERINAMAR'],
        title: 'Custom websites that rank on Google & AI',
        subtitle:
          'Ultra-fast static HTML (< 0.8s), self-editable CMS and local SEO + GEO in Marbella. Real clients: AAAR Marbella (social impact), Grupo Serinamar & Cerrajería Carlos Neira.',
        image: '/hero-dive/case-web.webp',
        href: '/en/web-design',
        ctaLabel: 'Explore Web Design',
        accent: '#3B82F6',
        accentGlow: 'rgba(59, 130, 246, 0.55)',
      },
      {
        id: 'software',
        tag: '02 / 03 · CUSTOM SOFTWARE',
        ticketTitle: 'CUSTOM SOFTWARE',
        rows: ['ANY INDUSTRY', 'REAL ESTATE · ACADEMIES', '100% OWNED BY YOU'],
        title: 'Bespoke software for any business',
        subtitle:
          'Real estate agencies, academies or any sector: we study your exact workflow and build the right tool for your business—100% owned by you with €0 per-user fees.',
        image: '/hero-dive/case-software.webp',
        href: '/en/custom-software',
        ctaLabel: 'Explore Custom Software',
        accent: '#10B981',
        accentGlow: 'rgba(16, 185, 129, 0.55)',
      },
      {
        id: 'tecnico',
        tag: '03 / 03 · HOME IT SUPPORT',
        ticketTitle: 'TECH SUPPORT',
        rows: ['20 YEARS EXPERIENCE', 'ANY AGE OR SKILL LEVEL', 'CABOPINO TO ESTEPONA'],
        title: '20 years of home IT support & lessons',
        subtitle:
          'Home visits from Cabopino to Estepona for any age or difficulty: Mac, Windows, iPhone, online safety and private lessons at your pace. Plus worldwide remote support via RustDesk.',
        image: '/assets/optimized/servicio-tecnico-marbella.webp',
        href: '/en/tech-support',
        ctaLabel: 'Explore Tech Support',
        accent: '#F97316',
        accentGlow: 'rgba(249, 115, 22, 0.55)',
      },
    ]
  : [
      {
        id: 'web',
        tag: '01 / 03 · DISEÑO WEB & SEO/GEO',
        ticketTitle: 'WEB & SEO/GEO',
        rows: ['TU PÁGINA WEB EN TIEMPO RÉCORD', 'ASTRO + KEYSTATIC', 'AAAR · SERINAMAR'],
        title: 'Webs a medida que posicionan en Google e IA',
        subtitle:
          'HTML estático ultrarrápido (< 0,8s), panel editable y SEO local + GEO en Marbella. Casos reales: AAAR Marbella (compromiso social), Grupo Serinamar o Cerrajería Carlos Neira.',
        image: '/hero-dive/case-web.webp',
        href: '/paginas-web',
        ctaLabel: 'Explorar Diseño Web',
        accent: '#3B82F6',
        accentGlow: 'rgba(59, 130, 246, 0.55)',
      },
      {
        id: 'software',
        tag: '02 / 03 · SOFTWARE A MEDIDA',
        ticketTitle: 'SOFTWARE A MEDIDA',
        rows: ['CUALQUIER SECTOR', 'INMOBILIARIAS · ACADEMIAS', '100% EN PROPIEDAD'],
        title: 'Software a medida para cualquier negocio',
        subtitle:
          'Inmobiliarias, academias o cualquier sector: estudiamos tus necesidades reales y diseñamos la herramienta exacta aplicada a tu negocio, 100% en propiedad y sin cuotas por usuario.',
        image: '/hero-dive/case-software.webp',
        href: '/software-empresas',
        ctaLabel: 'Explorar Software Empresas',
        accent: '#10B981',
        accentGlow: 'rgba(16, 185, 129, 0.55)',
      },
      {
        id: 'tecnico',
        tag: '03 / 03 · SERVICIO TÉCNICO',
        ticketTitle: 'TÉCNICO EN CASA',
        rows: ['20 AÑOS DE EXPERIENCIA', 'CUALQUIER EDAD O NIVEL', 'CABOPINO A ESTEPONA'],
        title: '20 años de soporte técnico y clases en casa',
        subtitle:
          'Asistencia a domicilio desde Cabopino hasta Estepona para cualquier edad o dificultad: Mac, Windows, móvil, seguridad y clases particulares a tu ritmo. También remoto mundial vía RustDesk.',
        image: '/assets/optimized/servicio-tecnico-marbella.webp',
        href: '/servicio-tecnico',
        ctaLabel: 'Explorar Servicio Técnico',
        accent: '#F97316',
        accentGlow: 'rgba(249, 115, 22, 0.55)',
      },
    ];
---

<section
  id="inicio"
  data-laptop-dive
  data-cases={JSON.stringify(CASES)}
  aria-label="Presentación interactiva de papis.app"
  class="hd-track relative w-full select-none"
>
  <!-- H1 semántico para SEO, GEO y lectores de pantalla -->
  <h1 class="sr-only">
    papis.app — Diseño web ultrarrápido con SEO y GEO, software a medida y servicio técnico en Marbella
  </h1>

  <!-- Escenario Sticky 100dvh controlado 1:1 por el scroll nativo -->
  <div
    data-hd-stage
    class="hd-stage"
    style={`--case-accent: ${CASES[0].accent}; --case-glow: ${CASES[0].accentGlow};`}
  >
    <!-- Canvas HD de secuencia de 60 frames (00..59) -->
    <canvas data-hd-canvas class="hd-canvas" aria-hidden="true"></canvas>

    <!-- Sutil viñeta superior/inferior -->
    <div aria-hidden="true" class="hd-vignette"></div>

    <!-- Capa 2: Wordmark gigante PAPIS.APP (detrás de cut.webp) -->
    <svg
      data-hd-wordmark
      class="hd-wordmark"
      viewBox="0 0 1440 260"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="papisWordmarkGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
          <stop offset="52%" stop-color="#f1f5f3" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#d7e6de" stop-opacity="0.22" />
        </linearGradient>
      </defs>
      <text
        x="18"
        y="214"
        textLength="1404"
        lengthAdjust="spacingAndGlyphs"
        fill="url(#papisWordmarkGrad)"
      >
        PAPIS.APP
      </text>
    </svg>

    <!-- Capa 3: Recorte transparente de David Papis (pixel-aligned 1280x720 con f-00.webp) -->
    <img
      data-hd-cut
      src="/hero-dive/cut.webp"
      alt=""
      width="1280"
      height="720"
      loading="eager"
      decoding="async"
      aria-hidden="true"
      class="hd-cut"
    />

    <!-- Capa 4: Firma manuscrita Caveat Brush -->
    <p data-hd-script class="hd-script" aria-hidden="true">
      web · software · ia
    </p>

    <!-- Capa 5: Lanyard ID Badge colgante (solo desktop) -->
    <div data-hd-badge class="hd-badge" aria-hidden="true">
      <svg class="hd-lanyard-strap" viewBox="0 0 260 220" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M114 0H146L141 148H119L114 0Z" fill="#E8ECEA" />
        <path d="M127 0H133V148H127V0Z" fill="#CBD5D0" opacity="0.55" />
        <rect x="115" y="144" width="30" height="16" rx="4" fill="#94A3B8" />
        <path
          d="M122 160H138L135 186C135 190 132.5 193 130 193C127.5 193 125 190 125 186L122 160Z"
          fill="#CBD5E1"
          stroke="#475569"
          stroke-width="2"
        />
        <rect x="108" y="190" width="44" height="14" rx="4" fill="#E2E8F0" stroke="#64748B" stroke-width="1.5" />
      </svg>

      <div class="hd-badge-sleeve" data-hd-badge-hit>
        <div class="hd-badge-card">
          <div class="flex items-start justify-between">
            <h4>TECH<br />STUDIO</h4>
            <span class="hd-badge-yr">2026</span>
          </div>
          <p class="hd-badge-role">FOUNDER // MARBELLA</p>

          <div class="hd-badge-photo">
            <img
              src="/hero-dive/papis-badge-face.webp"
              alt="David Papis"
              width="92"
              height="112"
              loading="eager"
              decoding="async"
            />
          </div>

          <div class="hd-badge-rows">
            <div class="hd-badge-row"><span>NAME</span><b>DAVID PAPIS</b></div>
            <div class="hd-badge-row"><span>FOCUS</span><b>WEB · ERP · IA</b></div>
            <div class="hd-badge-row"><span>TEL</span><b>+34 652 918 061</b></div>
            <div class="hd-badge-row"><span>WEB</span><b>PAPIS.APP</b></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Capa 6: Pantalla completa del MacBook (esquinas redondeadas + foto difuminada + textos animados dentro) -->
    <div data-hd-screen class="hd-screen">
      <!-- Imágenes de ambiente a sangre completa difuminadas -->
      {
        CASES.map((item, idx) => (
          <div
            data-hd-media={idx}
            class="hd-screen-bg"
            style={`opacity: ${idx === 0 ? 1 : 0};`}
          >
            <img
              src={item.image}
              alt=""
              aria-hidden="true"
              loading={idx === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="hd-screen-img"
            />
          </div>
        ))
      }

      <!-- Velo cinematográfico con reflejo del color del servicio activo -->
      <div aria-hidden="true" class="hd-screen-scrim"></div>

      <!-- Contenido editorial del servicio DENTRO de la pantalla del portátil -->
      <div class="hd-screen-content" aria-live="polite">
        <div data-hd-stagger="0" class="hd-service-pill">
          <span class="hd-service-dot" aria-hidden="true"></span>
          <span data-hd-tag>{CASES[0].tag}</span>
        </div>

        <h2 data-hd-title data-hd-stagger="1" class="hd-service-title">
          {CASES[0].title}
        </h2>

        <p data-hd-subtitle data-hd-stagger="2" class="hd-service-subtitle">
          {CASES[0].subtitle}
        </p>

        <div data-hd-stagger="3" class="hd-service-actions">
          <a data-hd-cta-link href={CASES[0].href} class="hd-service-cta">
            <span data-hd-cta-label>{CASES[0].ctaLabel}</span>
            <span aria-hidden="true">→</span>
          </a>
          <div class="hd-dots" role="tablist" aria-label="Elegir servicio">
            {
              CASES.map((c, idx) => (
                <button
                  type="button"
                  data-hd-dot={idx}
                  aria-label={`Ver ${c.ticketTitle}`}
                  aria-selected={idx === 0 ? 'true' : 'false'}
                  class={`hd-dot-btn ${idx === 0 ? 'is-active' : ''}`}
                />
              ))
            }
          </div>
        </div>
      </div>

      <div aria-hidden="true" class="hd-screen-sheen"></div>
      <div data-hd-flash aria-hidden="true" class="hd-screen-flash"></div>
    </div>

    <!-- Chevrons futuristas luminosos posicionados simétricamente a izquierda y derecha del MacBook -->
    <button
      type="button"
      data-hd-prev
      class="hd-chev hd-chev-left"
      aria-label="Servicio anterior"
    >
      <svg viewBox="0 0 64 56" fill="none" aria-hidden="true">
        <path class="chev-3" d="M24 8L8 28L24 48" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
        <path class="chev-2" d="M40 8L24 28L40 48" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
        <path class="chev-1" d="M56 8L40 28L56 48" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <button
      type="button"
      data-hd-next
      class="hd-chev hd-chev-right"
      aria-label="Siguiente servicio"
    >
      <svg viewBox="0 0 64 56" fill="none" aria-hidden="true">
        <path class="chev-1" d="M8 8L24 28L8 48" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
        <path class="chev-2" d="M24 8L40 28L24 48" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
        <path class="chev-3" d="M40 8L56 28L40 48" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    <!-- Capa UI fijada al viewport sticky -->
    <div class="hd-ui">
      <!-- Barra superior: Desktop sticker tags + selector ES/EN + botón menú futurista en móvil -->
      <nav aria-label={isEn ? 'Main studio navigation' : 'Navegación principal del estudio'} class="hd-nav">
        <div class="hd-nav-left">
          <button type="button" data-hd-studio class="hd-tag">{isEn ? 'my studio' : 'mi estudio'}</button>
          <a href={isEn ? '/en/web-design' : '/paginas-web'} class="hd-tag hd-tag-web">web</a>
          <a href={isEn ? '/en/custom-software' : '/software-empresas'} class="hd-tag hd-tag-software">software</a>
          <a href={isEn ? '/en/tech-support' : '/servicio-tecnico'} class="hd-tag hd-tag-tecnico">{isEn ? 'tech support' : 'técnico'}</a>
        </div>

        <button
          type="button"
          data-hd-center-logo
          class="hd-center-logo"
          aria-label={isEn ? 'Back to top of papis.app studio' : 'Volver al principio del estudio papis.app'}
        >
          <svg
            viewBox="0 0 100 108"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            class="hd-center-logo-icon"
            aria-hidden="true"
          >
            <path
              d="M12 6H54A38.5 38.5 0 0 1 54 83H48V72.5H54A28 28 0 0 0 54 16.5H22.5V55.5L12 60.8V6Z"
              fill="var(--case-accent)"
              style="transition: fill 260ms var(--ease-out);"
            />
            <path
              d="M31.5 21.5L68 40V49.5L22.5 72.5V92.5H31.5V72.5H42V103H12V67.3L56.5 44.75L31.5 32.1V21.5Z"
              fill="#F8FAFC"
            />
          </svg>
          <span class="hd-center-logo-word">
            <span>papis.</span><span style="color: var(--case-accent); transition: color 260ms var(--ease-out);">app</span>
          </span>
        </button>

        <div class="hd-nav-right">
          <a href={isEn ? '/' : '/en'} class="hd-tag hd-tag-lang" aria-label={isEn ? 'Cambiar a español' : 'Switch to English'}>
            {isEn ? 'ES' : 'EN'}
          </a>
          <a href="#pilares" class="hd-tag">{isEn ? 'projects' : 'proyectos'}</a>
          <a href={isEn ? '/en/contact' : '/contacto'} class="hd-tag hd-tag-accent">{isEn ? 'quote' : 'presupuesto'}</a>
        </div>

        <!-- Barra móvil limpia (solo visible en <= 820px) -->
        <div class="hd-mobile-bar">
          <button type="button" data-hd-studio-m class="hd-mobile-brand">PAPIS.APP</button>
          <div class="flex items-center gap-2">
            <a href={isEn ? '/' : '/en'} class="hd-mobile-lang-btn" aria-label={isEn ? 'Cambiar a español' : 'Switch to English'}>
              {isEn ? 'ES' : 'EN'}
            </a>
            <button
              type="button"
              data-hd-menu-open
              aria-label={isEn ? 'Open menu' : 'Abrir menú'}
              aria-expanded="false"
              class="hd-mobile-menu-btn"
            >
              <span>{isEn ? 'MENU' : 'MENÚ'}</span>
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true">
                <line x1="4" y1="7" x2="20" y2="7" />
                <line x1="4" y1="12" x2="20" y2="12" />
                <line x1="4" y1="17" x2="20" y2="17" />
              </svg>
            </button>
          </div>
        </div>
      </nav>

      <!-- Menú móvil futurista centrado (MAYÚSCULAS + chevrons luminosos por color de sección) -->
      <div data-hd-mobile-overlay hidden class="hd-mobile-overlay">
        <button type="button" data-hd-menu-close aria-label={isEn ? 'Close menu' : 'Cerrar menú'} class="hd-mobile-close">
          ✕
        </button>
        <div class="hd-mobile-links">
          <button type="button" data-hd-m-studio class="hd-m-link" style="--m-accent:#38BDF8; --m-glow:rgba(56,189,248,0.65);">
            <svg class="hd-m-chev" viewBox="0 0 36 24" fill="none" aria-hidden="true"><path class="mc1" d="M4 4L12 12L4 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc2" d="M14 4L22 12L14 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc3" d="M24 4L32 12L24 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{isEn ? 'MY STUDIO' : 'MI ESTUDIO'}</span>
          </button>
          <a href={isEn ? '/en/web-design' : '/paginas-web'} class="hd-m-link" style="--m-accent:#3B82F6; --m-glow:rgba(59,130,246,0.65);">
            <svg class="hd-m-chev" viewBox="0 0 36 24" fill="none" aria-hidden="true"><path class="mc1" d="M4 4L12 12L4 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc2" d="M14 4L22 12L14 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc3" d="M24 4L32 12L24 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{isEn ? 'WEB DESIGN' : 'DISEÑO WEB'}</span>
          </a>
          <a href={isEn ? '/en/custom-software' : '/software-empresas'} class="hd-m-link" style="--m-accent:#10B981; --m-glow:rgba(16,185,129,0.65);">
            <svg class="hd-m-chev" viewBox="0 0 36 24" fill="none" aria-hidden="true"><path class="mc1" d="M4 4L12 12L4 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc2" d="M14 4L22 12L14 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc3" d="M24 4L32 12L24 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{isEn ? 'CUSTOM SOFTWARE' : 'SOFTWARE EMPRESAS'}</span>
          </a>
          <a href={isEn ? '/en/tech-support' : '/servicio-tecnico'} class="hd-m-link" style="--m-accent:#F97316; --m-glow:rgba(249,115,22,0.65);">
            <svg class="hd-m-chev" viewBox="0 0 36 24" fill="none" aria-hidden="true"><path class="mc1" d="M4 4L12 12L4 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc2" d="M14 4L22 12L14 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc3" d="M24 4L32 12L24 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{isEn ? 'TECH SUPPORT' : 'SERVICIO TÉCNICO'}</span>
          </a>
          <a href={isEn ? '/en/projects' : '/proyectos'} class="hd-m-link" style="--m-accent:#A855F7; --m-glow:rgba(168,85,247,0.65);">
            <svg class="hd-m-chev" viewBox="0 0 36 24" fill="none" aria-hidden="true"><path class="mc1" d="M4 4L12 12L4 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc2" d="M14 4L22 12L14 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc3" d="M24 4L32 12L24 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{isEn ? 'PROJECTS' : 'PROYECTOS'}</span>
          </a>
          <a href={isEn ? '/en/contact' : '/contacto'} class="hd-m-link" style="--m-accent:#22D3EE; --m-glow:rgba(34,211,238,0.65);">
            <svg class="hd-m-chev" viewBox="0 0 36 24" fill="none" aria-hidden="true"><path class="mc1" d="M4 4L12 12L4 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc2" d="M14 4L22 12L14 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/><path class="mc3" d="M24 4L32 12L24 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>{isEn ? 'GET A QUOTE' : 'PRESUPUESTO'}</span>
          </a>
        </div>
      </div>

      <!-- Matrícula metálica con 4 tornillos que se atornillan al impactar -->
      <article data-hd-ticket class="hd-ticket" aria-live="polite">
        <span data-hd-screw class="hd-screw hd-hole-tl" aria-hidden="true"></span>
        <span data-hd-screw class="hd-screw hd-hole-tr" aria-hidden="true"></span>
        <span data-hd-screw class="hd-screw hd-hole-bl" aria-hidden="true"></span>
        <span data-hd-screw class="hd-screw hd-hole-br" aria-hidden="true"></span>
        <h2 data-hd-ticket-title>{CASES[0].ticketTitle}</h2>
        <div class="hd-ticket-rows" data-hd-ticket-rows>
          {CASES[0].rows.map((r) => <div>{r}</div>)}
        </div>
      </article>

      <!-- Indicador inferior de scroll -->
      <div data-hd-hint class="hd-hint">
        <button type="button" data-hd-hint-btn class="hd-hint-btn">
          <span class="hd-drip-line" aria-hidden="true">
            <span class="hd-drip-bead"></span>
          </span>
          <span>{isEn ? 'scroll down to enter the laptop' : 'desliza para entrar en el portátil'}</span>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  .hd-track {
    --ink: #0d0f0e;
    --mint: #cfeee0;
    --green-800: #11402c;
    height: 360vh;
    background: #07131e;
    font-family: "Inter Tight", var(--font-sans);
  }

  .hd-stage {
    position: sticky;
    top: 0;
    height: 100dvh;
    width: 100%;
    overflow: hidden;
    background: linear-gradient(180deg, #07131e 0%, #0e2234 100%);
    color: #ffffff;
  }

  .hd-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 1;
  }

  .hd-vignette {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      180deg,
      rgba(7, 19, 30, 0.34) 0%,
      rgba(7, 19, 30, 0) 35%,
      rgba(5, 8, 14, 0.5) 100%
    );
  }

  .hd-wordmark {
    position: absolute;
    left: 2vw;
    top: clamp(58px, 7vh, 88px);
    width: 96vw;
    height: clamp(110px, 24vw, 270px);
    z-index: 3;
    pointer-events: none;
    overflow: visible;
    will-change: transform, opacity;
  }

  .hd-wordmark text {
    font-family: "Inter Tight", sans-serif;
    font-weight: 900;
    font-size: 262px;
    letter-spacing: -6px;
  }

  .hd-cut {
    position: absolute;
    z-index: 4;
    pointer-events: none;
    max-width: none;
    will-change: opacity;
  }

  .hd-script {
    position: absolute;
    left: clamp(20px, 6vw, 96px);
    top: clamp(128px, 21vw, 248px);
    z-index: 6;
    font-family: "Caveat Brush", cursive;
    font-size: clamp(2.1rem, 5.4vw, 4.9rem);
    line-height: 1;
    color: #ffffff;
    letter-spacing: -0.5px;
    transform: rotate(-8deg);
    transform-origin: 0 50%;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    pointer-events: none;
    will-change: transform, opacity;
  }

  /* Lanyard ID Badge */
  .hd-badge {
    position: absolute;
    right: clamp(14px, 5vw, 84px);
    top: -12px;
    width: clamp(148px, 16vw, 224px);
    z-index: 7;
    transform-origin: 50% 0;
    pointer-events: none;
    will-change: transform, opacity;
  }

  .hd-lanyard-strap {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: -10px;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.35));
  }

  .hd-badge-sleeve {
    pointer-events: auto;
    cursor: grab;
    border-radius: 14px;
    padding: 8px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08));
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.48);
    backdrop-filter: blur(8px);
  }

  .hd-badge-card {
    background: #f8faf9;
    color: #141615;
    border-radius: 8px;
    padding: 12px 11px 11px;
  }

  .hd-badge-card h4 {
    font-size: clamp(1rem, 1.55vw, 1.38rem);
    line-height: 0.94;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .hd-badge-yr {
    font-size: 10px;
    font-weight: 700;
    color: #334155;
  }

  .hd-badge-role {
    margin-top: 7px;
    padding-top: 4px;
    border-top: 1px solid #1e293b;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .hd-badge-photo {
    width: 68px;
    height: 82px;
    margin: 9px auto;
    border-radius: 6px;
    overflow: hidden;
    background: #dfe4e1;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .hd-badge-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .hd-badge-rows {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hd-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    font-size: 8px;
    font-weight: 700;
    padding: 4px 0 2px;
    border-bottom: 1.5px dotted #334155;
  }

  .hd-badge-row b {
    font-weight: 600;
    color: #0f172a;
  }

  /* ============================================================================
     PANTALLA COMPLETA DEL MACBOOK (esquinas redondeadas + blur ambiente + texto)
     ============================================================================ */
  .hd-screen {
    position: absolute;
    z-index: 12;
    border-radius: 13px 13px 4px 4px;
    background: #06090f;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    transition: opacity 320ms var(--ease-out);
  }

  .hd-stage.is-case .hd-screen {
    opacity: 1;
    pointer-events: auto;
  }

  .hd-screen-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 520ms var(--ease-out);
  }

  .hd-screen-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transform: scale(1.04);
    filter: blur(2.5px) brightness(0.52) saturate(1.12);
  }

  .hd-screen-scrim {
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      radial-gradient(85% 80% at 50% 0%, color-mix(in srgb, var(--case-accent) 24%, transparent) 0%, transparent 65%),
      linear-gradient(180deg, rgba(6, 11, 20, 0.28) 0%, rgba(6, 11, 20, 0.68) 100%);
    transition: background 420ms var(--ease-out);
  }

  .hd-screen-content {
    position: relative;
    z-index: 4;
    height: 100%;
    width: 100%;
    padding: clamp(16px, 3.2vw, 38px) clamp(18px, 3.6vw, 44px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .hd-service-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 13px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.09);
    border: 1px solid color-mix(in srgb, var(--case-accent) 55%, rgba(255, 255, 255, 0.2));
    backdrop-filter: blur(8px);
    font-family: var(--font-mono);
    font-size: clamp(9px, 0.95vw, 11.5px);
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #f8fafc;
  }

  .hd-service-dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--case-accent);
    box-shadow: 0 0 12px var(--case-accent);
  }

  .hd-service-title {
    margin-top: clamp(10px, 1.8vw, 18px);
    max-width: 19ch;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.75vw, 2.55rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: #ffffff;
    text-wrap: balance;
    text-shadow: 0 6px 26px rgba(0, 0, 0, 0.45);
  }

  .hd-service-subtitle {
    margin-top: clamp(8px, 1.2vw, 14px);
    max-width: 46ch;
    min-height: 3.1em;
    font-size: clamp(0.74rem, 1.05vw, 0.98rem);
    line-height: 1.5;
    color: rgba(241, 245, 249, 0.95);
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.55);
  }

  .hd-service-subtitle.is-typing::after {
    content: "";
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 3px;
    vertical-align: -0.14em;
    background: var(--case-accent);
    box-shadow: 0 0 8px var(--case-glow);
    animation: hd-caret 0.75s steps(1) infinite;
  }

  @keyframes hd-caret {
    50% {
      opacity: 0;
    }
  }

  .hd-service-actions {
    margin-top: clamp(12px, 2vw, 22px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .hd-service-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: clamp(7px, 0.9vw, 11px) clamp(14px, 1.8vw, 22px);
    border-radius: 999px;
    background: var(--case-accent);
    color: #ffffff;
    font-size: clamp(0.74rem, 1vw, 0.92rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    box-shadow: 0 10px 28px -4px var(--case-glow), inset 0 1px 0 rgba(255, 255, 255, 0.3);
    transition: transform 200ms var(--ease-out), filter 200ms var(--ease-out);
  }

  .hd-service-cta:hover {
    transform: translateY(-2px);
    filter: brightness(1.1);
  }

  .hd-dots {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .hd-dot-btn {
    width: 22px;
    height: 4px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.25);
    cursor: pointer;
    transition: width 260ms var(--ease-out), background-color 260ms var(--ease-out);
  }

  .hd-dot-btn.is-active {
    width: 38px;
    background: var(--case-accent);
    box-shadow: 0 0 12px var(--case-glow);
  }

  .hd-screen-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(118deg, rgba(255, 255, 255, 0.08) 0%, rgba(255, 255, 255, 0) 38%);
    pointer-events: none;
    z-index: 5;
  }

  .hd-screen-flash {
    position: absolute;
    inset: 0;
    background: #ffffff;
    opacity: 0;
    pointer-events: none;
    z-index: 6;
  }

  /* ============================================================================
     CHEVRONS FUTURISTAS LUMINOSOS A AMBOS LADOS DEL PORTÁTIL (<<< / >>>)
     ============================================================================ */
  .hd-chev {
    position: absolute;
    z-index: 22;
    width: clamp(54px, 5.2vw, 76px);
    height: clamp(54px, 5.2vw, 76px);
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--case-accent);
    cursor: pointer;
    opacity: 0;
    pointer-events: none;
    transition: opacity 360ms var(--ease-out), transform 220ms var(--ease-out), color 300ms var(--ease-out);
  }

  .hd-stage.is-case .hd-chev {
    opacity: 1;
    pointer-events: auto;
  }

  .hd-chev svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .hd-chev:hover {
    transform: translateY(-50%) scale(1.12);
  }

  .hd-chev:active {
    transform: translateY(-50%) scale(0.95);
  }

  .hd-chev path {
    opacity: 0.22;
    filter: drop-shadow(0 0 6px var(--case-glow));
    animation: hd-chev-pulse 1.5s ease-in-out infinite;
  }

  /* Onda luminosa de DENTRO hacia FUERA en ambos lados */
  .hd-chev .chev-1 {
    animation-delay: 0s;
  }
  .hd-chev .chev-2 {
    animation-delay: 0.22s;
  }
  .hd-chev .chev-3 {
    animation-delay: 0.44s;
  }

  @keyframes hd-chev-pulse {
    0%,
    100% {
      opacity: 0.22;
      filter: drop-shadow(0 0 4px transparent);
    }
    45% {
      opacity: 1;
      filter: drop-shadow(0 0 14px var(--case-glow)) drop-shadow(0 0 24px var(--case-glow));
    }
  }

  /* UI sobre el escenario */
  .hd-ui {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
  }

  .hd-nav {
    position: absolute;
    top: 14px;
    inset-inline: clamp(12px, 2.2vw, 32px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .hd-nav-left,
  .hd-nav-right {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.4vw, 18px);
  }

  .hd-tag {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 16px;
    border-radius: 3px;
    background: #ffffff;
    color: var(--ink);
    font-size: 14.5px;
    font-weight: 650;
    letter-spacing: -0.02em;
    white-space: nowrap;
    cursor: pointer;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
    transition: transform 200ms var(--ease-out);
  }

  .hd-tag:hover {
    transform: translateY(-2px);
  }

  .hd-tag-web {
    border-bottom: 3px solid #3b82f6;
  }
  .hd-tag-software {
    border-bottom: 3px solid #10b981;
  }
  .hd-tag-tecnico {
    border-bottom: 3px solid #f97316;
  }
  .hd-tag-lang {
    padding: 0 11px;
    background: rgba(255, 255, 255, 0.14);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(8px);
    font-size: 12.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
  }

  .hd-mobile-lang-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 12px;
    border-radius: 999px;
    background: rgba(7, 19, 30, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }

  .hd-tag-accent {
    background: var(--mint);
    color: var(--green-800);
    transition: transform 200ms var(--ease-out), background-color 300ms var(--ease-out), color 300ms var(--ease-out), box-shadow 300ms var(--ease-out);
  }

  /* En modo portátil, el botón "presupuesto" adopta el color del servicio activo */
  .hd-stage.is-case .hd-tag-accent {
    background: var(--case-accent);
    color: #ffffff;
    box-shadow: 0 6px 20px -4px var(--case-glow);
  }

  .hd-center-logo {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -62%);
    pointer-events: none;
    opacity: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 14px;
    border-radius: 999px;
    background: rgba(7, 19, 30, 0.72);
    border: 1px solid color-mix(in srgb, var(--case-accent) 45%, rgba(255, 255, 255, 0.14));
    backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35), 0 0 18px -6px var(--case-glow);
    cursor: pointer;
    transition: opacity 320ms var(--ease-out), transform 320ms var(--ease-out), border-color 300ms var(--ease-out), box-shadow 300ms var(--ease-out);
  }

  .hd-center-logo-icon {
    width: 24px;
    height: 26px;
    flex-shrink: 0;
  }

  .hd-center-logo-word {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: -0.03em;
    line-height: 1;
    color: #f8fafc;
  }

  .hd-stage.is-case .hd-center-logo {
    opacity: 1;
    transform: translate(-50%, -50%);
    pointer-events: auto;
  }

  /* Ticket perforado (top-right en modo casos) */
  .hd-ticket {
    position: absolute;
    top: clamp(74px, 10vh, 108px);
    right: clamp(16px, 3vw, 44px);
    width: clamp(190px, 17vw, 240px);
    background: #ffffff;
    color: var(--ink);
    border-radius: 4px;
    padding: 14px 22px 12px;
    box-shadow: 0 18px 42px rgba(0, 0, 0, 0.42);
    opacity: 0;
    transform: translateY(-18px) rotate(1.5deg);
    pointer-events: none;
    transition: opacity 360ms var(--ease-out), transform 420ms var(--ease-out);
  }

  .hd-stage.is-case .hd-ticket {
    opacity: 1;
    transform: translateY(0) rotate(0deg);
    pointer-events: auto;
  }

  /* Tornillos metálicos con ranura para efecto de atornillado en la matrícula */
  .hd-screw {
    position: absolute;
    width: 13px;
    height: 13px;
    border-radius: 999px;
    background: radial-gradient(circle at 35% 35%, #cbd5e1 0%, #64748b 55%, #1e293b 100%);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.7),
      0 1px 3px rgba(0, 0, 0, 0.55);
  }
  .hd-screw::after {
    content: "";
    position: absolute;
    left: 2px;
    right: 2px;
    top: 50%;
    height: 1.8px;
    background: #0f172a;
    transform: translateY(-50%) rotate(-32deg);
    border-radius: 1px;
  }
  .hd-hole-tl { top: 8px; left: 8px; }
  .hd-hole-tr { top: 8px; right: 8px; }
  .hd-hole-bl { bottom: 8px; left: 8px; }
  .hd-hole-br { bottom: 8px; right: 8px; }

  /* Barra móvil oculta en desktop */
  .hd-mobile-bar,
  .hd-mobile-overlay {
    display: none;
  }

  .hd-ticket h2 {
    font-family: "Anton", sans-serif;
    font-size: clamp(1.45rem, 2vw, 1.9rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-align: center;
    margin: 0;
  }

  .hd-ticket-rows {
    margin-top: 8px;
    border-top: 1.5px dashed rgba(13, 15, 14, 0.25);
    text-align: center;
  }

  .hd-ticket-rows :global(div) {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
    padding: 4px 0;
    border-bottom: 1px solid rgba(13, 15, 14, 0.1);
  }

  /* Indicador inferior de scroll */
  .hd-hint {
    position: absolute;
    left: 50%;
    bottom: clamp(18px, 3.2vh, 36px);
    transform: translateX(-50%);
    pointer-events: auto;
    transition: opacity 260ms var(--ease-out);
  }

  .hd-hint-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.9);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .hd-drip-line {
    position: relative;
    width: 1.5px;
    height: 22px;
    background: rgba(255, 255, 255, 0.35);
    overflow: hidden;
  }

  .hd-drip-bead {
    position: absolute;
    left: 0;
    top: -40%;
    width: 100%;
    height: 40%;
    background: #ffffff;
    animation: hd-drip 1.6s cubic-bezier(0.6, 0, 0.4, 1) infinite;
  }

  @keyframes hd-drip {
    to {
      top: 100%;
    }
  }

  /* Responsive móvil (<= 820px) */
  @media (max-width: 820px) {
    .hd-track {
      height: 300vh;
    }

    .hd-nav {
      top: 10px;
      left: 10px;
      right: 10px;
      width: calc(100% - 20px);
      flex-wrap: wrap;
      justify-content: center;
      gap: 6px;
    }

    .hd-nav-left,
    .hd-nav-right,
    .hd-center-logo {
      display: none;
    }

    .hd-mobile-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      pointer-events: auto;
    }

    .hd-mobile-brand {
      font-weight: 900;
      font-size: 16px;
      letter-spacing: -0.04em;
      color: #ffffff;
      padding: 6px 12px;
      border-radius: 999px;
      background: rgba(7, 19, 30, 0.65);
      border: 1px solid rgba(255, 255, 255, 0.14);
      backdrop-filter: blur(10px);
    }

    .hd-mobile-menu-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      height: 36px;
      padding: 0 14px;
      border-radius: 999px;
      background: rgba(7, 19, 30, 0.78);
      border: 1px solid rgba(255, 255, 255, 0.22);
      backdrop-filter: blur(12px);
      color: #ffffff;
      font-size: 11.5px;
      font-weight: 800;
      letter-spacing: 0.12em;
      cursor: pointer;
    }

    .hd-mobile-overlay:not([hidden]) {
      display: flex;
      position: fixed;
      inset: 0;
      z-index: 60;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background: rgba(5, 7, 13, 0.96);
      backdrop-filter: blur(22px);
      padding: 24px;
      pointer-events: auto;
    }

    .hd-mobile-close {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 42px;
      height: 42px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.18);
      background: rgba(255, 255, 255, 0.06);
      color: #ffffff;
      font-size: 18px;
      cursor: pointer;
    }

    .hd-mobile-links {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      width: 100%;
      max-width: 340px;
    }

    .hd-m-link {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 12px;
      width: 100%;
      padding: 14px 20px;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.09);
      background: rgba(255, 255, 255, 0.03);
      color: #ffffff;
      font-family: var(--font-display);
      font-size: 1.08rem;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      cursor: pointer;
    }

    .hd-m-chev {
      width: 28px;
      height: 20px;
      color: var(--m-accent);
      flex-shrink: 0;
    }

    .hd-m-chev path {
      opacity: 0.22;
      animation: hd-m-pulse 1.5s ease-in-out infinite;
    }
    .hd-m-chev .mc1 { animation-delay: 0s; }
    .hd-m-chev .mc2 { animation-delay: 0.22s; }
    .hd-m-chev .mc3 { animation-delay: 0.44s; }

    @keyframes hd-m-pulse {
      0%, 100% { opacity: 0.22; filter: drop-shadow(0 0 2px transparent); }
      45% { opacity: 1; filter: drop-shadow(0 0 8px var(--m-glow)); }
    }

    .hd-wordmark {
      top: 84px;
      left: 10px;
      width: calc(100% - 20px);
      height: 58px;
    }

    .hd-script {
      top: 142px;
      left: 16px;
      font-size: 1.55rem;
    }

    .hd-badge {
      display: none;
    }

    .hd-hint {
      bottom: 94px;
      width: calc(100% - 32px);
      max-width: 310px;
      text-align: center;
      padding: 8px 14px;
      border-radius: 999px;
      background: rgba(7, 19, 30, 0.72);
      border: 1px solid rgba(255, 255, 255, 0.14);
      backdrop-filter: blur(8px);
    }

    .hd-drip-line {
      display: none;
    }

    .hd-hint-btn {
      font-size: 10px;
      letter-spacing: 0.1em;
    }

    .hd-ticket {
      left: 50%;
      right: auto;
      top: 80px;
      width: min(86vw, 310px);
      padding: 10px 18px 8px;
      transform: translateX(-50%) translateY(-12px);
    }

    .hd-stage.is-case .hd-ticket {
      transform: translateX(-50%) translateY(0);
    }

    .hd-ticket h2 {
      font-size: 1.35rem;
    }

    .hd-ticket-rows :global(div) {
      font-size: 9px;
      padding: 2.5px 0;
      text-align: center;
    }

    .hd-screen {
      border-radius: 8px 8px 3px 3px;
    }

    .hd-screen-content {
      padding: 10px 12px;
    }

    .hd-service-pill {
      padding: 3px 8px;
      font-size: 8px;
    }

    .hd-service-title {
      margin-top: 6px;
      font-size: 0.98rem;
    }

    .hd-service-subtitle {
      margin-top: 4px;
      font-size: 0.66rem;
      line-height: 1.3;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .hd-service-actions {
      margin-top: 8px;
      gap: 6px;
    }

    .hd-service-cta {
      padding: 5px 11px;
      font-size: 0.68rem;
    }

    .hd-dot-btn {
      width: 14px;
      height: 3px;
    }

    .hd-dot-btn.is-active {
      width: 24px;
    }

    .hd-chev {
      width: 42px;
      height: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hd-drip-bead,
    .hd-chev path {
      animation: none;
      opacity: 0.85;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-laptop-dive]');
  if (track) {
    const stage = track.querySelector<HTMLElement>('[data-hd-stage]');
    const canvas = track.querySelector<HTMLCanvasElement>('[data-hd-canvas]');
    const ctx = canvas?.getContext('2d');
    const cutEl = track.querySelector<HTMLImageElement>('[data-hd-cut]');
    const wordmarkEl = track.querySelector<HTMLElement>('[data-hd-wordmark]');
    const scriptEl = track.querySelector<HTMLElement>('[data-hd-script]');
    const badgeEl = track.querySelector<HTMLElement>('[data-hd-badge]');
    const badgeHitEl = track.querySelector<HTMLElement>('[data-hd-badge-hit]');
    const hintEl = track.querySelector<HTMLElement>('[data-hd-hint]');
    const screenEl = track.querySelector<HTMLElement>('[data-hd-screen]');
    const flashEl = track.querySelector<HTMLElement>('[data-hd-flash]');

    const tagEl = track.querySelector<HTMLElement>('[data-hd-tag]');
    const titleEl = track.querySelector<HTMLElement>('[data-hd-title]');
    const subtitleEl = track.querySelector<HTMLElement>('[data-hd-subtitle]');
    const ctaLinkEl = track.querySelector<HTMLAnchorElement>('[data-hd-cta-link]');
    const ctaLabelEl = track.querySelector<HTMLElement>('[data-hd-cta-label]');
    const ticketEl = track.querySelector<HTMLElement>('[data-hd-ticket]');
    const ticketTitleEl = track.querySelector<HTMLElement>('[data-hd-ticket-title]');
    const ticketRowsEl = track.querySelector<HTMLElement>('[data-hd-ticket-rows]');
    const mobileMenuOpenBtn = track.querySelector<HTMLButtonElement>('[data-hd-menu-open]');
    const mobileMenuCloseBtn = track.querySelector<HTMLButtonElement>('[data-hd-menu-close]');
    const mobileOverlayEl = track.querySelector<HTMLElement>('[data-hd-mobile-overlay]');
    const mobileStudioBtn = track.querySelector<HTMLButtonElement>('[data-hd-studio-m]');
    const mobileDrawerStudioBtn = track.querySelector<HTMLButtonElement>('[data-hd-m-studio]');
    const staggerEls = Array.from(track.querySelectorAll<HTMLElement>('[data-hd-stagger]'));
    const dotBtns = Array.from(track.querySelectorAll<HTMLButtonElement>('[data-hd-dot]'));

    const prevBtn = track.querySelector<HTMLButtonElement>('[data-hd-prev]');
    const nextBtn = track.querySelector<HTMLButtonElement>('[data-hd-next]');
    const studioBtn = track.querySelector<HTMLButtonElement>('[data-hd-studio]');
    const centerLogoBtn = track.querySelector<HTMLButtonElement>('[data-hd-center-logo]');
    const hintBtn = track.querySelector<HTMLButtonElement>('[data-hd-hint-btn]');

    const bgSlides = Array.from(track.querySelectorAll<HTMLElement>('[data-hd-media]'));
    const cases = JSON.parse(track.dataset.cases || '[]');
    const rm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 60 frames WebP (1280x720) — pantalla interior calibrada a ras del bisel del MacBook
    const TOTAL_FRAMES = 60;
    const FRAME_W = 1280;
    const FRAME_H = 720;
    const FRAME_RATIO = FRAME_W / FRAME_H;
    const SCREEN_RECT = {
      left: 0.2845,
      top: 0.181,
      width: 0.431,
      height: 0.493,
    };

    const frames: (HTMLImageElement | null)[] = new Array(TOTAL_FRAMES).fill(null);
    const loaded: boolean[] = new Array(TOTAL_FRAMES).fill(false);

    const loadFrame = (idx: number) => {
      const img = new Image();
      img.decoding = 'async';
      img.src = `/hero-dive/frames/f-${String(idx).padStart(2, '0')}.webp`;
      img.onload = () => {
        frames[idx] = img;
        loaded[idx] = true;
        if (idx === 0 || idx === currentDrawnFrame) {
          needsDraw = true;
        }
      };
    };

    loadFrame(0);
    loadFrame(TOTAL_FRAMES - 1);
    for (let i = 1; i < TOTAL_FRAMES - 1; i++) {
      loadFrame(i);
    }

    let cw = 1;
    let ch = 1;
    let dpr = 1;
    let currentIdx = -1;
    let smoothP = 0;
    let currentDrawnFrame = -1;
    let needsDraw = true;
    let isCaseActive = false;
    let typingTimer: number | null = null;

    // Tramos exactos del scroll (0 -> 1):
    // 0.00..0.34 = vuelo del portátil frame a frame (rápido, ~1 giro cómodo)
    // 0.34..0.56 = Servicio 1 (Web)
    // 0.56..0.78 = Servicio 2 (Software)
    // 0.78..1.00 = Servicio 3 (Técnico)
    // > 1.00     = sube la sección #pilares comiéndose suavemente la pantalla
    const DIVE_END = 0.34;
    const SERVICE_ANCHORS = [0.45, 0.67, 0.89];

    const getDrawRect = (p: number) => {
      const isMobile = cw <= 820;
      const viewRatio = cw / ch;

      let coverW: number, coverH: number, coverX: number, coverY: number;
      if (viewRatio > FRAME_RATIO) {
        coverW = cw;
        coverH = cw / FRAME_RATIO;
        coverX = 0;
        coverY = (ch - coverH) / 2;
      } else {
        coverH = ch;
        coverW = ch * FRAME_RATIO;
        coverX = (cw - coverW) / 2;
        coverY = 0;
      }

      if (!isMobile) {
        return { x: coverX, y: coverY, w: coverW, h: coverH };
      }

      // En móvil: interpolación suave hasta centrar el MacBook completo dejando hueco lateral para los chevrons
      const mobileFitW = cw * 1.66;
      const mobileFitH = mobileFitW / FRAME_RATIO;
      const mobileFitX = (cw - mobileFitW) / 2;
      const mobileFitY = ch * 0.52 - mobileFitH * 0.45;

      const t = Math.min(1, Math.max(0, p / DIVE_END));
      const ease = t * t * (3 - 2 * t);
      return {
        x: coverX + (mobileFitX - coverX) * ease,
        y: coverY + (mobileFitY - coverY) * ease,
        w: coverW + (mobileFitW - coverW) * ease,
        h: coverH + (mobileFitH - coverH) * ease,
      };
    };

    const syncCanvasSize = () => {
      if (!canvas || !stage) return;
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      cw = stage.clientWidth || window.innerWidth;
      ch = stage.clientHeight || window.innerHeight;
      canvas.width = Math.round(cw * dpr);
      canvas.height = Math.round(ch * dpr);
      needsDraw = true;
    };

    const getNearestLoadedFrame = (target: number): HTMLImageElement | null => {
      if (loaded[target] && frames[target]) return frames[target];
      for (let d = 1; d < TOTAL_FRAMES; d++) {
        if (target - d >= 0 && loaded[target - d] && frames[target - d]) return frames[target - d];
        if (target + d < TOTAL_FRAMES && loaded[target + d] && frames[target + d]) return frames[target + d];
      }
      return null;
    };

    const stopTyping = () => {
      if (typingTimer !== null) {
        window.clearTimeout(typingTimer);
        typingTimer = null;
      }
      subtitleEl?.classList.remove('is-typing');
    };

    const startTypewriter = (text: string) => {
      if (!subtitleEl) return;
      stopTyping();
      if (rm) {
        subtitleEl.textContent = text;
        return;
      }
      subtitleEl.textContent = '';
      subtitleEl.classList.add('is-typing');
      let pos = 0;
      const step = () => {
        pos += 2;
        subtitleEl.textContent = text.slice(0, pos);
        if (pos < text.length) {
          typingTimer = window.setTimeout(step, 20);
        } else {
          subtitleEl.textContent = text;
          typingTimer = window.setTimeout(() => subtitleEl.classList.remove('is-typing'), 900);
        }
      };
      // Empieza justo después del fade-in inicial del título
      typingTimer = window.setTimeout(step, 260);
    };

    const animateTextStagger = () => {
      if (rm) return;
      staggerEls.forEach((el, i) => {
        // El subtítulo tiene su propio efecto máquina de escribir
        if (el === subtitleEl) return;
        el.animate(
          [
            { opacity: 0, transform: 'translateY(16px)', filter: 'blur(7px)' },
            { opacity: 1, transform: 'translateY(0)', filter: 'blur(0px)' },
          ],
          {
            duration: 760,
            delay: i * 120,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            fill: 'both',
          }
        );
      });
    };

    const renderScene = (p: number) => {
      if (!ctx || !stage) return;

      const animP = Math.min(1, Math.max(0, p / DIVE_END));
      const frameIdx = rm
        ? p > 0.25
          ? TOTAL_FRAMES - 1
          : 0
        : Math.min(TOTAL_FRAMES - 1, Math.max(0, Math.round(animP * (TOTAL_FRAMES - 1))));

      const rect = getDrawRect(p);

      const img = getNearestLoadedFrame(frameIdx);
      ctx.save();
      ctx.scale(dpr, dpr);
      ctx.fillStyle = '#07131e';
      ctx.fillRect(0, 0, cw, ch);
      if (img) {
        ctx.drawImage(img, rect.x, rect.y, rect.w, rect.h);
        currentDrawnFrame = frameIdx;
      }
      ctx.restore();

      const heroFade = Math.max(0, 1 - p / 0.09);
      if (cutEl) {
        cutEl.style.left = `${rect.x}px`;
        cutEl.style.top = `${rect.y}px`;
        cutEl.style.width = `${rect.w}px`;
        cutEl.style.height = `${rect.h}px`;
        // Ocultamos cut.webp en cuanto avanza al frame 1 para que nunca haya doble silueta
        cutEl.style.opacity = String(frameIdx === 0 ? 1 : Math.max(0, 1 - frameIdx / 3));
      }

      if (wordmarkEl) {
        wordmarkEl.style.opacity = String(heroFade);
        wordmarkEl.style.transform = `translateY(${(1 - heroFade) * -32}px)`;
      }
      if (scriptEl) {
        scriptEl.style.opacity = String(heroFade);
      }
      if (badgeEl) {
        badgeEl.style.opacity = String(heroFade);
        badgeEl.style.transform = `translateY(${(1 - heroFade) * -90}px)`;
      }
      if (hintEl) {
        hintEl.style.opacity = String(Math.max(0, 1 - p / 0.06));
        hintEl.style.pointerEvents = p < 0.05 ? 'auto' : 'none';
      }

      const sx = rect.x + rect.w * SCREEN_RECT.left;
      const sy = rect.y + rect.h * SCREEN_RECT.top;
      const sw = rect.w * SCREEN_RECT.width;
      const sh = rect.h * SCREEN_RECT.height;

      if (screenEl) {
        screenEl.style.left = `${sx}px`;
        screenEl.style.top = `${sy}px`;
        screenEl.style.width = `${sw}px`;
        screenEl.style.height = `${sh}px`;
      }

      const midY = sy + sh / 2;
      const isMobile = cw <= 820;
      const chevSize = isMobile ? 42 : Math.min(76, Math.max(54, cw * 0.052));
      const sideGap = isMobile ? 6 : Math.min(44, Math.max(18, cw * 0.025));

      if (prevBtn) {
        const leftPos = Math.max(8, sx - chevSize - sideGap);
        prevBtn.style.left = `${leftPos}px`;
        prevBtn.style.top = `${midY}px`;
      }
      if (nextBtn) {
        const rightPos = Math.min(cw - chevSize - 8, sx + sw + sideGap);
        nextBtn.style.left = `${rightPos}px`;
        nextBtn.style.top = `${midY}px`;
      }

      const shouldBeCase = p >= DIVE_END - 0.015;
      if (shouldBeCase !== isCaseActive) {
        isCaseActive = shouldBeCase;
        stage.classList.toggle('is-case', isCaseActive);
        if (!isCaseActive) {
          stopTyping();
        }
      }

      // Cambio automático de servicio según el scroll (1 -> 2 -> 3)
      if (shouldBeCase) {
        const targetIdx = p < 0.56 ? 0 : p < 0.78 ? 1 : 2;
        if (targetIdx !== currentIdx) {
          fillCase(targetIdx, true);
        }
      }
    };

    const getScrollProgress = () => {
      const rect = track.getBoundingClientRect();
      const maxScroll = Math.max(1, track.offsetHeight - window.innerHeight);
      return Math.min(1, Math.max(0, -rect.top / maxScroll));
    };

    const tick = () => {
      const targetP = getScrollProgress();
      const diff = targetP - smoothP;
      if (Math.abs(diff) > 0.0004) {
        smoothP = rm ? targetP : smoothP + diff * 0.18;
        needsDraw = true;
      } else if (smoothP !== targetP) {
        smoothP = targetP;
        needsDraw = true;
      }

      if (needsDraw) {
        needsDraw = false;
        renderScene(smoothP);
      }
      requestAnimationFrame(tick);
    };

    const fillCase = (idx: number, animate = true) => {
      const item = cases[idx];
      if (!item || !stage) return;
      currentIdx = idx;

      stage.style.setProperty('--case-accent', item.accent);
      stage.style.setProperty('--case-glow', item.accentGlow);

      if (tagEl) tagEl.textContent = item.tag;
      if (titleEl) titleEl.textContent = item.title;
      if (ctaLinkEl) ctaLinkEl.href = item.href;
      if (ctaLabelEl) ctaLabelEl.textContent = item.ctaLabel;
      if (ticketTitleEl) ticketTitleEl.textContent = item.ticketTitle;
      if (ticketRowsEl) {
        ticketRowsEl.innerHTML = item.rows.map((r: string) => `<div>${r}</div>`).join('');
      }

      bgSlides.forEach((s, i) => {
        s.style.opacity = i === idx ? '1' : '0';
      });

      dotBtns.forEach((b, i) => {
        const active = i === idx;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });

      if (animate) {
        animateTextStagger();
        startTypewriter(item.subtitle);
        // Aparición sutil sin saltos ni giros bruscos (en móvil respeta translateX(-50%) centrado)
        if (!rm && ticketEl) {
          const isMobileView = window.matchMedia('(max-width: 820px)').matches;
          const baseTx = isMobileView ? 'translateX(-50%) ' : '';
          ticketEl.animate(
            [
              { transform: `${baseTx}translateY(-6px) scale(0.97)`, opacity: 0.2 },
              { transform: `${baseTx}translateY(0) scale(1)`, opacity: 1 },
            ],
            { duration: 380, easing: 'cubic-bezier(0.22, 1, 0.36, 1)' }
          );
        }
      } else if (subtitleEl) {
        subtitleEl.textContent = item.subtitle;
      }

      if (!rm && flashEl && animate) {
        flashEl.animate([{ opacity: 0 }, { opacity: 0.22 }, { opacity: 0 }], {
          duration: 340,
          easing: 'ease-out',
        });
      }
    };

    const scrollToService = (idx: number) => {
      const clamped = Math.max(0, Math.min(cases.length - 1, idx));
      const maxScroll = Math.max(0, track.offsetHeight - window.innerHeight);
      const anchor = SERVICE_ANCHORS[clamped] ?? 0.45;
      window.scrollTo({ top: Math.round(maxScroll * anchor), behavior: rm ? 'auto' : 'smooth' });
    };

    const scrollToHero = () => {
      window.scrollTo({ top: 0, behavior: rm ? 'auto' : 'smooth' });
    };

    prevBtn?.addEventListener('click', () => {
      const base = currentIdx < 0 ? 0 : currentIdx;
      scrollToService((base - 1 + cases.length) % cases.length);
    });
    nextBtn?.addEventListener('click', () => {
      const base = currentIdx < 0 ? 0 : currentIdx;
      scrollToService((base + 1) % cases.length);
    });
    dotBtns.forEach((btn, idx) => {
      btn.addEventListener('click', () => scrollToService(idx));
    });
    hintBtn?.addEventListener('click', () => scrollToService(0));
    studioBtn?.addEventListener('click', scrollToHero);
    centerLogoBtn?.addEventListener('click', scrollToHero);
    mobileStudioBtn?.addEventListener('click', scrollToHero);

    const setMobileMenu = (open: boolean) => {
      if (!mobileOverlayEl) return;
      mobileOverlayEl.hidden = !open;
      mobileMenuOpenBtn?.setAttribute('aria-expanded', String(open));
    };
    mobileMenuOpenBtn?.addEventListener('click', () => setMobileMenu(true));
    mobileMenuCloseBtn?.addEventListener('click', () => setMobileMenu(false));
    mobileDrawerStudioBtn?.addEventListener('click', () => {
      setMobileMenu(false);
      scrollToHero();
    });

    badgeHitEl?.addEventListener('pointerenter', () => {
      if (rm || !badgeEl || smoothP > 0.05) return;
      badgeEl.animate(
        [
          { transform: 'rotate(0deg)' },
          { transform: 'rotate(-5deg)' },
          { transform: 'rotate(3.5deg)' },
          { transform: 'rotate(-1.5deg)' },
          { transform: 'rotate(0deg)' },
        ],
        { duration: 1200, easing: 'ease-out', composite: 'add' }
      );
    });

    window.addEventListener('resize', syncCanvasSize, { passive: true });
    syncCanvasSize();
    fillCase(0, false);
    renderScene(getScrollProgress());
    requestAnimationFrame(tick);
  }
</script>

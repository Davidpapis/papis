---
/**
 * Hero "Laptop Dive" adaptado 100% a papis.app (Marbella).
 * - Funciona de serie con las imágenes optimizadas actuales + portátil realista.
 * - Detecta automáticamente los archivos definitivos si se añaden en /public/hero-dive/:
 *   plate.webp, cut.png, case-plate.webp, trans.mp4 y case-1..3.mp4.
 */
interface DiveCase {
  id: string;
  ticketTitle: string;
  rows: [string, string, string];
  descKey: string;
  descText: string;
  image: string;
  video: string;
  href: string;
  ctaLabel: string;
  accent: string;
}

const CASES: DiveCase[] = [
  {
    id: 'web',
    ticketTitle: 'WEB & SEO/GEO',
    rows: ['ASTRO + KEYSTATIC', 'AAAR · SERINAMAR', '10–15 DÍAS'],
    descKey: '// webs reales en marbella',
    descText:
      '— páginas a medida en HTML estático (< 0,8s), SEO local y GEO para IA, como AAAR Marbella (compromiso social), Grupo Serinamar o Cerrajería Carlos Neira.',
    image: '/hero-dive/case-web.webp',
    video: '/hero-dive/case-1.mp4',
    href: '/paginas-web',
    ctaLabel: 'Ver Diseño Web',
    accent: '#3B82F6',
  },
  {
    id: 'software',
    ticketTitle: 'SOFTWARE ERP',
    rows: ['BOBISAPP · LA CLAVE', 'SIN CUOTAS / USUARIO', 'DESDE 6.000 €'],
    descKey: '// apps reales en producción',
    descText:
      '— ERP, CRM y plataformas privadas en la nube como Bobisapp o Academia La Clave, en propiedad y con 1 mes de beta con mejoras en 24h.',
    image: '/hero-dive/case-software.webp',
    video: '/hero-dive/case-2.mp4',
    href: '/software-empresas',
    ctaLabel: 'Ver Software Empresas',
    accent: '#10B981',
  },
  {
    id: 'tecnico',
    ticketTitle: 'TÉCNICO EN CASA',
    rows: ['20 AÑOS · RTV MARBELLA', 'CABOPINO A ESTEPONA', 'DESDE 45 €/H'],
    descKey: '// 20 años de experiencia',
    descText:
      '— 20 años dando soporte técnico a domicilio desde Cabopino hasta Estepona y colaborando en Radio Televisión Marbella. También remoto mundial vía RustDesk.',
    image: '/assets/optimized/servicio-tecnico-marbella.webp',
    video: '/hero-dive/case-3.mp4',
    href: '/servicio-tecnico',
    ctaLabel: 'Ver Servicio Técnico',
    accent: '#F97316',
  },
];
---

<section
  id="inicio"
  data-laptop-dive
  data-cases={JSON.stringify(CASES)}
  aria-label="Presentación interactiva de papis.app"
  class="hd-stage relative h-[100dvh] min-h-[620px] w-full overflow-hidden select-none"
>
  <!-- H1 semántico para SEO, GEO y lectores de pantalla -->
  <h1 class="sr-only">
    papis.app — Diseño web ultrarrápido con SEO y GEO, software a medida y servicio técnico en Marbella
  </h1>

  <!-- Fondo de transición en modo casos -->
  <div aria-hidden="true" class="hd-stage-case-bg"></div>

  <!-- Escena principal por capas -->
  <div class="hd-scene" data-hd-scene>
    <!-- Capa 1: Fondo fotográfico real de estudio de David Papis -->
    <img
      data-hd-plate
      src="/hero-dive/plate.webp"
      alt="David Papis en su estudio de papis.app sujetando un portátil en Marbella"
      width="1376"
      height="768"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hd-plate"
    />
    <div aria-hidden="true" class="hd-plate-vignette"></div>

    <!-- Capa 2: Wordmark gigante PAPIS.APP (detrás del recorte cut.png) -->
    <svg
      data-hd-wordmark
      class="hd-wordmark hd-pre"
      viewBox="0 0 1440 260"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <linearGradient id="papisWordmarkGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#ffffff" stop-opacity="1" />
          <stop offset="52%" stop-color="#f1f5f3" stop-opacity="0.9" />
          <stop offset="100%" stop-color="#d7e6de" stop-opacity="0.22" />
        </linearGradient>
      </defs>
      <text
        x="18"
        y="214"
        textLength="1404"
        lengthAdjust="spacingAndGlyphs"
        fill="url(#papisWordmarkGrad)"
      >
        PAPIS.APP
      </text>
    </svg>

    <!-- Capa 3: Recorte WebP transparente de David Papis (pixel-aligned con plate.webp) -->
    <img
      data-hd-cut
      src="/hero-dive/cut.webp"
      alt=""
      width="1376"
      height="768"
      loading="eager"
      decoding="async"
      aria-hidden="true"
      class="hd-cut"
    />

    <!-- Capa 4: Firma manuscrita Caveat Brush -->
    <p data-hd-script class="hd-script hd-pre" aria-hidden="true">
      web · software · ia
    </p>

    <!-- Capa 5: Lanyard ID Badge colgante con física de péndulo -->
    <div data-hd-badge class="hd-badge hd-pre" aria-hidden="true">
      <!-- Cinta superior y mosquetón metálico SVG -->
      <svg class="hd-lanyard-strap" viewBox="0 0 260 220" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M114 0H146L141 148H119L114 0Z" fill="#E8ECEA" />
        <path d="M127 0H133V148H127V0Z" fill="#CBD5D0" opacity="0.55" />
        <rect x="115" y="144" width="30" height="16" rx="4" fill="#94A3B8" />
        <path
          d="M122 160H138L135 186C135 190 132.5 193 130 193C127.5 193 125 190 125 186L122 160Z"
          fill="#CBD5E1"
          stroke="#475569"
          stroke-width="2"
        />
        <rect x="108" y="190" width="44" height="14" rx="4" fill="#E2E8F0" stroke="#64748B" stroke-width="1.5" />
      </svg>

      <!-- Funda transparente + tarjeta blanca real de David Papis -->
      <div class="hd-badge-sleeve" data-hd-badge-hit>
        <div class="hd-badge-card">
          <div class="flex items-start justify-between">
            <h4>TECH<br />STUDIO</h4>
            <span class="hd-badge-yr">2026</span>
          </div>
          <p class="hd-badge-role">FOUNDER // MARBELLA</p>

          <div class="hd-badge-photo">
            <img
              src="/hero-dive/papis-badge-face.webp"
              alt="David Papis"
              width="92"
              height="112"
              loading="eager"
              decoding="async"
            />
          </div>

          <div class="hd-badge-rows">
            <div class="hd-badge-row"><span>NAME</span><b>DAVID PAPIS</b></div>
            <div class="hd-badge-row"><span>FOCUS</span><b>WEB · ERP · IA</b></div>
            <div class="hd-badge-row"><span>TEL</span><b>+34 652 918 061</b></div>
            <div class="hd-badge-row"><span>WEB</span><b>PAPIS.APP</b></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Capa 6: Vídeo de transición Google Flow (streaming directo para iOS/Android y Desktop) -->
    <video
      data-hd-trans
      src="/hero-dive/trans.mp4"
      muted
      playsinline
      webkit-playsinline="true"
      preload="auto"
      class="hd-trans"
      aria-hidden="true"
    ></video>

    <!-- Capa 7: Escena de portátil real centrado (case-plate.webp con pantalla calibrada al píxel) -->
    <div data-hd-case-wrap class="hd-case-wrap">
      <div class="hd-case-frame">
        <img
          data-hd-caseplate
          src="/hero-dive/case-plate.webp"
          alt=""
          width="1376"
          height="768"
          loading="eager"
          decoding="async"
          aria-hidden="true"
          class="hd-caseplate"
        />
        <div data-hd-screen class="hd-screen hd-screen-mapped">
          {
            CASES.map((item, idx) => (
              <div
                data-hd-media={idx}
                class="hd-screen-slide"
                style={`opacity: ${idx === 0 ? 1 : 0};`}
              >
                <img
                  src={item.image}
                  alt={item.ticketTitle}
                  loading={idx === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="h-full w-full object-cover object-top"
                />
                <video
                  data-hd-case-video={idx}
                  muted
                  loop
                  playsinline
                  preload="none"
                  class="hd-case-video hidden"
                />
              </div>
            ))
          }
          <div aria-hidden="true" class="hd-screen-sheen"></div>
          <div data-hd-flash aria-hidden="true" class="hd-screen-flash"></div>
          <button
            type="button"
            data-hd-screen-hit
            class="hd-screen-hit"
            aria-label="Pasar al siguiente caso en la pantalla"
          ></button>
        </div>
      </div>
    </div>
  </div>

  <!-- Capa UI fijada al viewport (Etiquetas Nav, Logo centro, Ticket, Descripción, Prev/Next, Hint) -->
  <div class="hd-ui">
    <!-- Barra superior estilo sticker tags con los 3 servicios separados -->
    <nav aria-label="Navegación principal del estudio" class="hd-nav">
      <div class="hd-nav-left">
        <button type="button" data-hd-studio class="hd-tag hd-pre">mi estudio</button>
        <a href="/paginas-web" class="hd-tag hd-tag-web hd-pre">web</a>
        <a href="/software-empresas" class="hd-tag hd-tag-software hd-pre">software</a>
        <a href="/servicio-tecnico" class="hd-tag hd-tag-tecnico hd-pre">técnico</a>
      </div>

      <button
        type="button"
        data-hd-center-logo
        class="hd-center-logo"
        aria-label="Volver a portada del estudio papis.app"
      >
        PAPIS.APP
      </button>

      <div class="hd-nav-right">
        <button type="button" data-hd-dive class="hd-tag hd-pre">proyectos</button>
        <a href="/contacto" class="hd-tag hd-tag-accent hd-pre">presupuesto</a>
      </div>
    </nav>

    <!-- Ticket perforado (top-right en modo casos) -->
    <article data-hd-ticket class="hd-ticket" aria-live="polite">
      <span class="hd-hole hd-hole-tl" aria-hidden="true"></span>
      <span class="hd-hole hd-hole-tr" aria-hidden="true"></span>
      <span class="hd-hole hd-hole-bl" aria-hidden="true"></span>
      <span class="hd-hole hd-hole-br" aria-hidden="true"></span>
      <h2 data-hd-ticket-title>{CASES[0].ticketTitle}</h2>
      <div class="hd-ticket-rows" data-hd-ticket-rows>
        {CASES[0].rows.map((r) => <div>{r}</div>)}
      </div>
    </article>

    <!-- Descripción izquierda (modo casos) -->
    <div data-hd-desc class="hd-desc" aria-live="polite">
      <p data-hd-desc-key class="hd-desc-key">{CASES[0].descKey}</p>
      <p data-hd-desc-text class="hd-desc-text">{CASES[0].descText}</p>
      <a data-hd-desc-link href={CASES[0].href} class="hd-desc-link">
        <span data-hd-desc-cta>{CASES[0].ctaLabel}</span> →
      </a>
      <p data-hd-desc-num class="hd-desc-num">01 / 03</p>
    </div>

    <!-- Botones circulares Anterior / Siguiente -->
    <button type="button" data-hd-prev class="hd-nav-case hd-prev" aria-label="Caso anterior">
      <span class="hd-circle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5M11 6l-6 6 6 6" />
        </svg>
      </span>
      <span class="hd-nav-label">caso<br />anterior</span>
    </button>

    <button type="button" data-hd-next class="hd-nav-case hd-next" aria-label="Siguiente caso">
      <span class="hd-circle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </span>
      <span class="hd-nav-label">siguiente<br />caso</span>
    </button>

    <!-- Indicador inferior de scroll + acceso rápido a toda la web -->
    <div data-hd-hint class="hd-hint hd-pre">
      <button type="button" data-hd-hint-btn class="hd-hint-btn">
        <span class="hd-drip-line" aria-hidden="true">
          <span class="hd-drip-bead"></span>
        </span>
        <span class="hd-hint-desktop">desliza para entrar en los proyectos</span>
        <span class="hd-hint-mobile">▶ Ver proyectos en el portátil</span>
      </button>
      <a href="#pilares" class="hd-skip-web">o baja a ver toda la web ↓</a>
    </div>
  </div>
</section>

<style>
  .hd-stage {
    --green-900: #0b2f20;
    --green-800: #11402c;
    --mint: #cfeee0;
    --ink: #0d0f0e;
    font-family: "Inter Tight", var(--font-sans), sans-serif;
    background: linear-gradient(180deg, #0b2f20 0%, #124833 48%, #071912 100%);
  }

  .hd-stage-case-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #1b4a34 0%, #143a29 52%, #071912 100%);
    opacity: 0;
    transition: opacity 700ms var(--ease-out);
    pointer-events: none;
  }

  .hd-stage.is-case .hd-stage-case-bg {
    opacity: 1;
  }

  .hd-scene {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .hd-plate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    transform-origin: center center;
    transition:
      transform 850ms var(--ease-in-out),
      opacity 650ms var(--ease-out),
      filter 650ms var(--ease-out);
  }

  .hd-stage.is-case .hd-plate {
    transform: scale(1.04);
    opacity: 0;
  }

  .hd-plate-vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(7, 19, 30, 0.32) 0%, rgba(7, 19, 30, 0.04) 45%, rgba(5, 8, 14, 0.55) 100%);
    pointer-events: none;
    z-index: 2;
  }

  .hd-wordmark {
    position: absolute;
    left: 2vw;
    top: clamp(58px, 7vh, 88px);
    width: 96vw;
    height: clamp(110px, 24vw, 270px);
    z-index: 3;
    pointer-events: none;
    overflow: visible;
  }

  .hd-wordmark text {
    font-family: "Inter Tight", sans-serif;
    font-weight: 900;
    font-size: 262px;
    letter-spacing: -6px;
  }

  .hd-cut {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    z-index: 4;
    pointer-events: none;
    transition: opacity 420ms var(--ease-out);
  }

  .hd-stage.is-case .hd-cut {
    opacity: 0;
  }

  .hd-script {
    position: absolute;
    left: clamp(20px, 6vw, 96px);
    top: clamp(128px, 21vw, 248px);
    z-index: 6;
    font-family: "Caveat Brush", cursive;
    font-size: clamp(2.1rem, 5.4vw, 4.9rem);
    line-height: 1;
    color: #ffffff;
    letter-spacing: -0.5px;
    transform: rotate(-8deg);
    transform-origin: 0 50%;
    text-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    pointer-events: none;
  }

  /* Lanyard ID Badge */
  .hd-badge {
    position: absolute;
    right: clamp(14px, 5vw, 84px);
    top: -12px;
    width: clamp(148px, 16vw, 224px);
    z-index: 7;
    transform-origin: 50% 0;
    pointer-events: none;
  }

  .hd-lanyard-strap {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: -10px;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.35));
  }

  .hd-badge-sleeve {
    pointer-events: auto;
    cursor: grab;
    border-radius: 14px;
    padding: 8px;
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.08));
    border: 1px solid rgba(255, 255, 255, 0.35);
    box-shadow: 0 22px 44px rgba(0, 0, 0, 0.48);
    backdrop-filter: blur(8px);
  }

  .hd-badge-card {
    background: #f8faf9;
    color: #141615;
    border-radius: 8px;
    padding: 12px 11px 11px;
  }

  .hd-badge-card h4 {
    font-size: clamp(1rem, 1.55vw, 1.38rem);
    line-height: 0.94;
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0;
  }

  .hd-badge-yr {
    font-size: 10px;
    font-weight: 700;
    color: #334155;
  }

  .hd-badge-role {
    margin-top: 7px;
    padding-top: 4px;
    border-top: 1px solid #1e293b;
    font-size: 8.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .hd-badge-photo {
    width: 68px;
    height: 82px;
    margin: 9px auto;
    border-radius: 6px;
    overflow: hidden;
    background: #dfe4e1;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08);
  }

  .hd-badge-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  .hd-badge-rows {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hd-badge-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    font-size: 8px;
    font-weight: 700;
    padding: 4px 0 2px;
    border-bottom: 1.5px dotted #334155;
  }

  .hd-badge-row b {
    font-weight: 600;
    color: #0f172a;
  }

  /* Vídeo de transición */
  .hd-trans {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    z-index: 8;
    pointer-events: none;
  }

  /* Contenedor de Portátil Real (Modo Casos — calibrado 1376x768) */
  .hd-case-wrap {
    position: absolute;
    inset: 0;
    z-index: 9;
    overflow: hidden;
    background: linear-gradient(180deg, #07131e 0%, #0e2234 100%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 420ms var(--ease-out);
  }

  .hd-stage.is-case .hd-case-wrap {
    opacity: 1;
    pointer-events: auto;
  }

  /* Frame 1376x768 idéntico a object-fit:cover de trans.mp4 para encaje al píxel */
  .hd-case-frame {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: max(100%, calc(100dvh * 1376 / 768));
    height: max(100%, calc(100vw * 768 / 1376));
    aspect-ratio: 1376 / 768;
  }

  .hd-caseplate {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
  }

  .hd-screen {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 4px;
    background: #000000;
    overflow: hidden;
  }

  /* Coordenadas medidas directamente en píxeles de case-plate.webp (390..985, 137..568 de 1376x768) */
  .hd-screen-mapped {
    position: absolute;
    left: 28.34%;
    top: 17.84%;
    width: 43.24%;
    height: 56.12%;
    border-radius: 6px;
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.06);
  }

  .hd-hint-mobile {
    display: none;
  }

  @media (max-width: 820px) {
    .hd-case-frame {
      width: 100%;
      height: auto;
      max-width: 100%;
      top: 57%;
    }
  }

  .hd-screen-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 420ms var(--ease-out), transform 500ms var(--ease-out);
  }

  .hd-case-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }

  .hd-screen-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(115deg, rgba(255, 255, 255, 0.09) 0%, rgba(255, 255, 255, 0) 40%);
    pointer-events: none;
    z-index: 2;
  }

  .hd-screen-flash {
    position: absolute;
    inset: 0;
    background: #ffffff;
    opacity: 0;
    pointer-events: none;
    z-index: 3;
  }

  .hd-screen-hit {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .hd-laptop-base {
    width: 112%;
    height: 16px;
    border-radius: 2px 2px 14px 14px;
    background: linear-gradient(180deg, #d4dae2 0%, #94a3b8 55%, #475569 100%);
    box-shadow: 0 18px 38px rgba(0, 0, 0, 0.65);
    position: relative;
  }

  .hd-laptop-notch {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 14%;
    height: 5px;
    border-radius: 0 0 6px 6px;
    background: #64748b;
  }

  /* Viewport-pinned UI */
  .hd-ui {
    position: absolute;
    inset: 0;
    z-index: 20;
    pointer-events: none;
  }

  .hd-nav {
    position: absolute;
    top: 14px;
    inset-inline: clamp(12px, 2.2vw, 32px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .hd-nav-left,
  .hd-nav-right {
    display: flex;
    align-items: center;
    gap: clamp(8px, 1.4vw, 18px);
  }

  .hd-tag {
    pointer-events: auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 16px;
    border-radius: 3px;
    background: #ffffff;
    color: var(--ink);
    font-size: 14.5px;
    font-weight: 650;
    letter-spacing: -0.02em;
    white-space: nowrap;
    cursor: pointer;
    box-shadow:
      0 3px 0 rgba(0, 0, 0, 0.22),
      0 6px 14px rgba(0, 0, 0, 0.22);
    transition:
      transform 220ms var(--ease-out),
      box-shadow 220ms var(--ease-out),
      background-color 180ms ease;
  }

  .hd-tag-accent {
    background: #cfeee0;
  }

  .hd-tag-web {
    border-bottom: 3px solid #3b82f6;
  }
  .hd-tag-software {
    border-bottom: 3px solid #10b981;

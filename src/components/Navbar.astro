---
import Logo from './Logo.astro';
import GlowButton from './GlowButton.astro';
import { NAV_LINKS, PILLAR_PALETTES, type PillarId } from '../lib/theme';

interface Props {
  activeTheme?: PillarId;
  currentPath: string;
}

const { activeTheme = 'web', currentPath } = Astro.props;
const normalizedPath = currentPath === '/' ? '/' : currentPath.replace(/\/$/, '');
const accentColor = PILLAR_PALETTES[activeTheme].accent;
---

<header class="site-header fixed top-0 inset-x-0 z-50">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="focus-visible:outline-2 focus-visible:outline-offset-4 rounded-md shrink-0"
      aria-label="Ir al inicio de papis.app"
    >
      <Logo theme={activeTheme} />
    </a>

    <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-7">
      {
        NAV_LINKS.map((link) => {
          const isActive =
            link.href === '/'
              ? normalizedPath === '/'
              : normalizedPath === link.href || normalizedPath.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`relative py-1 text-sm font-medium whitespace-nowrap shrink-0 transition-colors duration-200 ${
                isActive ? 'text-white' : 'text-slate-400 hover:text-white'
              }`}
            >
              {link.label}
              <span
                aria-hidden="true"
                class="absolute inset-x-0 -bottom-0.5 h-[1.5px] origin-left"
                style={`background-color: ${accentColor}; transform: scaleX(${isActive ? 1 : 0}); transition: transform 220ms var(--ease-out);`}
              />
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3 shrink-0">
      <div class="hidden sm:block">
        <GlowButton
          href="/contacto"
          size="sm"
          solid
          ariaLabel="Pedir presupuesto en papis.app"
        >
          Pedir Presupuesto
        </GlowButton>
      </div>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="pressable inline-flex md:hidden items-center justify-center w-11 h-11 rounded-lg border border-white/10 bg-[#0D0F14] text-slate-200 hover:text-white"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg id="icon-menu-open" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg id="icon-menu-close" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil accesible -->
  <div
    id="mobile-nav-drawer"
    hidden
    class="md:hidden border-t border-white/[0.08] bg-[#080A0F]/98 backdrop-blur-xl px-4 pb-5 pt-3"
  >
    <nav aria-label="Navegación móvil" class="flex flex-col gap-1">
      {
        NAV_LINKS.map((link) => {
          const isActive =
            link.href === '/'
              ? normalizedPath === '/'
              : normalizedPath === link.href || normalizedPath.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`flex items-center justify-between rounded-lg px-3 py-3 min-h-[44px] text-base font-medium transition-colors ${
                isActive
                  ? 'bg-white/[0.08] text-white'
                  : 'text-slate-300 hover:bg-white/[0.05] hover:text-white'
              }`}
            >
              <span>{link.label}</span>
            </a>
          );
        })
      }
    </nav>
    <div class="mt-4 pt-4 border-t border-white/[0.08]">
      <GlowButton href="/contacto" size="md" solid fullWidth>
        Pedir Presupuesto
      </GlowButton>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  if (toggleBtn && drawer && iconOpen && iconClose) {
    const setOpen = (open: boolean) => {
      drawer.hidden = !open;
      toggleBtn.setAttribute('aria-expanded', String(open));
      toggleBtn.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
    };

    toggleBtn.addEventListener('click', () => {
      setOpen(drawer.hidden);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) {
        setOpen(false);
        toggleBtn.focus();
      }
    });
  }
</script>

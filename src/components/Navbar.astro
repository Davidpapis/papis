---
import Logo from './Logo.astro';
import GlowButton from './GlowButton.astro';
import { NAV_LINKS, PILLAR_PALETTES, type PillarId } from '../lib/theme';

interface Props {
  activeTheme?: PillarId;
  currentPath: string;
}

const { activeTheme = 'web', currentPath } = Astro.props;
const normalizedPath = currentPath === '/' ? '/' : currentPath.replace(/\/$/, '');
const accentColor = PILLAR_PALETTES[activeTheme].accent;

const MOBILE_LINK_COLORS: Record<string, { color: string; glow: string }> = {
  '/': { color: '#38BDF8', glow: 'rgba(56, 189, 248, 0.6)' },
  '/paginas-web': { color: '#3B82F6', glow: 'rgba(59, 130, 246, 0.65)' },
  '/software-empresas': { color: '#10B981', glow: 'rgba(16, 185, 129, 0.65)' },
  '/servicio-tecnico': { color: '#F97316', glow: 'rgba(249, 115, 22, 0.65)' },
  '/proyectos': { color: '#A855F7', glow: 'rgba(168, 85, 247, 0.65)' },
  '/contacto': { color: '#22D3EE', glow: 'rgba(34, 211, 238, 0.65)' },
};
---

<header class="site-header fixed top-0 inset-x-0 z-50">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a
      href="/"
      class="focus-visible:outline-2 focus-visible:outline-offset-4 rounded-md shrink-0"
      aria-label="Ir al inicio de papis.app"
    >
      <Logo theme={activeTheme} />
    </a>

    <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-7">
      {
        NAV_LINKS.map((link) => {
          const isActive =
            link.href === '/'
              ? normalizedPath === '/'
              : normalizedPath === link.href || normalizedPath.startsWith(`${link.href}/`);
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`relative py-1 text-sm font-medium whitespace-nowrap shrink-0 transition-colors duration-200 ${
                isActive ? 'text-white' : 'text-slate-400 hover:text-white'
              }`}
            >
              {link.label}
              <span
                aria-hidden="true"
                class="absolute inset-x-0 -bottom-0.5 h-[1.5px] origin-left"
                style={`background-color: ${accentColor}; transform: scaleX(${isActive ? 1 : 0}); transition: transform 220ms var(--ease-out);`}
              />
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-3 shrink-0">
      <div class="hidden sm:block">
        <GlowButton
          href="/contacto"
          size="sm"
          solid
          ariaLabel="Pedir presupuesto en papis.app"
        >
          Pedir Presupuesto
        </GlowButton>
      </div>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="pressable inline-flex md:hidden items-center justify-center w-11 h-11 rounded-lg border border-white/10 bg-[#0D0F14] text-slate-200 hover:text-white"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-nav-drawer"
      >
        <svg id="icon-menu-open" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="4" y1="7" x2="20" y2="7"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="17" x2="20" y2="17"></line>
        </svg>
        <svg id="icon-menu-close" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Menú móvil futurista a pantalla completa centrado, MAYÚSCULAS y chevrons luminosos por sección -->
  <div
    id="mobile-nav-drawer"
    hidden
    class="mobile-tech-drawer md:hidden fixed inset-0 top-16 z-50 flex flex-col items-center justify-center bg-[#05070D]/96 backdrop-blur-2xl px-6 py-8"
  >
    <nav aria-label="Navegación móvil" class="flex w-full max-w-sm flex-col items-center gap-3">
      {
        NAV_LINKS.map((link) => {
          const isActive =
            link.href === '/'
              ? normalizedPath === '/'
              : normalizedPath === link.href || normalizedPath.startsWith(`${link.href}/`);
          const c = MOBILE_LINK_COLORS[link.href] ?? { color: '#3B82F6', glow: 'rgba(59,130,246,0.6)' };
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              style={`--m-accent: ${c.color}; --m-glow: ${c.glow};`}
              class={`mobile-tech-link group flex w-full items-center justify-center gap-3.5 rounded-2xl border px-5 py-3.5 min-h-[54px] transition-all duration-200 ${
                isActive
                  ? 'border-[var(--m-accent)]/50 bg-white/[0.06] text-white'
                  : 'border-white/[0.07] bg-white/[0.02] text-slate-200 hover:border-[var(--m-accent)]/40 hover:text-white'
              }`}
            >
              <svg class="mobile-chev-icon w-7 h-5 shrink-0" viewBox="0 0 36 24" fill="none" aria-hidden="true">
                <path class="m-c1" d="M4 4L12 12L4 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                <path class="m-c2" d="M14 4L22 12L14 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
                <path class="m-c3" d="M24 4L32 12L24 20" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="font-display text-lg font-bold tracking-[0.12em] uppercase">
                {link.label}
              </span>
            </a>
          );
        })
      }
    </nav>
    <div class="mt-7 w-full max-w-sm">
      <GlowButton href="/contacto" size="lg" solid fullWidth>
        PEDIR PRESUPUESTO
      </GlowButton>
    </div>
  </div>
</header>

<style>
  .mobile-chev-icon {
    color: var(--m-accent);
  }
  .mobile-chev-icon path {
    opacity: 0.25;
    animation: nav-chev-pulse 1.5s ease-in-out infinite;
  }
  .mobile-chev-icon .m-c1 {
    animation-delay: 0s;
  }
  .mobile-chev-icon .m-c2 {
    animation-delay: 0.22s;
  }
  .mobile-chev-icon .m-c3 {
    animation-delay: 0.44s;
  }
  @keyframes nav-chev-pulse {
    0%,
    100% {
      opacity: 0.22;
      filter: drop-shadow(0 0 2px transparent);
    }
    45% {
      opacity: 1;
      filter: drop-shadow(0 0 8px var(--m-glow));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-chev-icon path {
      animation: none;
      opacity: 0.9;
    }
  }
</style>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const drawer = document.getElementById('mobile-nav-drawer');
  const iconOpen = document.getElementById('icon-menu-open');
  const iconClose = document.getElementById('icon-menu-close');

  if (toggleBtn && drawer && iconOpen && iconClose) {
    const setOpen = (open: boolean) => {
      drawer.hidden = !open;
      toggleBtn.setAttribute('aria-expanded', String(open));
      toggleBtn.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      iconOpen.classList.toggle('hidden', open);
      iconClose.classList.toggle('hidden', !open);
    };

    toggleBtn.addEventListener('click', () => {
      setOpen(drawer.hidden);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !drawer.hidden) {
        setOpen(false);
        toggleBtn.focus();
      }
    });
  }
</script>

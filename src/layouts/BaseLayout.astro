---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FloatingAssistantIsland from '../components/islands/FloatingAssistantIsland';
import { PILLAR_PALETTES, type PillarId } from '../lib/theme';
import siteSettings from '../content/singletons/site-settings.json';

interface Props {
  title: string;
  description: string;
  activeTheme?: PillarId;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schemas?: Record<string, unknown>[];
}

const {
  title,
  description,
  activeTheme = 'web',
  ogImage,
  ogType = 'website',
  noindex = false,
  schemas = [],
} = Astro.props;

const palette = PILLAR_PALETTES[activeTheme];
const currentPath = Astro.url.pathname;
const rootStyle = `--accent: ${palette.accent}; --accent-secondary: ${palette.secondary}; --accent-rgb: ${palette.rgb}; --accent-soft: ${palette.softBg};`;
---

<!doctype html>
<html lang="es" class="dark" style={rootStyle}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#050507" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      schemas={schemas}
    />

    <!-- Fuentes con preconnect y font-display: swap (máx. 2 familias + mono tabular) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=JetBrains+Mono:wght@500;600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="flex min-h-screen flex-col bg-[#050507] text-[#F1F5F9] selection:bg-blue-500/30 selection:text-white">
    <a href="#contenido-principal" class="skip-link">Saltar al contenido principal</a>

    <Navbar activeTheme={activeTheme} currentPath={currentPath} />

    <main id="contenido-principal" class="flex-1">
      <slot />
    </main>

    <Footer activeTheme={activeTheme} />

    <!-- Accesos flotantes (Llamada + WhatsApp + Avatar 2.5D + Asistente IA en isla lazy) -->
    <FloatingAssistantIsland
      client:idle
      activeTheme={activeTheme}
      phoneDisplay={siteSettings.phoneDisplay}
      whatsappNumber={siteSettings.whatsappNumber}
    />

    <!-- Micro-script nativo (< 1 KB) para efecto Spotlight en cajas y revelado suave -->
    <script>
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('[data-spotlight-card]').forEach((card) => {
          card.addEventListener(
            'mousemove',
            (e) => {
              const rect = card.getBoundingClientRect();
              card.style.setProperty('--spot-x', `${e.clientX - rect.left}px`);
              card.style.setProperty('--spot-y', `${e.clientY - rect.top}px`);
            },
            { passive: true }
          );
        });
      }

      const reveals = document.querySelectorAll<HTMLElement>('.reveal-item');
      if (reveals.length > 0 && 'IntersectionObserver' in window) {
        document.documentElement.classList.add('js-ready');
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '-40px 0px', threshold: 0.05 }
        );
        reveals.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

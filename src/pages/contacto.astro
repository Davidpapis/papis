---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactFormIsland from '../components/islands/ContactFormIsland';
import contactData from '../content/singletons/contact-page.json';
import siteSettings from '../content/singletons/site-settings.json';
import { buildBreadcrumbSchema } from '../lib/seo';

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Contacto', url: '/contacto' },
  ]),
];
---

<BaseLayout
  title={contactData.seo.title}
  description={contactData.seo.description}
  activeTheme="web"
  schemas={schemas}
>
  <section aria-labelledby="heading-contacto" class="relative pt-28 pb-24 sm:pt-36 sm:pb-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-medium text-blue-400">{contactData.kicker}</p>
        <h1
          id="heading-contacto"
          class="mt-3 font-display text-3xl sm:text-4xl lg:text-[2.85rem] font-bold tracking-[-0.025em] text-white leading-[1.08]"
          style="text-wrap: balance;"
        >
          {contactData.h1}
        </h1>
        <p class="mt-4 text-base sm:text-lg text-slate-300">{contactData.intro}</p>
      </div>

      <ContactFormIsland
        client:load
        phoneDisplay={siteSettings.phoneDisplay}
        whatsappNumber={siteSettings.whatsappNumber}
        email={siteSettings.email}
        city={siteSettings.city}
      />
    </div>
  </section>
</BaseLayout>

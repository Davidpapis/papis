---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpotlightCard from '../../components/SpotlightCard.astro';
import GlowButton from '../../components/GlowButton.astro';
import { PILLAR_PALETTES } from '../../lib/theme';
import { PROJECT_IMAGES } from '../../lib/images';
import { EN_PROJECTS } from '../../lib/i18n';
import { buildBreadcrumbSchema } from '../../lib/seo';

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Home', url: '/en' },
    { name: 'Projects', url: '/en/projects' },
  ]),
];
---

<BaseLayout
  title="Real Web & Software Projects in Marbella | papis.app"
  description="Explore verifiable real-world websites, custom ERP/CRM software and 20 years of local IT support in Marbella & Costa del Sol by papis.app."
  lang="en"
  activeTheme="web"
  schemas={schemas}
>
  <section aria-labelledby="heading-proj-en" class="relative pt-28 pb-24 sm:pt-36 sm:pb-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <p class="text-sm font-medium text-slate-400">Verifiable Portfolio</p>
        <h1
          id="heading-proj-en"
          class="mt-2 font-display text-3xl sm:text-4xl lg:text-[2.85rem] font-bold tracking-[-0.025em] text-white leading-[1.08]"
          style="text-wrap: balance;"
        >
          Real websites &amp; software in production in Marbella
        </h1>
        <p class="mt-3 text-base text-slate-300 leading-relaxed">
          Every project below is live and verifiable—including our virtually subsidised website for AAAR Marbella Autism Association.
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-7 lg:grid-cols-2">
        {
          EN_PROJECTS.map((project) => {
            const p = PILLAR_PALETTES[project.pillar];
            return (
              <SpotlightCard accent={project.pillar} as="article" class="flex flex-col overflow-hidden">
                <div class="border-b border-white/[0.08] bg-[#090B10] px-4 pt-4">
                  <div class="flex items-center justify-between gap-3 rounded-t-xl border border-b-0 border-white/[0.08] bg-[#11141C] px-3.5 py-2">
                    <div class="flex items-center gap-1.5" aria-hidden="true">
                      <span class="h-2 w-2 rounded-full bg-white/15" />
                      <span class="h-2 w-2 rounded-full bg-white/15" />
                      <span class="h-2 w-2 rounded-full bg-white/15" />
                    </div>
                    <span class="truncate text-[11px] font-mono-tabular text-slate-400">
                      {project.urlPreview}
                    </span>
                    {project.externalUrl && (
                      <a
                        href={project.externalUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-blue-300 hover:text-white text-xs font-medium shrink-0"
                      >
                        Live ↗
                      </a>
                    )}
                  </div>
                  <a
                    href={project.externalUrl || '/en/tech-support'}
                    target={project.externalUrl ? '_blank' : undefined}
                    rel={project.externalUrl ? 'noopener noreferrer' : undefined}
                    class="block aspect-[16/9] w-full overflow-hidden border-x border-white/[0.08]"
                  >
                    <Image
                      src={PROJECT_IMAGES[project.imageKey]}
                      alt={project.imageAlt}
                      widths={[600, 1200]}
                      sizes="(max-width: 1024px) 100vw, 50vw"
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 hover:scale-[1.03]"
                    />
                  </a>
                </div>

                <div class="flex flex-1 flex-col justify-between p-6">
                  <div>
                    <div class="flex flex-wrap items-center gap-2 text-xs text-slate-400">
                      <span style={`color: ${p.accent};`} class="font-medium">{project.client}</span>
                      <span>·</span>
                      <span>{project.location}</span>
                      {project.socialImpact && (
                        <span class="rounded-full border border-sky-400/30 bg-sky-400/10 px-2.5 py-0.5 text-[11px] font-semibold text-sky-300">
                          ♥ Social Impact · Subsidised
                        </span>
                      )}
                    </div>
                    <h2 class="mt-2.5 font-display text-xl sm:text-2xl font-semibold text-white">
                      {project.title}
                    </h2>
                    <p class="mt-2 text-sm leading-relaxed text-slate-300">{project.summary}</p>
                  </div>

                  <div class="mt-5 grid grid-cols-3 gap-3 border-y border-white/[0.08] py-4">
                    {project.metrics.map((metric, idx) => (
                      <div class={idx > 0 ? 'border-l border-white/[0.08] pl-3' : ''}>
                        <p
                          class="font-mono-tabular text-base sm:text-lg font-semibold"
                          style={`color: ${idx === 0 ? p.accent : '#F8FAFC'};`}
                        >
                          {metric.value}
                        </p>
                        <p class="text-[11px] text-slate-400">{metric.label}</p>
                      </div>
                    ))}
                  </div>

                  <div class="mt-5 flex items-center justify-between gap-3">
                    {project.externalUrl ? (
                      <a
                        href={project.externalUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-sm font-semibold text-blue-300 hover:text-white"
                      >
                        Visit live website ↗
                      </a>
                    ) : (
                      <a href="/en/tech-support" class="text-sm font-semibold text-orange-300 hover:text-white">
                        View IT support rates →
                      </a>
                    )}
                    <GlowButton href={`/en/contact?servicio=${project.pillar}`} variant={project.pillar} size="sm">
                      Request similar
                    </GlowButton>
                  </div>
                </div>
              </SpotlightCard>
            );
          })
        }
      </div>
    </div>
  </section>
</BaseLayout>

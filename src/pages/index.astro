---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ScrollHero from '../components/ScrollHero.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import GlowButton from '../components/GlowButton.astro';
import DivisionLogo from '../components/DivisionLogo.astro';
import FaqSection from '../components/FaqSection.astro';
import homeData from '../content/singletons/home.json';
import { PILLAR_PALETTES, type PillarId } from '../lib/theme';
import { PROJECT_IMAGES } from '../lib/images';
import {
  buildFaqSchema,
  buildLocalBusinessSchema,
  buildPersonSchema,
  buildWebSiteSchema,
  buildWhatsAppUrl,
} from '../lib/seo';

const allProjects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 4);

const generalFaqs = (await getCollection('faqs'))
  .filter((f) => f.data.pillar === 'general')
  .sort((a, b) => a.data.order - b.data.order)
  .map((f) => ({ question: f.data.question, answer: f.data.answer }));

const PILLAR_CARDS: {
  id: PillarId;
  summary: string;
  metric: string;
  metricLabel: string;
  href: string;
  cta: string;
}[] = [
  {
    id: 'web',
    summary:
      'Páginas web a medida sin plantillas lentas, panel autogestionable Keystatic, SEO local en Marbella y posicionamiento GEO para ChatGPT y Gemini.',
    metric: '99/100',
    metricLabel: 'Core Web Vitals objetivo',
    href: '/paginas-web',
    cta: 'Explorar Diseño Web',
  },
  {
    id: 'software',
    summary:
      'ERP, CRM y plataformas privadas para inmobiliarias, academias de baile y cualquier empresa que quiera automatizar procesos sin licencias por usuario.',
    metric: '-65%',
    metricLabel: 'Menos horas administrativas',
    href: '/software-empresas',
    cta: 'Explorar Software Empresas',
  },
  {
    id: 'tecnico',
    summary:
      'Vamos directamente a tu vivienda en Marbella y alrededores para reparar ordenadores Mac/Windows, enseñar manejo del móvil y protegerte frente a estafas.',
    metric: '< 24h',
    metricLabel: 'Atención a domicilio',
    href: '/servicio-tecnico',
    cta: 'Explorar Servicio Técnico',
  },
];

const schemas = [
  buildLocalBusinessSchema(),
  buildPersonSchema(),
  buildWebSiteSchema(),
  ...(generalFaqs.length > 0 ? [buildFaqSchema(generalFaqs)] : []),
];
---

<BaseLayout
  title={homeData.seo.title}
  description={homeData.seo.description}
  activeTheme="web"
  schemas={schemas}
>
  <ScrollHero
    slides={homeData.heroSlides.map((s) => ({
      ...s,
      pillar: s.pillar as PillarId,
    }))}
  />

  <!-- Resumen de los 3 Pilares con SpotlightCard -->
  <section
    aria-labelledby="heading-pilares"
    class="relative py-20 sm:py-28 border-t border-white/[0.06]"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="text-sm font-medium text-blue-400">{homeData.pillarsIntro.kicker}</p>
        <h2
          id="heading-pilares"
          class="mt-3 font-display text-3xl sm:text-4xl lg:text-[2.6rem] font-bold tracking-[-0.025em] text-white leading-[1.1]"
          style="text-wrap: balance;"
        >
          {homeData.pillarsIntro.heading}
        </h2>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-300">
          {homeData.pillarsIntro.description}
        </p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
        {
          PILLAR_CARDS.map((card, idx) => {
            const p = PILLAR_PALETTES[card.id];
            return (
              <SpotlightCard
                accent={card.id}
                as="article"
                class="reveal-item p-6 sm:p-7 flex flex-col justify-between"
              >
                <div
                  class="flex h-full flex-col justify-between gap-6"
                  style={`transition-delay: ${idx * 60}ms;`}
                >
                  <div>
                    <DivisionLogo theme={card.id} class="mb-5" />
                    <p class="text-sm sm:text-[15px] leading-relaxed text-slate-300">
                      {card.summary}
                    </p>
                  </div>

                  <div class="border-t border-white/[0.08] pt-5 flex items-end justify-between gap-4">
                    <div>
                      <p
                        class="font-mono-tabular text-2xl font-semibold"
                        style={`color: ${p.accent};`}
                      >
                        {card.metric}
                      </p>
                      <p class="text-xs text-slate-400">{card.metricLabel}</p>
                    </div>
                    <GlowButton href={card.href} variant={card.id} size="sm">
                      {card.cta}
                    </GlowButton>
                  </div>
                </div>
              </SpotlightCard>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Proyectos destacados desde Content Collections (Keystatic) -->
  <section
    aria-labelledby="heading-proyectos-home"
    class="relative py-20 sm:py-28 border-t border-white/[0.06]"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-2xl">
          <p class="text-sm font-medium text-slate-400">Casos y soluciones reales</p>
          <h2
            id="heading-proyectos-home"
            class="mt-2 font-display text-3xl sm:text-4xl font-bold tracking-[-0.025em] text-white leading-[1.1]"
          >
            Proyectos destacados en Marbella y Costa del Sol
          </h2>
        </div>
        <GlowButton href="/proyectos" size="md">Ver todos los proyectos</GlowButton>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {
          featuredProjects.map((project) => {
            const p = PILLAR_PALETTES[project.data.pillar];
            return (
              <SpotlightCard accent={project.data.pillar} as="article" class="flex flex-col">
                <div class="flex h-full flex-col justify-between">
                  <a
                    href={`/proyectos/${project.id}`}
                    class="block aspect-[16/9] w-full overflow-hidden border-b border-white/[0.08] bg-[#090B10]"
                  >
                    <Image
                      src={PROJECT_IMAGES[project.data.imageKey]}
                      alt={project.data.imageAlt}
                      widths={[600, 1200]}
                      sizes="(max-width: 1024px) 100vw, 50vw"
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-300 hover:scale-[1.03]"
                    />
                  </a>

                  <div class="flex flex-1 flex-col justify-between p-6">
                    <div>
                      <div class="flex flex-wrap items-center gap-2 text-xs text-slate-400">
                        <span style={`color: ${p.accent};`} class="font-medium">
                          {p.label}
                        </span>
                        <span aria-hidden="true">·</span>
                        <span>{project.data.client}</span>
                        <span aria-hidden="true">·</span>
                        <span>{project.data.location}</span>
                      </div>

                      <h3 class="mt-2.5 font-display text-xl sm:text-2xl font-semibold text-white">
                        <a href={`/proyectos/${project.id}`} class="hover:underline">
                          {project.data.title}
                        </a>
                      </h3>

                      <p class="mt-2 text-sm leading-relaxed text-slate-300">
                        {project.data.summary}
                      </p>
                    </div>

                    <div class="mt-5 grid grid-cols-3 gap-3 border-t border-white/[0.08] pt-4">
                      {project.data.metrics.map((metric, idx) => (
                        <div class={idx > 0 ? 'border-l border-white/[0.08] pl-3' : ''}>
                          <p
                            class="font-mono-tabular text-lg font-semibold"
                            style={`color: ${idx === 0 ? p.accent : '#F8FAFC'};`}
                          >
                            {metric.value}
                          </p>
                          <p class="text-[11px] text-slate-400">{metric.label}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </SpotlightCard>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Bloque de confianza directa -->
  <section
    aria-labelledby="heading-sobre"
    class="relative py-20 sm:py-24 border-t border-white/[0.06]"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <SpotlightCard accent="web" class="p-7 sm:p-10">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center">
          <div class="lg:col-span-7">
            <p class="text-sm font-medium text-blue-400">{homeData.aboutBlock.kicker}</p>
            <h2
              id="heading-sobre"
              class="mt-2 font-display text-2xl sm:text-3xl lg:text-4xl font-bold tracking-[-0.025em] text-white leading-[1.12]"
            >
              {homeData.aboutBlock.heading}
            </h2>
            <p class="mt-4 text-sm sm:text-base leading-relaxed text-slate-300">
              {homeData.aboutBlock.body}
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <GlowButton href="/contacto" size="lg" solid>
                Pedir presupuesto sin compromiso
              </GlowButton>
              <a
                href={buildWhatsAppUrl(
                  'Hola papis.app, quiero hablar sobre un proyecto o servicio en Marbella.'
                )}
                target="_blank"
                rel="noopener noreferrer"
                class="pressable inline-flex items-center justify-center rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-5 py-3 min-h-[48px] text-sm font-semibold text-emerald-300 hover:bg-emerald-500/20 hover:text-white"
              >
                Escribir por WhatsApp
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 grid grid-cols-1 gap-4 sm:grid-cols-3 lg:grid-cols-1 lg:border-l lg:border-white/[0.08] lg:pl-8">
            {
              homeData.aboutBlock.highlights.map((item) => (
                <div class="rounded-xl border border-white/[0.06] bg-white/[0.02] p-4">
                  <p class="font-mono-tabular text-2xl sm:text-3xl font-bold text-white">
                    {item.value}
                  </p>
                  <p class="mt-1 text-xs sm:text-sm text-slate-400">{item.label}</p>
                </div>
              ))
            }
          </div>
        </div>
      </SpotlightCard>
    </div>
  </section>

  <FaqSection
    title="Preguntas frecuentes sobre papis.app en Marbella"
    kicker="Respuestas directas · SEO & GEO"
    accent="web"
    faqs={generalFaqs}
  />
</BaseLayout>

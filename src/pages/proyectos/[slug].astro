---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpotlightCard from '../../components/SpotlightCard.astro';
import GlowButton from '../../components/GlowButton.astro';
import { PILLAR_PALETTES } from '../../lib/theme';
import { PROJECT_IMAGES } from '../../lib/images';
import { buildBreadcrumbSchema, buildCreativeWorkSchema } from '../../lib/seo';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const palette = PILLAR_PALETTES[project.data.pillar];

// Enlazado interno real: cada proyecto enlaza a otros 2 proyectos
const allProjects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const relatedProjects = allProjects.filter((p) => p.id !== project.id).slice(0, 2);

const seoTitle =
  project.data.title.length > 46
    ? `${project.data.title.slice(0, 46).trim()} | papis.app`
    : `${project.data.title} | papis.app`;

const seoDescription =
  project.data.summary.length > 158
    ? `${project.data.summary.slice(0, 155).trim()}...`
    : project.data.summary;

const schemas = [
  buildCreativeWorkSchema({
    name: project.data.title,
    description: project.data.summary,
    url: `/proyectos/${project.id}`,
    datePublished: `${project.data.year}-01-01`,
  }),
  buildBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Proyectos', url: '/proyectos' },
    { name: project.data.title, url: `/proyectos/${project.id}` },
  ]),
];
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  activeTheme={project.data.pillar}
  ogType="article"
  schemas={schemas}
>
  <article class="relative pt-28 pb-24 sm:pt-36 sm:pb-32">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <nav aria-label="Migas de pan" class="mb-6 flex flex-wrap items-center gap-2 text-xs text-slate-400">
        <a href="/" class="hover:text-white">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/proyectos" class="hover:text-white">Proyectos</a>
        <span aria-hidden="true">/</span>
        <span class="text-slate-200">{project.data.title}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-2.5 text-xs sm:text-sm text-slate-400">
        <a
          href={palette.href}
          class="font-medium hover:underline"
          style={`color: ${palette.accent};`}
        >
          {palette.label}
        </a>
        <span aria-hidden="true">·</span>
        <span>{project.data.client}</span>
        <span aria-hidden="true">·</span>
        <span>{project.data.location}</span>
        <span aria-hidden="true">·</span>
        <span class="font-mono-tabular">{project.data.year}</span>
        {project.data.socialImpact && (
          <span class="inline-flex items-center gap-1 rounded-full border border-sky-400/30 bg-sky-400/10 px-3 py-0.5 text-xs font-semibold text-sky-300">
            ♥ Compromiso Social · Web prácticamente subvencionada
          </span>
        )}
      </div>

      <h1
        class="mt-3 font-display text-3xl sm:text-4xl lg:text-5xl font-bold tracking-[-0.025em] text-white leading-[1.08]"
        style="text-wrap: balance;"
      >
        {project.data.title}
      </h1>

      <p class="mt-4 max-w-3xl text-base sm:text-lg leading-relaxed text-slate-300">
        {project.data.summary}
      </p>

      {project.data.externalUrl && (
        <div class="mt-6 flex flex-wrap items-center gap-3">
          <a
            href={project.data.externalUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="pressable inline-flex items-center gap-2 rounded-xl border border-blue-400/30 bg-blue-500/15 px-5 py-2.5 min-h-[44px] text-sm font-semibold text-blue-200 hover:bg-blue-500/25 hover:text-white"
          >
            Visitar web en vivo ({project.data.urlPreview}) <span aria-hidden="true">↗</span>
          </a>
        </div>
      )}

      <div class="mt-8 overflow-hidden rounded-2xl border border-white/[0.1] bg-[#090B10] aspect-[16/9]">
        <Image
          src={PROJECT_IMAGES[project.data.imageKey]}
          alt={project.data.imageAlt}
          widths={[768, 1200]}
          sizes="(max-width: 1024px) 100vw, 960px"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover"
        />
      </div>

      <!-- Métricas X-Y-Z -->
      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
        {
          project.data.metrics.map((m) => (
            <SpotlightCard accent={project.data.pillar} class="p-5">
              <p
                class="font-mono-tabular text-2xl sm:text-3xl font-bold"
                style={`color: ${palette.accent};`}
              >
                {m.value}
              </p>
              <p class="mt-1 text-xs sm:text-sm text-slate-300">{m.label}</p>
            </SpotlightCard>
          ))
        }
      </div>

      <!-- Reto y solución -->
      <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <SpotlightCard accent={project.data.pillar} class="p-6 sm:p-7">
          <h2 class="font-display text-xl font-semibold text-white">El reto inicial</h2>
          <p class="mt-3 text-sm sm:text-[15px] leading-relaxed text-slate-300">
            {project.data.challenge}
          </p>
        </SpotlightCard>

        <SpotlightCard accent={project.data.pillar} class="p-6 sm:p-7">
          <h2 class="font-display text-xl font-semibold text-white">Solución implementada</h2>
          <p class="mt-3 text-sm sm:text-[15px] leading-relaxed text-slate-300">
            {project.data.solution}
          </p>
        </SpotlightCard>
      </div>

      <!-- Entregables + Cuerpo Markdoc -->
      <SpotlightCard accent={project.data.pillar} class="mt-6 p-6 sm:p-8">
        <h2 class="font-display text-xl font-semibold text-white">Entregables clave</h2>
        <ul class="mt-4 grid grid-cols-1 gap-2.5 sm:grid-cols-2 text-sm text-slate-200">
          {project.data.deliverables.map((item) => <li>✓ {item}</li>)}
        </ul>

        <div class="mt-6 border-t border-white/[0.08] pt-6 text-sm sm:text-base leading-relaxed text-slate-300 space-y-4">
          <Content />
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-4 border-t border-white/[0.08] pt-6">
          <a href={palette.href} class="text-sm font-medium text-slate-300 hover:text-white underline">
            Ver servicio de {palette.label}
          </a>
          <GlowButton
            href={`/contacto?servicio=${project.data.pillar}&asunto=${encodeURIComponent(`Proyecto similar a: ${project.data.title}`)}`}
            variant={project.data.pillar}
            size="lg"
            solid
          >
            Solicitar un proyecto similar
          </GlowButton>
        </div>
      </SpotlightCard>

      <!-- Enlazado interno a otros 2 proyectos -->
      {
        relatedProjects.length > 0 && (
          <section aria-labelledby="heading-relacionados" class="mt-16 border-t border-white/[0.08] pt-12">
            <h2 id="heading-relacionados" class="font-display text-2xl font-bold text-white">
              Otros proyectos de papis.app
            </h2>
            <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
              {relatedProjects.map((rel) => {
                const relPalette = PILLAR_PALETTES[rel.data.pillar];
                return (
                  <SpotlightCard accent={rel.data.pillar} as="article" class="p-5">
                    <p class="text-xs font-medium" style={`color: ${relPalette.accent};`}>
                      {relPalette.label} · {rel.data.location}
                    </p>
                    <h3 class="mt-2 font-display text-lg font-semibold text-white">
                      <a href={`/proyectos/${rel.id}`} class="hover:underline">
                        {rel.data.title}
                      </a>
                    </h3>
                    <p class="mt-2 text-sm text-slate-300">{rel.data.summary}</p>
                  </SpotlightCard>
                );
              })}
            </div>
          </section>
        )
      }
    </div>
  </article>
</BaseLayout>

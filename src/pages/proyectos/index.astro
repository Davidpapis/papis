---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SpotlightCard from '../../components/SpotlightCard.astro';
import GlowButton from '../../components/GlowButton.astro';
import { PILLAR_PALETTES } from '../../lib/theme';
import { PROJECT_IMAGES } from '../../lib/images';
import { buildBreadcrumbSchema } from '../../lib/seo';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

const schemas = [
  buildBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Proyectos', url: '/proyectos' },
  ]),
];
---

<BaseLayout
  title="Proyectos Web, Software y Técnico en Marbella | papis.app"
  description="Casos reales y soluciones de diseño web con SEO/GEO, software ERP/CRM para empresas y asistencia técnica a domicilio en Marbella y Costa del Sol."
  activeTheme="web"
  schemas={schemas}
>
  <section aria-labelledby="heading-proyectos" class="relative pt-28 pb-24 sm:pt-36 sm:pb-32">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="text-sm font-medium text-slate-400">Nivel Técnico y Casos de Éxito</p>
          <h1
            id="heading-proyectos"
            class="mt-2 font-display text-3xl sm:text-4xl lg:text-[2.85rem] font-bold tracking-[-0.025em] text-white leading-[1.08]"
            style="text-wrap: balance;"
          >
            Proyectos reales en Marbella y la Costa del Sol
          </h1>
          <p class="mt-3 text-base text-slate-300 leading-relaxed">
            Resultados medibles en velocidad, posicionamiento y ahorro de horas para empresas y
            particulares.
          </p>
        </div>

        <!-- Filtros interactivos nativos sin librerías pesadas -->
        <div
          role="tablist"
          aria-label="Filtrar proyectos por categoría"
          class="inline-flex flex-wrap items-center gap-1 rounded-xl border border-white/[0.08] bg-[#0D0F14] p-1 self-start lg:self-auto"
        >
          <button
            type="button"
            role="tab"
            aria-selected="true"
            data-filter="todos"
            class="pressable rounded-lg px-3.5 py-2 min-h-[40px] text-xs sm:text-sm font-medium bg-white text-[#050507] cursor-pointer"
          >
            Todos
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-filter="web"
            class="pressable rounded-lg px-3.5 py-2 min-h-[40px] text-xs sm:text-sm font-medium text-slate-400 hover:text-white cursor-pointer"
          >
            Webs
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-filter="software"
            class="pressable rounded-lg px-3.5 py-2 min-h-[40px] text-xs sm:text-sm font-medium text-slate-400 hover:text-white cursor-pointer"
          >
            Software a Medida
          </button>
          <button
            type="button"
            role="tab"
            aria-selected="false"
            data-filter="tecnico"
            class="pressable rounded-lg px-3.5 py-2 min-h-[40px] text-xs sm:text-sm font-medium text-slate-400 hover:text-white cursor-pointer"
          >
            Soporte Técnico
          </button>
        </div>
      </div>

      {
        projects.length === 0 ? (
          <div class="mt-12 rounded-2xl border border-white/[0.08] bg-[#0D0F14] p-10 text-center">
            <p class="text-slate-300">
              Aún no hay proyectos publicados. Puedes añadir el primero desde el panel{' '}
              <a href="/keystatic" class="text-blue-400 underline">
                /keystatic
              </a>
              .
            </p>
          </div>
        ) : (
          <div id="projects-grid" class="mt-12 grid grid-cols-1 gap-7 lg:grid-cols-2">
            {projects.map((project) => {
              const p = PILLAR_PALETTES[project.data.pillar];
              return (
                <div data-project-card data-pillar={project.data.pillar}>
                  <SpotlightCard accent={project.data.pillar} as="article" class="h-full flex flex-col">
                    <div class="flex h-full flex-col justify-between">
                      <div class="border-b border-white/[0.08] bg-[#090B10] px-4 pt-4">
                        <div class="flex items-center justify-between gap-3 rounded-t-xl border border-b-0 border-white/[0.08] bg-[#11141C] px-3.5 py-2.5">
                          <div class="flex items-center gap-1.5" aria-hidden="true">
                            <span class="h-2 w-2 rounded-full bg-white/15" />
                            <span class="h-2 w-2 rounded-full bg-white/15" />
                            <span class="h-2 w-2 rounded-full bg-white/15" />
                          </div>
                          <span class="truncate text-[11px] font-mono-tabular text-slate-400">
                            {project.data.urlPreview}
                          </span>
                          {project.data.externalUrl ? (
                            <a
                              href={project.data.externalUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-blue-300 hover:text-white transition-colors shrink-0 text-xs font-medium"
                              aria-label={`Abrir web en vivo de ${project.data.title}`}
                            >
                              En vivo ↗
                            </a>
                          ) : (
                            <a
                              href={`/proyectos/${project.id}`}
                              class="text-slate-400 hover:text-white transition-colors shrink-0 text-xs"
                              aria-label={`Ver ficha de ${project.data.title}`}
                            >
                              ↗
                            </a>
                          )}
                        </div>

                        <a
                          href={`/proyectos/${project.id}`}
                          class="block aspect-[16/9] w-full overflow-hidden border-x border-white/[0.08] bg-[#0D0F14]"
                        >
                          <Image
                            src={PROJECT_IMAGES[project.data.imageKey]}
                            alt={project.data.imageAlt}
                            widths={[600, 1200]}
                            sizes="(max-width: 1024px) 100vw, 50vw"
                            loading="lazy"
                            class="h-full w-full object-cover transition-transform duration-300 hover:scale-[1.03]"
                          />
                        </a>
                      </div>

                      <div class="flex flex-1 flex-col justify-between p-6 sm:p-7">
                        <div>
                          <div class="flex flex-wrap items-center gap-2 text-xs text-slate-400">
                            <span style={`color: ${p.accent};`} class="font-medium">
                              {p.label}
                            </span>
                            <span aria-hidden="true">·</span>
                            <span>{project.data.client}</span>
                            <span aria-hidden="true">·</span>
                            <span>{project.data.location}</span>
                            {project.data.socialImpact && (
                              <span class="inline-flex items-center gap-1 rounded-full border border-sky-400/30 bg-sky-400/10 px-2.5 py-0.5 text-[11px] font-semibold text-sky-300">
                                ♥ Compromiso Social · Subvencionada
                              </span>
                            )}
                          </div>

                          <h2 class="mt-3 font-display text-xl sm:text-2xl font-semibold tracking-tight text-white">
                            <a href={`/proyectos/${project.id}`} class="hover:underline">
                              {project.data.title}
                            </a>
                          </h2>

                          <p class="mt-2.5 text-sm leading-relaxed text-slate-300">
                            {project.data.summary}
                          </p>
                        </div>

                        <div class="mt-6 grid grid-cols-3 gap-3 border-y border-white/[0.08] py-4">
                          {project.data.metrics.map((metric, idx) => (
                            <div class={idx > 0 ? 'border-l border-white/[0.08] pl-3' : ''}>
                              <p
                                class="font-mono-tabular text-base sm:text-lg font-semibold"
                                style={`color: ${idx === 0 ? p.accent : '#F8FAFC'};`}
                              >
                                {metric.value}
                              </p>
                              <p class="mt-0.5 text-[11px] sm:text-xs text-slate-400 leading-snug">
                                {metric.label}
                              </p>
                            </div>
                          ))}
                        </div>

                        <div class="mt-6 flex flex-wrap items-center justify-between gap-3">
                          <div class="flex flex-wrap items-center gap-4">
                            <a
                              href={`/proyectos/${project.id}`}
                              class="text-sm font-medium text-slate-300 hover:text-white underline underline-offset-4 decoration-white/25 hover:decoration-white"
                            >
                              Ver caso completo
                            </a>
                            {project.data.externalUrl && (
                              <a
                                href={project.data.externalUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="text-sm font-semibold text-blue-300 hover:text-white"
                              >
                                Visitar web ↗
                              </a>
                            )}
                          </div>

                          <GlowButton
                            href={`/contacto?servicio=${project.data.pillar}&asunto=${encodeURIComponent(`Proyecto similar a: ${project.data.title}`)}`}
                            variant={project.data.pillar}
                            size="sm"
                          >
                            Quiero algo similar
                          </GlowButton>
                        </div>
                      </div>
                    </div>
                  </SpotlightCard>
                </div>
              );
            })}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-project-card]'));

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.filter || 'todos';
      buttons.forEach((b) => {
        const active = b === btn;
        b.setAttribute('aria-selected', String(active));
        b.classList.toggle('bg-white', active);
        b.classList.toggle('text-[#050507]', active);
        b.classList.toggle('text-slate-400', !active);
      });
      cards.forEach((card) => {
        const match = target === 'todos' || card.dataset.pillar === target;
        card.hidden = !match;
      });
    });
  });
</script>

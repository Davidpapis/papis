---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DivisionLogo from '../components/DivisionLogo.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import GlowButton from '../components/GlowButton.astro';
import FaqSection from '../components/FaqSection.astro';
import PillarProjectsSection from '../components/PillarProjectsSection.astro';
import pageData from '../content/singletons/pillar-software.json';
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildServiceSchema,
} from '../lib/seo';

const softwareFaqs = (await getCollection('faqs'))
  .filter((f) => f.data.pillar === 'software')
  .sort((a, b) => a.data.order - b.data.order)
  .map((f) => ({ question: f.data.question, answer: f.data.answer }));

const SECTOR_SOLUTIONS = [
  {
    id: 'inmobiliaria',
    category: 'Sector Inmobiliario · Caso real: Bobisapp',
    title: 'Software de Gestión Inmobiliaria',
    description:
      'Basado en nuestra plataforma real Bobisapp en Marbella: centraliza toda tu cartera de propiedades, contratos de venta y alquiler, seguimiento de clientes y automatizaciones administrativas en un panel privado hecho a tu medida.',
    features: [
      'Control completo de propiedades, llaves y disponibilidad',
      'Gestión de alquileres, fianzas, cobros y liquidaciones',
      'CRM de compradores, propietarios y alertas de visitas',
      'Generación automática de contratos, recibos y avisos',
    ],
    metricValue: 'Bobisapp',
    metricLabel: 'Caso real en producción · Marbella',
    caseHref: '/proyectos/bobisapp-erp-inmobiliario',
    ctaLabel: 'Solicitar demo inmobiliaria',
    href: '/contacto?servicio=software&asunto=Software+de+Gestión+Inmobiliaria',
  },
  {
    id: 'academia-baile',
    category: 'Escuelas y Formación · Caso real: Academia La Clave',
    title: 'Software de Gestión de Academias de Baile',
    description:
      'Desarrollado junto a Academia de Baile La Clave de Marbella: deja atrás libretas y hojas de Excel. Controla altas de alumnos, cuotas mensuales, grupos por estilo y nivel, asistencia desde el móvil y cuadrantes de profesores.',
    features: [
      'Fichas de alumnos, grupos, niveles y listas de espera',
      'Control de cuotas mensuales, bonos y avisos de impago',
      'Calendario visual de aulas, horarios y profesores',
      'Pase de asistencia rápido desde tablet o teléfono',
    ],
    metricValue: 'La Clave',
    metricLabel: 'Caso real en producción · Marbella',
    caseHref: '/proyectos/academia-la-clave-marbella',
    ctaLabel: 'Solicitar demo para academia',
    href: '/contacto?servicio=software&asunto=Software+de+Gestión+de+Academia+de+Baile',
  },
];

const schemas = [
  buildServiceSchema({
    name: 'Desarrollo de Software a Medida, ERP y CRM para Empresas en Marbella',
    serviceType: 'Desarrollo de Software Empresarial',
    description: pageData.seo.description,
    url: '/software-empresas',
  }),
  buildBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Software Empresas', url: '/software-empresas' },
  ]),
  ...(softwareFaqs.length > 0 ? [buildFaqSchema(softwareFaqs)] : []),
];
---

<BaseLayout
  title={pageData.seo.title}
  description={pageData.seo.description}
  activeTheme="software"
  ogImage="/assets/optimized/hero-software.webp"
  schemas={schemas}
>
  <section aria-labelledby="heading-software-empresas" class="relative pt-28 pb-20 sm:pt-36 sm:pb-28">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute right-0 top-24 -z-10 h-[460px] w-[640px] rounded-full blur-[150px]"
      style="background: radial-gradient(circle, rgba(16,185,129,0.14) 0%, rgba(5,150,105,0.04) 60%, transparent 100%);"
    >
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <DivisionLogo theme="software" class="mb-5" />
        <p class="text-sm font-medium text-[#10B981]">{pageData.kicker}</p>
        <h1
          id="heading-software-empresas"
          class="mt-3 font-display text-3xl sm:text-4xl lg:text-[2.9rem] font-bold tracking-[-0.025em] text-white leading-[1.08]"
          style="text-wrap: balance;"
        >
          {pageData.h1}
        </h1>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-300">{pageData.intro}</p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-2">
        {
          SECTOR_SOLUTIONS.map((sector) => (
            <SpotlightCard accent="software" as="article" class="p-6 sm:p-8 flex flex-col justify-between">
              <div class="flex h-full flex-col justify-between gap-7">
                <div>
                  <span class="text-xs font-medium text-emerald-400">{sector.category}</span>
                  <h2 class="mt-3 font-display text-2xl sm:text-[1.65rem] font-semibold tracking-tight text-white">
                    {sector.title}
                  </h2>
                  <p class="mt-3 text-sm sm:text-[15px] leading-relaxed text-slate-300">
                    {sector.description}
                  </p>
                  <ul class="mt-6 space-y-2.5 border-t border-white/[0.08] pt-5 text-sm text-slate-300">
                    {sector.features.map((feat) => (
                      <li>✓ {feat}</li>
                    ))}
                  </ul>
                </div>

                <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between border-t border-white/[0.08] pt-6">
                  <div>
                    <a
                      href={sector.caseHref}
                      class="font-mono-tabular text-2xl font-semibold text-emerald-400 hover:underline"
                    >
                      {sector.metricValue} ↗
                    </a>
                    <p class="text-xs text-slate-400">{sector.metricLabel}</p>
                  </div>
                  <GlowButton href={sector.href} variant="software" size="md">
                    {sector.ctaLabel}
                  </GlowButton>
                </div>
              </div>
            </SpotlightCard>
          ))
        }
      </div>

      <SpotlightCard accent="software" class="mt-6 p-6 sm:p-8 lg:p-10">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
          <div class="max-w-2xl">
            <p class="text-sm font-medium text-emerald-400">
              Desarrollo 100% personalizado · Sin límites de sector
            </p>
            <h2 class="mt-2 font-display text-2xl sm:text-3xl font-bold tracking-tight text-white">
              ¿Tienes otro negocio? Lo diseñamos desde cero
            </h2>
            <p class="mt-3 text-sm sm:text-[15px] leading-relaxed text-slate-300">
              Clínicas, constructoras, logística, hostelería, despachos o comercio local. Analizamos
              tu operativa real en una reunión directa y construimos la herramienta exacta que ahorra
              horas cada semana a tu equipo.
            </p>
          </div>
          <div class="shrink-0">
            <GlowButton
              href="/contacto?servicio=software&asunto=Software+a+Medida+para+mi+Empresa"
              variant="software"
              size="lg"
              solid
            >
              {pageData.ctaLabel}
            </GlowButton>
          </div>
        </div>
      </SpotlightCard>
    </div>
  </section>

  <PillarProjectsSection
    pillar="software"
    kicker="Aplicaciones reales en producción · Marbella"
    title="Software a medida real funcionando hoy en empresas locales"
    description="No vendemos humo ni maquetas: Bobisapp y Academia La Clave son plataformas reales en uso diario desarrolladas en TypeScript por papis.app."
  />

  <FaqSection
    title="Preguntas frecuentes sobre software a medida para empresas"
    kicker="ERP, CRM y plataformas privadas"
    accent="software"
    faqs={softwareFaqs}
  />
</BaseLayout>

---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import DivisionLogo from '../components/DivisionLogo.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import GlowButton from '../components/GlowButton.astro';
import FaqSection from '../components/FaqSection.astro';
import GeoSimulatorIsland from '../components/islands/GeoSimulatorIsland';
import pageData from '../content/singletons/pillar-web.json';
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildServiceSchema,
} from '../lib/seo';

const webFaqs = (await getCollection('faqs'))
  .filter((f) => f.data.pillar === 'web')
  .sort((a, b) => a.data.order - b.data.order)
  .map((f) => ({ question: f.data.question, answer: f.data.answer }));

const schemas = [
  buildServiceSchema({
    name: 'Diseño y Desarrollo Web a Medida con SEO y GEO en Marbella',
    serviceType: 'Diseño y Desarrollo Web',
    description: pageData.seo.description,
    url: '/paginas-web',
  }),
  buildBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Diseño Web, SEO y GEO', url: '/paginas-web' },
  ]),
  ...(webFaqs.length > 0 ? [buildFaqSchema(webFaqs)] : []),
];
---

<BaseLayout
  title={pageData.seo.title}
  description={pageData.seo.description}
  activeTheme="web"
  ogImage="/assets/optimized/hero-web.webp"
  schemas={schemas}
>
  <section aria-labelledby="heading-paginas-web" class="relative pt-28 pb-20 sm:pt-36 sm:pb-28">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-1/2 top-16 -z-10 h-[420px] w-[780px] -translate-x-1/2 rounded-full blur-[140px]"
      style="background: radial-gradient(circle, rgba(59,130,246,0.14) 0%, rgba(6,182,212,0.05) 55%, transparent 100%);"
    >
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <DivisionLogo theme="web" class="mb-5" />
        <p class="text-sm font-medium text-[#3B82F6]">{pageData.kicker}</p>
        <h1
          id="heading-paginas-web"
          class="mt-3 font-display text-3xl sm:text-4xl lg:text-[2.9rem] font-bold tracking-[-0.025em] text-white leading-[1.08]"
          style="text-wrap: balance;"
        >
          {pageData.h1}
        </h1>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-300">{pageData.intro}</p>
      </div>

      <!-- Bento Grid Asimétrico -->
      <div class="mt-12 grid grid-cols-1 gap-5 lg:grid-cols-12">
        <SpotlightCard accent="web" class="lg:col-span-7 p-6 sm:p-8">
          <div class="flex h-full flex-col justify-between gap-8">
            <div>
              <p class="text-xs font-medium text-blue-300">Ingeniería Frontend de Alto Impacto</p>
              <h2 class="mt-3 font-display text-2xl font-semibold tracking-tight text-white">
                Velocidad extrema y arquitectura a medida en HTML estático
              </h2>
              <p class="mt-3 text-sm sm:text-[15px] leading-relaxed text-slate-300">
                Cada milisegundo perdido cuesta clientes. Programamos interfaces limpias,
                animaciones fluidas a 60 fps y estructuras técnicas preparadas para soportar
                catálogos exigentes, reservas o integraciones con tu CRM sin despeinarse.
              </p>
            </div>

            <div class="grid grid-cols-3 gap-4 border-t border-white/[0.08] pt-6">
              <div>
                <p class="font-mono-tabular text-2xl sm:text-3xl font-semibold text-white">
                  99<span class="text-blue-400 text-base">/100</span>
                </p>
                <p class="mt-1 text-xs text-slate-400">Rendimiento móvil</p>
              </div>
              <div class="border-l border-white/[0.08] pl-4">
                <p class="font-mono-tabular text-2xl sm:text-3xl font-semibold text-white">
                  &lt; 0.8s
                </p>
                <p class="mt-1 text-xs text-slate-400">Primera carga</p>
              </div>
              <div class="border-l border-white/[0.08] pl-4">
                <p class="font-mono-tabular text-2xl sm:text-3xl font-semibold text-white">100%</p>
                <p class="mt-1 text-xs text-slate-400">Código tuyo y escalable</p>
              </div>
            </div>
          </div>
        </SpotlightCard>

        <SpotlightCard accent="web" class="lg:col-span-5 p-6 sm:p-8">
          <div class="flex h-full flex-col justify-between gap-6">
            <div>
              <p class="text-xs font-medium text-cyan-300">Control Total sin Depender de Nadie</p>
              <h2 class="mt-3 font-display text-2xl font-semibold tracking-tight text-white">
                Seguridad blindada, editable con Keystatic y blog integrado
              </h2>
              <p class="mt-3 text-sm sm:text-[15px] leading-relaxed text-slate-300">
                Olvídate de plugins vulnerables o llamadas constantes para cambiar una foto. Te
                entregamos una web segura, con copias automáticas y edición directa en español.
              </p>
            </div>

            <ul class="space-y-3 border-t border-white/[0.08] pt-5 text-sm text-slate-300">
              <li>• Panel visual intuitivo para cambiar textos, proyectos y fotos al instante.</li>
              <li>• Analítica real de visitas y rendimiento sin cookies invasivas ni banners molestos (cumple RGPD).</li>
              <li>• Blog y FAQs integrados listos para captar tráfico orgánico cada semana.</li>
              <li>• Certificados SSL, protección anti-ataques y arquitectura lista para multiidioma.</li>
            </ul>
          </div>
        </SpotlightCard>

        <SpotlightCard accent="web" class="lg:col-span-12 p-6 sm:p-8 lg:p-10">
          <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-center">
            <div class="lg:col-span-6">
              <p class="text-sm font-medium text-blue-400">
                Posicionamiento SEO + GEO (Generative Engine Optimization)
              </p>
              <h2 class="mt-3 font-display text-2xl sm:text-3xl font-bold tracking-tight text-white leading-tight">
                No solo sales en Google: hacemos que ChatGPT, Gemini y Perplexity recomienden tu negocio
              </h2>
              <p class="mt-4 text-sm sm:text-[15px] leading-relaxed text-slate-300">
                Hoy tus futuros clientes preguntan directamente a la inteligencia artificial dónde
                contratar un servicio en Marbella o qué empresa elegir. Diseñamos tu web con datos
                estructurados Schema.org, jerarquía semántica limpia y entidades verificables para
                que tanto Google como los modelos de IA te citen como primera opción.
              </p>

              <ul class="mt-6 grid grid-cols-1 gap-2.5 sm:grid-cols-2 text-sm text-slate-300">
                <li>✓ Datos estructurados JSON-LD a medida</li>
                <li>✓ SEO local optimizado para Marbella y Costa del Sol</li>
                <li>✓ Arquitectura citable por LLMs (GEO)</li>
                <li>✓ Velocidad y rastreo impecables desde el día 1</li>
              </ul>

              <div class="mt-8">
                <GlowButton
                  href="/contacto?servicio=web&asunto=Diseño+Web+con+SEO+y+GEO"
                  variant="web"
                  size="lg"
                  solid
                >
                  {pageData.ctaLabel}
                </GlowButton>
              </div>
            </div>

            <div class="lg:col-span-6 lg:border-l lg:border-white/[0.08] lg:pl-8">
              <GeoSimulatorIsland client:visible />
            </div>
          </div>
        </SpotlightCard>
      </div>
    </div>
  </section>

  <FaqSection
    title="Preguntas frecuentes sobre diseño web, SEO y GEO en Marbella"
    kicker="Dudas resueltas antes de empezar"
    accent="web"
    faqs={webFaqs}
  />
</BaseLayout>

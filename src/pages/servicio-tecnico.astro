---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import DivisionLogo from '../components/DivisionLogo.astro';
import SpotlightCard from '../components/SpotlightCard.astro';
import GlowButton from '../components/GlowButton.astro';
import FaqSection from '../components/FaqSection.astro';
import PillarProjectsSection from '../components/PillarProjectsSection.astro';
import pageData from '../content/singletons/pillar-tech-support.json';
import { PROJECT_IMAGES } from '../lib/images';
import {
  buildBreadcrumbSchema,
  buildFaqSchema,
  buildServiceSchema,
} from '../lib/seo';

const techFaqs = (await getCollection('faqs'))
  .filter((f) => f.data.pillar === 'tecnico')
  .sort((a, b) => a.data.order - b.data.order)
  .map((f) => ({ question: f.data.question, answer: f.data.answer }));

const HOME_SERVICES = [
  {
    title: 'Reparación y puesta a punto de ordenadores',
    description:
      'Aceleramos tu Mac o Windows, eliminamos virus, ampliamos memoria o disco SSD y dejamos tu equipo funcionando como el primer día.',
  },
  {
    title: 'Clases particulares personalizadas a tu ritmo',
    description:
      'Aprende sin prisas ni palabras raras: correo electrónico, trámites con certificado digital, videollamadas, ofimática o cualquier programa.',
  },
  {
    title: 'Formación práctica para dominar tu móvil',
    description:
      'Saca partido a tu iPhone o Android: WhatsApp, copias de fotos en la nube, organización de contactos, banca online y cambio de teléfono sin perder nada.',
  },
  {
    title: 'Seguridad y manejo tranquilo en Internet',
    description:
      'Blindamos tus cuentas y te enseñamos a detectar correos falsos, SMS fraudulentos y estafas online para que navegues con total confianza.',
  },
  {
    title: 'Resolución de cualquier problema tecnológico diario',
    description:
      'Wi-Fi que no llega a toda la casa, impresoras que no conectan, Smart TV, discos duros o cuentas bloqueadas. Vamos, lo arreglamos y te lo explicamos.',
  },
];

const schemas = [
  buildServiceSchema({
    name: 'Servicio Técnico Informático y Clases Particulares a Domicilio en Marbella',
    serviceType: 'Servicio Técnico Informático a Domicilio',
    description: pageData.seo.description,
    url: '/servicio-tecnico',
  }),
  buildBreadcrumbSchema([
    { name: 'Inicio', url: '/' },
    { name: 'Servicio Técnico a Domicilio', url: '/servicio-tecnico' },
  ]),
  ...(techFaqs.length > 0 ? [buildFaqSchema(techFaqs)] : []),
];
---

<BaseLayout
  title={pageData.seo.title}
  description={pageData.seo.description}
  activeTheme="tecnico"
  ogImage="/assets/optimized/hero-tecnico.webp"
  schemas={schemas}
>
  <section aria-labelledby="heading-servicio-tecnico" class="relative pt-28 pb-20 sm:pt-36 sm:pb-28">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute left-0 top-32 -z-10 h-[440px] w-[620px] rounded-full blur-[150px]"
      style="background: radial-gradient(circle, rgba(249,115,22,0.14) 0%, rgba(234,88,12,0.04) 60%, transparent 100%);"
    >
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <DivisionLogo theme="tecnico" class="mb-5" />
        <p class="text-sm font-medium text-[#F97316]">{pageData.kicker}</p>
        <h1
          id="heading-servicio-tecnico"
          class="mt-3 font-display text-3xl sm:text-4xl lg:text-[2.9rem] font-bold tracking-[-0.025em] text-white leading-[1.08]"
          style="text-wrap: balance;"
        >
          {pageData.h1}
        </h1>
        <p class="mt-4 text-base sm:text-lg leading-relaxed text-slate-300">{pageData.intro}</p>
      </div>

      <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-12 lg:items-stretch">
        <SpotlightCard accent="tecnico" class="lg:col-span-5 flex flex-col">
          <div class="flex h-full flex-col justify-between">
            <div class="relative aspect-[4/3] w-full overflow-hidden border-b border-white/[0.08] bg-[#131110]">
              <Image
                src={PROJECT_IMAGES['servicio-tecnico-marbella']}
                alt="Especialista informático de papis.app ayudando a domicilio con un portátil y un móvil en Marbella"
                widths={[600, 1200]}
                sizes="(max-width: 1024px) 100vw, 42vw"
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
              <div
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-[#0D0F14] via-transparent to-transparent opacity-80"
              >
              </div>
            </div>

            <div class="flex flex-1 flex-col justify-between p-6 sm:p-7">
              <div>
                <p class="text-xs font-medium text-orange-400">Trato humano y lenguaje claro</p>
                <h2 class="mt-2 font-display text-xl sm:text-2xl font-semibold text-white">
                  Tu técnico de confianza, a una llamada
                </h2>
                <p class="mt-3 text-sm leading-relaxed text-slate-300">
                  Nos sentamos contigo, resolvemos el problema delante de ti y te dejamos anotados
                  los pasos importantes para que ganes autonomía real con tus dispositivos.
                </p>
              </div>

              <div class="mt-6 border-t border-white/[0.08] pt-5 flex items-center justify-between gap-4">
                <div class="text-xs text-slate-400">
                  <span class="font-mono-tabular text-sm font-semibold text-white">
                    Marbella y alrededores
                  </span>
                  <p class="mt-0.5">Cita rápida en &lt; 24h</p>
                </div>

                <GlowButton
                  href="/contacto?servicio=tecnico&asunto=Servicio+Técnico+a+Domicilio"
                  variant="tecnico"
                  size="sm"
                  solid
                >
                  Pedir visita
                </GlowButton>
              </div>
            </div>
          </div>
        </SpotlightCard>

        <SpotlightCard accent="tecnico" class="lg:col-span-7 p-6 sm:p-8">
          <div class="flex h-full flex-col justify-between">
            <div class="divide-y divide-white/[0.08]">
              {
                HOME_SERVICES.map((service, index) => (
                  <article
                    class={
                      index === 0
                        ? 'pb-5'
                        : index === HOME_SERVICES.length - 1
                          ? 'pt-5'
                          : 'py-5'
                    }
                  >
                    <h2 class="font-display text-lg font-semibold text-white">{service.title}</h2>
                    <p class="mt-1.5 text-sm leading-relaxed text-slate-300">
                      {service.description}
                    </p>
                  </article>
                ))
              }
            </div>

            <div class="mt-7 border-t border-white/[0.08] pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
              <p class="text-sm text-slate-300">
                ¿Dudas con tu ordenador o móvil hoy mismo? Te atendemos sin compromiso.
              </p>
              <GlowButton
                href="/contacto?servicio=tecnico&asunto=Consulta+de+Soporte+o+Clases+en+Casa"
                variant="tecnico"
                size="md"
              >
                {pageData.ctaLabel}
              </GlowButton>
            </div>
          </div>
        </SpotlightCard>
      </div>
    </div>
  </section>

  <PillarProjectsSection
    pillar="tecnico"
    kicker="Trayectoria verificable · Cabopino a Estepona"
    title="20 años de servicio técnico en Marbella y RTV Marbella"
    description="Dos décadas ayudando a particulares y empresas en toda la franja de Marbella a Estepona con trato cercano y transparencia."
  />

  <FaqSection
    title="Preguntas frecuentes sobre servicio técnico y clases a domicilio"
    kicker="Marbella, San Pedro, Nueva Andalucía y Estepona"
    accent="tecnico"
    faqs={techFaqs}
  />
</BaseLayout>
